    /* ── STICKY BAR ── */
    .sticky-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 90; background: rgba(5,5,5,0.97); backdrop-filter: blur(12px); border-top: 1px solid var(--border); padding: 0.9rem 1.5rem calc(0.9rem + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: space-between; gap: 1rem; transform: translateY(100%); transition: transform 0.3s ease; }
    .sticky-bar.visible { transform: translateY(0); }
    .sticky-title { font-weight: 700; font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.06em; }
    .sticky-sub { font-family: 'DM Mono', monospace; font-size: 0.6rem; color: var(--green); margin-top: 0.15rem; letter-spacing: 0.1em; }
    .sticky-register-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.7rem 1.5rem; border-radius: var(--r); text-decoration: none; background: var(--green); color: #000; font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; white-space: nowrap; transition: background 0.2s; }
    .sticky-register-btn:hover { background: #ffc926; }

    /* ── FOOTER ── */
    .site-footer { background: var(--off-black); border-top: 1px solid var(--border); padding: 4rem 0 2rem; }
    .footer-inner { max-width: 1280px; margin: 0 auto; padding: 0 2.5rem; }
    .footer-top { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding-bottom: 3rem; border-bottom: 1px solid var(--border); align-items: start; }
    .footer-col-label { font-family: 'DM Mono', monospace; font-size: 0.58rem; letter-spacing: 0.25em; text-transform: uppercase; color: #00bf63; margin-bottom: 1.4rem; display: flex; align-items: center; gap: 0.5rem; }
    .footer-col-label::before { content: ''; display: inline-block; width: 14px; height: 1px; background: #00bf63; flex-shrink: 0; }
    .footer-col-label.right { justify-content: flex-end; }
    .footer-col-label.right::before { display: none; }
    .footer-col-label.right::after { content: ''; display: inline-block; width: 14px; height: 1px; background: #00bf63; flex-shrink: 0; }
    .footer-links { list-style: none; display: flex; flex-direction: column; gap: 0; }
    .footer-links li a { font-family: 'DM Sans', sans-serif; font-size: 0.88rem; color: rgba(255,255,255,0.42); text-decoration: none; padding: 0.45rem 0; display: block; transition: color 0.2s; letter-spacing: 0.02em; }
    .footer-links li a:hover { color: #ffffff; }
    .footer-right-col { text-align: right; }
    .footer-address-lines { display: flex; flex-direction: column; gap: 0.25rem; text-align: right; }
    .footer-address-lines p, .footer-address-lines a { font-family: 'DM Mono', monospace; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.42); line-height: 1.7; text-decoration: none; display: block; transition: color 0.2s; }
    .footer-address-lines a:hover { color: #00bf63; }
    .footer-address-gap { margin-top: 0.6rem; }
    .footer-bottom-row { padding-top: 2.5rem; display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
    .footer-logo { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; }
    .footer-logo-mark { width: 42px; height: 42px; border-radius: var(--r); background: var(--card); border: 1px solid var(--border-strong); overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .footer-logo-mark img { width: 100%; height: 100%; object-fit: cover; }
    .footer-logo-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; letter-spacing: 0.14em; color: #ffffff; line-height: 1; }
    .footer-logo-sub { font-family: 'DM Mono', monospace; font-size: 0.46rem; text-transform: uppercase; letter-spacing: 0.22em; color: #00bf63; display: block; margin-top: 3px; }
    .footer-socials { display: flex; align-items: center; gap: 0.6rem; }
    .footer-social-icon { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; flex-shrink: 0; transition: transform 0.2s, opacity 0.2s; }
    .footer-social-icon:hover { transform: translateY(-2px); opacity: 0.85; }
    .footer-social-icon.linkedin { background: #0a66c2; }
    .footer-social-icon.facebook { background: #1877f2; }
    .footer-social-icon.instagram { background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fd5949 45%, #d6249f 60%, #285AEB 90%); }
    .footer-social-icon svg { width: 15px; height: 15px; fill: white; }
    .footer-copyright { font-family: 'DM Mono', monospace; font-size: 0.5rem; text-transform: uppercase; letter-spacing: 0.22em; color: rgba(255,255,255,0.18); text-align: center; }
    @media (max-width: 640px) { .footer-top { grid-template-columns: 1fr; } .footer-right-col { text-align: left; } .footer-col-label.right { justify-content: flex-start; } .footer-col-label.right::before { display: inline-block; } .footer-col-label.right::after { display: none; } .footer-address-lines { text-align: left; } }

    /* ── ANIMATIONS ── */
    @keyframes fadeUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
    .hero-eyebrow { animation: fadeUp 0.6s ease 0.1s both; }
    .hero-title    { animation: fadeUp 0.7s ease 0.2s both; }
    .hero-divider  { animation: fadeUp 0.6s ease 0.3s both; }
    .hero-desc     { animation: fadeUp 0.6s ease 0.35s both; }
    .hero-meta     { animation: fadeUp 0.6s ease 0.45s both; }
    .event-card-hero { animation: fadeUp 0.7s ease 0.3s both; }

    /* Language dropdown */
