<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <title>Bygg din första AI-agent på 3 timmar — Online · 13 juni</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <script defer src="https://cloud.umami.is/script.js" data-website-id="045fc1e4-9f56-44f2-992e-98f5fb7717a5"></script>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #faf9f5;
      --bg-alt: #f2f0ea;
      --ink: #1a1208;
      --ink-2: rgba(26,18,8,0.62);
      --ink-3: rgba(26,18,8,0.38);
      --green: #1a6b3a;
      --green-bg: rgba(26,107,58,0.08);
      --green-border: rgba(26,107,58,0.22);
      --green-glow: rgba(26,107,58,0.18);
      --border: rgba(26,18,8,0.10);
      --border-s: rgba(26,18,8,0.18);
      --dark: #0d0d0d;
      --white: #ffffff;
      --strip: 32px;
      --nav: 60px;
      --hdr: 92px;
      --r: 3px;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: 'DM Sans', sans-serif;
      font-size: 16px;
      line-height: 1.6;
      overflow-x: hidden;
    }
    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 9999;
      pointer-events: none;
      opacity: 0.028;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
      background-size: 200px 200px;
    }

    section, [id] { scroll-margin-top: calc(var(--hdr) + 12px); }

    /* ── SCROLL REVEAL ── */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s cubic-bezier(.22,.68,0,1.2), transform 0.7s cubic-bezier(.22,.68,0,1.2);
    }
    .reveal.in { opacity: 1; transform: translateY(0); }
    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }
    .reveal-delay-3 { transition-delay: 0.3s; }
    .reveal-delay-4 { transition-delay: 0.4s; }

    /* ── PUBLICATION STRIP — MARQUEE ── */
    .pub-strip {
      position: fixed; top: 0; left: 0; right: 0; height: var(--strip);
      background: var(--ink); z-index: 200;
      display: flex; align-items: center;
      overflow: hidden;
    }
    .pub-marquee {
      display: flex; align-items: center;
      white-space: nowrap;
      animation: marquee 28s linear infinite;
      gap: 0;
    }
    .pub-marquee-item {
      font-family: 'DM Mono', monospace;
      font-size: 0.52rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: rgba(255,255,255,0.42); padding: 0 2.5rem;
    }
    .pub-marquee-item .dot {
      display: inline-block; width: 4px; height: 4px; background: var(--green);
      border-radius: 50%; margin: 0 1.2rem; vertical-align: middle;
    }
    @keyframes marquee {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* ── SITE NAV ── */
    .site-nav {
      position: fixed; top: var(--strip); left: 0; right: 0; height: var(--nav);
      background: rgba(250,249,245,0.96);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border-s);
      z-index: 199; display: flex; align-items: center;
      transition: box-shadow 0.3s;
    }
    .site-nav.scrolled { box-shadow: 0 2px 24px rgba(26,18,8,0.08); }
    .nav-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 2.5rem;
      width: 100%; display: flex; align-items: center; justify-content: space-between;
    }
    .logo { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; }
    .logo-mark {
      width: 34px; height: 34px; border-radius: 2px;
      overflow: hidden;
      display: flex; align-items: center; justify-content: center;
    }
    .logo-mark img { width: 100%; height: 100%; object-fit: cover; }
    .logo-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.25rem; letter-spacing: 0.1em; color: var(--ink); line-height: 1; }
    .logo-sub { font-family: 'DM Mono', monospace; font-size: 0.46rem; text-transform: uppercase; letter-spacing: 0.22em; color: var(--ink-3); display: block; margin-top: 2px; }
    .nav-links { display: flex; align-items: center; gap: 2rem; }
    .nav-links a {
      font-family: 'DM Mono', monospace; font-size: 0.6rem; text-transform: uppercase;
      letter-spacing: 0.16em; color: var(--ink-2); text-decoration: none;
      transition: color 0.2s; position: relative;
    }
    .nav-links a::after {
      content: ''; position: absolute; bottom: -3px; left: 0; right: 0;
      height: 1px; background: var(--green);
      transform: scaleX(0); transform-origin: left;
      transition: transform 0.25s ease;
    }
    .nav-links a:hover { color: var(--green); }
    .nav-links a:hover::after { transform: scaleX(1); }
    .nav-actions { display: flex; align-items: center; gap: 0.85rem; }
    .nav-signup {
      background: #f0c000; color: var(--ink);
      font-family: 'DM Sans', sans-serif; font-weight: 600; font-size: 0.72rem;
      text-transform: uppercase; letter-spacing: 0.12em;
      padding: 0.52rem 1.25rem; border-radius: 2px; text-decoration: none;
      white-space: nowrap;
      transition: background 0.2s, transform 0.15s;
    }
    .nav-signup:hover { background: #d4aa00; transform: translateY(-1px); }

    .lang-wrap { position: relative; }
    .lang-btn { display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-family: 'DM Mono', monospace; font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-2); background: none; border: 1px solid var(--border-s); border-radius: 2px; padding: 0.32rem 0.65rem; transition: color 0.2s, border-color 0.2s; }
    .lang-btn:hover { color: var(--ink); border-color: var(--border); }
    .lang-btn img { width: 16px; height: 16px; border-radius: 2px; object-fit: cover; }
    .lang-btn svg { width: 11px; height: 11px; stroke: currentColor; fill: none; }
    .lang-menu { display: none; position: absolute; right: 0; top: calc(100% + 6px); min-width: 140px; background: var(--bg); border: 1px solid var(--border-s); border-radius: 2px; overflow: hidden; z-index: 300; box-shadow: 0 8px 32px rgba(26,18,8,0.12); }
    .lang-wrap.open .lang-menu { display: block; }
    .lang-menu a { display: flex; align-items: center; gap: 0.55rem; padding: 0.6rem 0.9rem; font-family: 'DM Mono', monospace; font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-2); text-decoration: none; transition: background 0.15s, color 0.15s; }
    .lang-menu a:hover { background: var(--bg-alt); color: var(--green); }
    .lang-menu a img { width: 15px; height: 15px; border-radius: 2px; }

    @media (max-width: 700px) { .nav-links { display: none; } .nav-inner { padding: 0 1.25rem; } }

    /* ── HERO ── */
    .hero {
      padding-top: var(--hdr);
      background: var(--dark) url('/aiagentworkshop1.png') center center / cover no-repeat;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      position: relative;
    }
    @media (max-width: 640px) {
      .hero { background-image: url('/aiagentworkshop.png'); }
    }
    .hero::before {
      content: '';
      position: absolute; inset: 0; z-index: 0;
      background: linear-gradient(100deg, rgba(8,6,4,0.92) 0%, rgba(8,6,4,0.82) 52%, rgba(8,6,4,0.68) 100%);
      pointer-events: none;
    }
    .hero::after {
      content: '';
      position: absolute; top: var(--hdr); right: 0; width: 600px; height: 500px;
      background: radial-gradient(ellipse at 80% 20%, rgba(26,107,58,0.16) 0%, transparent 65%);
      pointer-events: none; z-index: 1;
    }
    .hero-grid {
      max-width: 860px; margin: 0 auto; padding: 5rem 2.5rem 5.5rem;
      display: grid; grid-template-columns: 1fr;
      gap: 3rem; align-items: start; position: relative; z-index: 1;
    }
    @media (max-width: 640px) { .hero-grid { padding: 3rem 1.25rem 2.5rem; } }

    .hero-left { display: flex; flex-direction: column; align-items: flex-start; }

    .hero-eyebrow {
      display: inline-flex; align-items: center; gap: 0.55rem;
      font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: #f0c000; border: 1px solid rgba(240,192,0,0.35); background: rgba(240,192,0,0.08);
      padding: 0.3rem 0.8rem; border-radius: 2px; margin-bottom: 1.5rem;
      animation: fadeUp 0.6s ease 0.1s both;
    }
    .eyebrow-dot { width: 6px; height: 6px; background: #f0c000; border-radius: 50%; animation: pulse 2s ease infinite; display: inline-block; flex-shrink: 0; }
    @keyframes pulse { 0%,100%{opacity:1; transform:scale(1);} 50%{opacity:0.3; transform:scale(0.8);} }

    .hero-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(4rem, 7.5vw, 7rem);
      font-weight: 400; line-height: 0.92; letter-spacing: 0.02em;
      color: var(--ink); margin-bottom: 1.8rem;
      animation: fadeUp 0.7s ease 0.2s both;
    }
    .hero-title .t-ink { display: block; color: var(--white); }
    .hero-title .t-yellow { display: block; color: #f0c000; font-style: normal; }

    .hero-quote {
      border-left: 3px solid var(--green); padding-left: 1.25rem; margin-bottom: 2rem;
      font-family: 'DM Sans', sans-serif; font-style: normal; font-weight: 300;
      font-size: 1.08rem; color: rgba(255,255,255,0.72); line-height: 1.75; max-width: 540px;
      animation: fadeUp 0.6s ease 0.3s both;
    }

    .hero-mobile-cta {
      display: none;
      margin-bottom: 1.5rem;
      width: 100%;
    }
    @media (max-width: 640px) {
      .hero-mobile-cta { display: flex; }
    }

    /* ── COUNTDOWN ── */
    .hero-countdown { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.5rem; animation: fadeUp 0.6s ease 0.35s both; }
    .countdown-label { font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.45); white-space: nowrap; }
    .countdown-unit { display: flex; flex-direction: column; align-items: center; gap: 0.08rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); padding: 0.35rem 0.5rem; border-radius: 2px; min-width: 40px; }
    .countdown-num { font-family: 'Bebas Neue', sans-serif; font-size: 1.35rem; font-weight: 400; letter-spacing: 0.04em; color: var(--white); line-height: 1; }
    .countdown-sub { font-family: 'DM Mono', monospace; font-size: 0.42rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.35); }
    .countdown-sep { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; color: rgba(255,255,255,0.3); }

    .hero-rule { width: 100%; height: 1px; background: rgba(255,255,255,0.12); margin-bottom: 1.75rem; animation: fadeUp 0.5s ease 0.4s both; }

    .hero-meta {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 0; border: 1px solid rgba(255,255,255,0.12); border-radius: 2px;
      overflow: hidden; width: 100%; margin-bottom: 0;
      animation: fadeUp 0.5s ease 0.45s both;
    }
    @media (max-width: 500px) { .hero-meta { grid-template-columns: 1fr 1fr; } }
    .meta-block {
      padding: 0.85rem 1rem; border-right: 1px solid rgba(255,255,255,0.1);
      background: rgba(13,13,13,0.5); backdrop-filter: blur(8px); transition: background 0.2s;
    }
    .meta-block:hover { background: rgba(13,13,13,0.68); }
    .meta-block:last-child { border-right: none; }
    .meta-label { font-family: 'DM Mono', monospace; font-size: 0.48rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.38); margin-bottom: 0.2rem; }
    .meta-value { font-family: 'Bebas Neue', sans-serif; font-size: 1.15rem; font-weight: 400; letter-spacing: 0.04em; color: var(--white); line-height: 1.2; }
    .meta-value.yellow { color: #f0c000; }

    /* ── HERO EVENT CARD ── */
    .hero-right { animation: fadeUp 0.7s ease 0.3s both; }
    .hero-event-card {
      border: 1px solid rgba(255,255,255,0.12); border-radius: 2px; overflow: hidden;
      transition: transform 0.4s ease, box-shadow 0.4s ease;
    }
    .hero-event-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }

    .hero-event-photo.is-product img {
      filter: none;
      object-position: top center;
    }
    .hero-event-photo.is-product .hero-event-photo-overlay {
      background: linear-gradient(to bottom, transparent 55%, rgba(13,13,13,0.7) 100%);
    }
    .hero-event-photo { height: 300px; overflow: hidden; position: relative; }
    .hero-event-photo img {
      width: 100%; height: 100%; object-fit: cover; object-position: center 30%;
      filter: sepia(0.15) brightness(0.78) contrast(1.08) saturate(0.85);
      display: block; transition: transform 0.6s ease;
    }
    .hero-event-card:hover .hero-event-photo img { transform: scale(1.04); }
    .hero-event-photo-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to bottom, rgba(13,13,13,0.05) 0%, rgba(13,13,13,0.72) 100%);
    }
    .hero-event-photo-caption {
      position: absolute; bottom: 0.85rem; left: 1rem;
      font-family: 'DM Mono', monospace; font-size: 0.48rem; letter-spacing: 0.2em;
      text-transform: uppercase; color: rgba(255,255,255,0.45);
    }
    .hero-event-card::before {
      content: ''; display: block; height: 3px;
      background: linear-gradient(90deg, var(--green), #2d8a52);
    }

    /* ── HERO TICKET ── */
    .hero-ticket {
      background: var(--dark); border-top: none;
      padding: 1.75rem 1.5rem 1.5rem;
    }
    .ticket-price-old { font-family: 'DM Mono', monospace; font-size: 0.9rem; color: rgba(255,255,255,0.28); text-decoration: line-through; margin-bottom: 0.2rem; }
    .ticket-price-row { display: flex; align-items: baseline; gap: 0.85rem; flex-wrap: wrap; margin-bottom: 0.35rem; }
    .ticket-price { font-family: 'Bebas Neue', sans-serif; font-size: 3rem; font-weight: 400; letter-spacing: 0.02em; color: var(--white); line-height: 1; }
    .ticket-save { font-family: 'DM Mono', monospace; font-size: 0.56rem; text-transform: uppercase; letter-spacing: 0.15em; color: #d4aa00; background: rgba(212,170,0,0.14); border: 1px solid rgba(212,170,0,0.38); padding: 0.18rem 0.5rem; border-radius: 2px; white-space: nowrap; }
    .ticket-divider { height: 1px; background: rgba(255,255,255,0.08); margin: 1.2rem 0; }
    .ticket-features { list-style: none; margin-bottom: 1.25rem; display: flex; flex-direction: column; gap: 0; }
    .ticket-features li { display: flex; gap: 0.75rem; font-size: 0.84rem; color: rgba(255,255,255,0.58); padding: 0.42rem 0; border-bottom: 1px solid rgba(255,255,255,0.06); transition: color 0.2s; }
    .ticket-features li:hover { color: rgba(255,255,255,0.85); }
    .ticket-features li:last-child { border-bottom: none; }
    .ticket-features li::before { content: '—'; color: var(--green); flex-shrink: 0; font-size: 0.75rem; margin-top: 2px; }

    .seat-progress-wrap { margin-bottom: 1.1rem; }
    .seat-progress-label {
      display: flex; justify-content: space-between; align-items: center;
      font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.14em;
      text-transform: uppercase; color: rgba(255,255,255,0.35); margin-bottom: 0.45rem;
    }
    .seat-progress-label .urgent { color: #e8624a; animation: urgency 2s ease infinite; }
    @keyframes urgency { 0%,100%{opacity:1} 50%{opacity:0.5} }
    .seat-bar { height: 3px; background: rgba(255,255,255,0.08); border-radius: 2px; overflow: hidden; }
    .seat-bar-fill {
      height: 100%; width: 72%; background: linear-gradient(90deg, var(--green), #2d8a52);
      border-radius: 2px;
      animation: fillIn 1.2s ease 0.8s both;
    }
    @keyframes fillIn { from { width: 0; } to { width: 72%; } }

    .ticket-cta {
      display: flex; align-items: center; justify-content: center; gap: 0.6rem;
      width: 100%; padding: 0.95rem 2rem; background: #f0c000; color: var(--ink);
      font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.88rem;
      text-transform: uppercase; letter-spacing: 0.14em; text-decoration: none;
      border-radius: 2px; transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
      position: relative; overflow: hidden;
    }
    .ticket-cta::after {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.2) 50%, transparent 70%);
      transform: translateX(-100%);
      transition: transform 0.6s ease;
    }
    .ticket-cta:hover { background: #d4aa00; transform: translateY(-1px); box-shadow: 0 8px 28px rgba(240,192,0,0.35); }
    .ticket-cta:hover::after { transform: translateX(100%); }
    .ticket-note { margin-top: 0.8rem; font-family: 'DM Mono', monospace; font-size: 0.54rem; text-transform: uppercase; letter-spacing: 0.14em; color: rgba(255,255,255,0.25); text-align: center; }
    .ticket-note a { color: rgba(255,255,255,0.32); text-decoration: underline; }


    /* ── STAT BAR ── */
    .stat-bar { background: var(--ink); }
    .stat-bar-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 2.5rem;
      display: grid; grid-template-columns: repeat(4, 1fr);
    }
    .stat-item {
      padding: 1.75rem 1rem; border-right: 1px solid rgba(255,255,255,0.08);
      display: flex; flex-direction: column; align-items: center; gap: 0.25rem; text-align: center;
      transition: background 0.2s;
    }
    .stat-item:hover { background: rgba(255,255,255,0.03); }
    .stat-item:last-child { border-right: none; }
    .stat-num { font-family: 'Bebas Neue', sans-serif; font-size: 2.4rem; font-weight: 400; letter-spacing: 0.02em; color: var(--white); line-height: 1; }
    .stat-num .stat-accent { color: var(--green); }
    .stat-label { font-family: 'DM Mono', monospace; font-size: 0.46rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.3); }
    @media (max-width: 640px) {
      .stat-bar-inner { grid-template-columns: 1fr 1fr; padding: 0 1.25rem; }
      .stat-item:nth-child(2) { border-right: none; }
      .stat-item:nth-child(1), .stat-item:nth-child(2) { border-bottom: 1px solid rgba(255,255,255,0.08); }
    }

    /* ── SECTIONS ── */
    .section { padding: 5.5rem 0; }
    .section-alt { background: var(--bg-alt); }
    .container { max-width: 760px; margin: 0 auto; padding: 0 2rem; }
    @media (max-width: 640px) { .container { padding: 0 1.25rem; } }

    .sec-eyebrow {
      font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.22em;
      text-transform: uppercase; color: var(--green); margin-bottom: 0.6rem;
      display: flex; align-items: center; gap: 0.6rem;
    }
    .sec-eyebrow::before { content: ''; display: inline-block; width: 18px; height: 1px; background: var(--green); }
    .sec-title {
      font-family: 'Bebas Neue', sans-serif; font-size: clamp(2.6rem, 4.5vw, 3.8rem);
      font-weight: 400; line-height: 1.0; letter-spacing: 0.02em; color: var(--ink); margin-bottom: 1rem;
    }
    .sec-title em { font-style: normal; color: var(--green); }
    .sec-desc { font-size: 0.97rem; color: var(--ink-2); line-height: 1.82; font-weight: 300; }
    .sec-rule { height: 1px; background: var(--border); margin: 2rem 0; }

    /* ── DARK BENEFIT CARDS ── */
    .benefit-dark-grid {
      display: grid; grid-template-columns: repeat(4, 1fr);
      background: var(--dark);
      margin: 2.5rem 0;
    }
    .benefit-dark-card {
      padding: 2.25rem 2rem; border-right: 1px solid rgba(255,255,255,0.07);
      transition: background 0.25s;
      position: relative; overflow: hidden;
    }
    .benefit-dark-card::after {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: var(--green); transform: scaleX(0); transform-origin: left;
      transition: transform 0.3s ease;
    }
    .benefit-dark-card:hover { background: rgba(255,255,255,0.025); }
    .benefit-dark-card:hover::after { transform: scaleX(1); }
    .benefit-dark-card:last-child { border-right: none; }
    .bdc-icon {
      width: 40px; height: 40px; border: 1px solid rgba(26,107,58,0.3); border-radius: 3px;
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 1.1rem; background: rgba(26,107,58,0.08);
      transition: background 0.2s, border-color 0.2s;
    }
    .benefit-dark-card:hover .bdc-icon { background: rgba(26,107,58,0.18); border-color: rgba(26,107,58,0.5); }
    .bdc-icon svg { width: 18px; height: 18px; stroke: var(--green); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .bdc-title { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--white); margin-bottom: 0.6rem; }
    .bdc-desc { font-size: 0.83rem; color: rgba(255,255,255,0.45); line-height: 1.65; }
    @media (max-width: 860px) {
