<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <title>Bygg din första AI-agent på 3 timmar — Online · 13 juni</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <!-- Umami Analytics -->
<script defer src="https://cloud.umami.is/script.js" data-website-id="045fc1e4-9f56-44f2-992e-98f5fb7717a5"></script>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --black: #050505;
      --off-black: #0d0d0d;
      --card: #111111;
      --card2: #161616;
      --border: rgba(255,255,255,0.07);
      --border-strong: rgba(255,255,255,0.12);
      --green: #ffb800;
      --green-dim: rgba(255,184,0,0.10);
      --green-glow: rgba(255,184,0,0.28);
      --white: #ffffff;
      --muted: rgba(255,255,255,0.42);
      --muted2: rgba(255,255,255,0.65);
      --red: #e53e3e;
      --gold: #ffb800;
      --header: 66px;
      --r: 3px;
    }

    html { scroll-behavior: smooth; }
    body { background: var(--black); color: var(--white); font-family: 'DM Sans', sans-serif; font-size: 16px; line-height: 1.6; overflow-x: hidden; }
    section, [id] { scroll-margin-top: calc(var(--header) + 12px); }

    /* ── HEADER ── */
    header {
      position: fixed; top: 0; left: 0; right: 0; height: var(--header);
      background: rgba(5,5,5,0.96); backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border); z-index: 100;
      display: flex; align-items: center;
    }
    .hdr-inner {
      max-width: 1280px; margin: 0 auto; padding: 0 2.5rem;
      width: 100%; display: flex; align-items: center; justify-content: space-between;
    }
    .logo { display: flex; align-items: center; gap: 0.85rem; text-decoration: none; }
    .logo-mark {
      width: 36px; height: 36px; border-radius: var(--r);
      background: var(--card); border: 1px solid var(--border-strong);
      display: flex; align-items: center; justify-content: center; overflow: hidden;
    }
    .logo-mark img { width: 100%; height: 100%; object-fit: cover; }
    .logo-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; letter-spacing: 0.12em; color: var(--white); line-height: 1; }
    .logo-sub { font-family: 'DM Mono', monospace; font-size: 0.52rem; text-transform: uppercase; letter-spacing: 0.24em; color: #00bf63; display: block; margin-top: 2px; }
    .nav-links { display: flex; align-items: center; gap: 2.2rem; }
    .nav-links a { font-family: 'DM Mono', monospace; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--muted); text-decoration: none; transition: color 0.2s; }
    .nav-links a:hover { color: var(--white); }

    /* Language toggle */
    .lang-toggle {
      display: flex; align-items: center; gap: 0.45rem;
      font-family: 'DM Mono', monospace; font-size: 0.6rem;
      text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--muted); text-decoration: none;
      border: 1px solid var(--border-strong); border-radius: var(--r);
      padding: 0.35rem 0.7rem; transition: color 0.2s, border-color 0.2s;
    }
    .lang-toggle:hover { color: var(--white); border-color: rgba(255,255,255,0.25); }
    .lang-toggle img { width: 18px; height: 18px; border-radius: 2px; object-fit: cover; }

    .hdr-right { display: flex; align-items: center; gap: 1rem; }
    .nav-register {
      background: var(--green); color: #000;
      font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.72rem;
      text-transform: uppercase; letter-spacing: 0.14em;
      padding: 0.55rem 1.4rem; border-radius: var(--r); text-decoration: none;
      transition: all 0.2s;
    }
    .nav-register:hover { background: #ffc926; transform: translateY(-1px); }
    @media (max-width: 640px) { .hdr-inner { padding: 0 1.25rem; } .nav-links { display: none; } }

    /* ── HERO ── */
    .hero {
      min-height: 92vh; padding-top: var(--header);
      display: flex; align-items: stretch; background: var(--black); position: relative; overflow: hidden;
    }
    .hero-grid-bg {
      position: absolute; inset: 0; z-index: 0;
      background-image: linear-gradient(rgba(255,184,0,0.04) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(255,184,0,0.04) 1px, transparent 1px);
      background-size: 52px 52px;
    }
    .hero-glow {
      position: absolute; top: -200px; left: 30%; width: 700px; height: 700px;
      border-radius: 50%; background: radial-gradient(circle, rgba(255,184,0,0.08) 0%, transparent 70%);
      z-index: 0; pointer-events: none;
    }
    .hero-inner {
      max-width: 1280px; margin: 0 auto; width: 100%;
      display: grid; grid-template-columns: 55% 45%; align-items: center;
      position: relative; z-index: 2;
    }
    @media (max-width: 900px) { .hero-inner { grid-template-columns: 1fr; } .hero { min-height: auto; } }

    .hero-left { display: flex; flex-direction: column; justify-content: center; padding: 4rem 3rem 3.5rem 2.5rem; }
    @media (max-width: 640px) { .hero-left { padding: 2.5rem 1.5rem 2.5rem; } }

    .hero-eyebrow {
      display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap;
      font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--green);
      margin-bottom: 1.2rem;
    }
    .open-tag {
      display: inline-flex; align-items: center; gap: 0.35rem;
      font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase;
      padding: 0.22rem 0.6rem; border-radius: 2px;
      background: rgba(0,191,99,0.12); color: #00bf63; border: 1px solid rgba(0,191,99,0.28);
    }
    .open-dot { width: 6px; height: 6px; background: #00bf63; border-radius: 50%; animation: pulse 2s ease infinite; display: inline-block; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
    .hero-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3.2rem, 5.8vw, 6.2rem);
      line-height: 0.97; letter-spacing: 0.02em;
    }
    .hero-title .t-white { color: var(--white); display: block; }
    .hero-title .t-green { color: var(--green); display: block; }
    .hero-title .t-muted { color: rgba(255,255,255,0.35); display: block; }
    .hero-divider { width: 40px; height: 1px; background: linear-gradient(90deg, var(--green), transparent); margin: 1.6rem 0; }

    .hero-desc { font-size: 1rem; color: var(--muted2); line-height: 1.78; max-width: 460px; font-weight: 300; }

    .hero-meta {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 0; margin-top: 1.8rem;
      border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; max-width: 460px;
    }
    @media (max-width: 640px) { .hero-meta { grid-template-columns: 1fr 1fr; max-width: 100%; } }
    .meta-block { padding: 0.9rem 1rem; border-right: 1px solid var(--border); }
    .meta-block:last-child { border-right: none; }
    .meta-label { font-family: 'DM Mono', monospace; font-size: 0.52rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.25rem; }
    .meta-value { font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem; letter-spacing: 0.06em; color: var(--white); line-height: 1; }
    .meta-value.green { color: #00bf63; }

    .hero-right { position: relative; display: flex; align-items: center; justify-content: center; padding: 4rem 2.5rem 4rem 1rem; }
    @media (max-width: 900px) { .hero-right { padding: 2rem 1.5rem 2.5rem; } }

    .event-card-hero {
      width: 90%; max-width: 460px;
      background: var(--card); border: 1px solid var(--border-strong); border-radius: var(--r);
      overflow: hidden; position: relative;
    }
    .event-card-hero::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: #00bf63; z-index: 2; }
    .event-card-img { position: relative; overflow: hidden; height: 260px; }
    .event-card-img img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.72) saturate(0.85) sepia(0.08); }
    .event-card-img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 50%, rgba(17,17,17,0.9) 100%); }
    .event-card-img-label { position: absolute; bottom: 1rem; left: 1.25rem; z-index: 3; font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.4); }
    .event-card-body { padding: 1.75rem 1.75rem 2rem; }
    .event-tag-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.1rem; }
    .etag {
      padding: 0.22rem 0.65rem; border-radius: 2px;
      font-family: 'DM Mono', monospace; font-size: 0.56rem; letter-spacing: 0.14em; text-transform: uppercase;
    }
    .etag.lang { background: rgba(255,184,0,0.1); color: var(--green); border: 1px solid rgba(255,184,0,0.2); }
    .etag.format { background: rgba(255,255,255,0.05); color: var(--muted); border: 1px solid var(--border); }
    .event-card-title { font-family: 'Bebas Neue', sans-serif; font-size: 1.6rem; line-height: 1.05; letter-spacing: 0.03em; margin-bottom: 1.2rem; }
    .event-detail-row { display: flex; flex-direction: column; gap: 0.65rem; }
    .event-detail { display: flex; align-items: flex-start; gap: 0.75rem; }
    .detail-icon { width: 28px; height: 28px; border-radius: 2px; background: rgba(0,191,99,0.10); border: 1px solid rgba(0,191,99,0.18); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .detail-icon svg { width: 13px; height: 13px; stroke: #00bf63; }
    .detail-text { font-size: 0.88rem; color: var(--muted2); line-height: 1.4; }
    .detail-label { font-family: 'DM Mono', monospace; font-size: 0.52rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); display: block; margin-bottom: 0.1rem; }

    .register-block {
      margin-top: 1.5rem; display: block; width: 100%; padding: 0.95rem 1.1rem;
      background: var(--green); border-radius: var(--r); text-decoration: none;
      font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.85rem;
      text-transform: uppercase; letter-spacing: 0.12em; color: #000;
      text-align: center; transition: background 0.2s, transform 0.2s;
    }
    .register-block:hover { background: #ffc926; transform: translateY(-1px); }

    .stat-badge { position: absolute; z-index: 6; background: rgba(5,5,5,0.9); backdrop-filter: blur(16px); border: 1px solid var(--border-strong); padding: 0.7rem 1rem; border-radius: var(--r); }
    .stat-badge.tl { top: 1rem; left: -1rem; }
    .stat-badge.br { bottom: 4rem; right: -1rem; }
    .sb-num { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; color: #00bf63; line-height: 1; }
    .sb-label { font-family: 'DM Mono', monospace; font-size: 0.5rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--muted); margin-top: 0.1rem; }
    @media (max-width: 900px) { .stat-badge { display: none; } }

    /* ── PRINCIPLE BANNER ── */
    .principle { background: var(--green); padding: 1.6rem 0; overflow: hidden; }
    .principle-inner { max-width: 1280px; margin: 0 auto; padding: 0 2.5rem; display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
    .principle-tag { font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(0,0,0,0.5); white-space: nowrap; border: 1px solid rgba(0,0,0,0.2); padding: 0.22rem 0.6rem; border-radius: var(--r); }
    .principle-text { font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.5rem, 3vw, 2.5rem); color: #000; letter-spacing: 0.04em; }

    /* ── SECTIONS ── */
    .section { padding: 6rem 0; }
    .section-alt { background: var(--off-black); }
    .container { max-width: 1280px; margin: 0 auto; padding: 0 2.5rem; }
    @media (max-width: 640px) { .container { padding: 0 1.25rem; } }
    .sec-label { font-family: 'DM Mono', monospace; font-size: 0.65rem; letter-spacing: 0.25em; text-transform: uppercase; color: #00bf63; margin-bottom: 0.9rem; display: flex; align-items: center; gap: 0.6rem; }
    .sec-label::before { content: ''; display: inline-block; width: 18px; height: 1px; background: #00bf63; }
    .sec-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2.6rem, 4.5vw, 4.2rem); line-height: 0.95; letter-spacing: 0.01em; }
    .sec-desc { margin-top: 1.1rem; color: var(--muted2); font-size: 0.97rem; line-height: 1.82; max-width: 540px; font-weight: 300; }

    /* ── BENEFITS GRID ── */
    .benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; margin-top: 2.5rem; }
    @media (max-width: 900px) { .benefits-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 500px) { .benefits-grid { grid-template-columns: 1fr; } }
    .benefit-cell { background: var(--card); padding: 2rem 1.75rem; transition: background 0.2s; position: relative; overflow: hidden; }
    .benefit-cell:hover { background: var(--card2); }
    .benefit-cell::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--green); opacity: 0; transition: opacity 0.2s; }
    .benefit-cell:hover::after { opacity: 1; }
    .benefit-icon { width: 36px; height: 36px; border-radius: var(--r); background: var(--green-dim); border: 1px solid rgba(255,184,0,0.2); display: flex; align-items: center; justify-content: center; margin-bottom: 1.1rem; color: var(--green); flex-shrink: 0; }
    .benefit-title { font-weight: 700; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--white); margin-bottom: 0.6rem; }
    .benefit-desc { font-size: 0.85rem; color: var(--muted); line-height: 1.65; }

    /* ── TECH REVEAL ── */
    .tech-reveal { margin-top: 2rem; border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; }
    .tech-reveal-btn { width: 100%; background: var(--card); border: none; color: var(--white); padding: 1.1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; cursor: pointer; font-family: 'DM Mono', monospace; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.16em; transition: background 0.2s; }
    .tech-reveal-btn:hover { background: var(--card2); }
    .tech-reveal-btn svg { width: 16px; height: 16px; color: var(--green); transition: transform 0.3s; flex-shrink: 0; }
    .tech-reveal-btn.open svg { transform: rotate(45deg); }
    .tech-reveal-body { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; background: var(--off-black); }
    .tech-reveal-inner { padding: 1.5rem; font-size: 0.88rem; color: var(--muted2); line-height: 1.78; border-top: 1px solid var(--border); }

    /* ── WHAT YOU'LL BUILD ── */
    .build-rows { margin-top: 3.5rem; display: flex; flex-direction: column; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; }
    .build-row { display: grid; grid-template-columns: 1fr 1fr; min-height: 300px; background: var(--card); }
    .build-row.flip .build-text-side { order: 2; }
    .build-row.flip .build-photo-side { order: 1; }
    .build-text-side { display: flex; flex-direction: column; justify-content: center; padding: 2.5rem 3rem; border-right: 1px solid var(--border); position: relative; }
    .build-row.flip .build-text-side { border-right: none; border-left: 1px solid var(--border); }
    .build-photo-side { position: relative; overflow: hidden; }
    .build-photo-side img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; filter: brightness(0.65) saturate(0.75) sepia(0.08) contrast(1.05); transition: transform 0.6s ease, filter 0.4s ease; display: block; }
    .build-row:hover .build-photo-side img { transform: scale(1.04); filter: brightness(0.78) saturate(0.85) sepia(0.04) contrast(1.03); }
    .build-photo-accent { position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--green); z-index: 2; }
    .build-photo-label { position: absolute; bottom: 1rem; left: 1.25rem; z-index: 3; font-family: 'DM Mono', monospace; font-size: 0.52rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.35); }
    .build-num { font-family: 'Bebas Neue', sans-serif; font-size: 3rem; color: var(--green); opacity: 0.25; line-height: 1; margin-bottom: 0.5rem; transition: opacity 0.2s; }
    .build-row:hover .build-num { opacity: 0.5; }
    .build-title { font-weight: 700; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--white); margin-bottom: 0.5rem; }
    .build-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.65; margin-bottom: 1.25rem; }
    .build-checks { list-style: none; }
    .build-checks li { display: flex; gap: 0.65rem; font-size: 0.84rem; color: var(--muted2); padding: 0.5rem 0; border-bottom: 1px solid var(--border); }
    .build-checks li:last-child { border-bottom: none; }
    .build-checks li::before { content: '→'; color: var(--green); flex-shrink: 0; font-size: 0.7rem; margin-top: 3px; }
    @media (max-width: 700px) { .build-row { grid-template-columns: 1fr; } .build-photo-side { min-height: 220px; order: 0 !important; } .build-text-side { order: 1 !important; border-right: none !important; border-left: none !important; border-top: 1px solid var(--border); } }

    /* ── AGENDA ── */
    .agenda-grid { margin-top: 3rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; }
    @media (max-width: 700px) { .agenda-grid { grid-template-columns: 1fr; } }
    .agenda-card { background: var(--card); padding: 2rem 2.25rem; transition: background 0.2s; }
    .agenda-card:hover { background: var(--card2); }
    .agenda-time { font-family: 'Bebas Neue', sans-serif; font-size: 2.2rem; color: #00bf63; line-height: 1; margin-bottom: 0.4rem; }
    .agenda-topic { font-weight: 600; font-size: 0.9rem; color: var(--white); text-transform: uppercase; letter-spacing: 0.07em; margin-bottom: 0.4rem; }
    .agenda-detail { font-size: 0.83rem; color: var(--muted); line-height: 1.6; }

    /* ── INSTRUCTOR ── */
    .instructor-wrap { display: grid; grid-template-columns: 340px 1fr; gap: 5rem; align-items: center; margin-top: 3.5rem; }
    @media (max-width: 800px) { .instructor-wrap { grid-template-columns: 1fr; gap: 2rem; } }
    .instructor-photo-card { position: relative; }
    .instructor-photo-card-inner { overflow: hidden; border-radius: var(--r); position: relative; }
    .instructor-photo-card-inner::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--green); z-index: 2; }
    .instructor-photo-card-inner img { display: block; width: 100%; aspect-ratio: 3/4; object-fit: cover; object-position: center top; filter: brightness(0.78) saturate(0.88) sepia(0.1); }
    .instructor-plate { padding: 1.2rem 1.25rem; background: var(--card); border: 1px solid var(--border-strong); border-top: none; }
    .instructor-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.9rem; letter-spacing: 0.04em; line-height: 1; }
    .instructor-role { font-family: 'DM Mono', monospace; font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--green); margin-top: 0.3rem; }
    .instructor-badges { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.75rem; }
    .ibadge { padding: 0.22rem 0.65rem; border-radius: 2px; font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.14em; text-transform: uppercase; background: var(--green-dim); color: var(--green); border: 1px solid rgba(255,184,0,0.2); }
    .instructor-bio { font-size: 0.97rem; color: var(--muted2); line-height: 1.82; font-weight: 300; }
    .instructor-quote { margin-top: 1.5rem; padding: 1.25rem 1.5rem; background: var(--green-dim); border: 1px solid rgba(255,184,0,0.18); border-radius: var(--r); font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; color: var(--white); line-height: 1.1; }
    .instructor-quote span { color: var(--green); }

    /* ── GALLERY ── */
    .gallery-section { padding: 6rem 0; background: var(--black); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .gallery-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem; }
    .gallery-count { font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
    .gallery-grid { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; gap: 0.75rem; }
    @media (max-width: 700px) { .gallery-grid { display: flex; overflow-x: auto; gap: 0.65rem; padding-bottom: 1rem; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; } .gallery-grid::-webkit-scrollbar { display: none; } }
    .gallery-slot-a { grid-row: 1 / 3; position: relative; overflow: hidden; min-height: 420px; }
    .gallery-slot-a img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; filter: brightness(0.72) contrast(1.05) saturate(0.75) sepia(0.08); transition: transform 0.6s ease, filter 0.4s ease; }
    .gallery-slot-a:hover img { transform: scale(1.03); filter: brightness(0.82) contrast(1.03) saturate(0.85) sepia(0.04); }
    .gallery-slot-b { position: relative; overflow: hidden; aspect-ratio: 16/9; }
    .gallery-slot-b img { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(0.72) contrast(1.05) saturate(0.75) sepia(0.08); transition: transform 0.6s ease, filter 0.4s ease; }
    .gallery-slot-b:hover img { transform: scale(1.03); filter: brightness(0.82) contrast(1.03) saturate(0.85) sepia(0.04); }
    .gallery-slot-c { position: relative; overflow: hidden; aspect-ratio: 16/9; }
    .gallery-slot-c img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; filter: brightness(0.72) contrast(1.05) saturate(0.75) sepia(0.08); transition: transform 0.6s ease, filter 0.4s ease; }
    .gallery-slot-c:hover img { transform: scale(1.03); filter: brightness(0.82) contrast(1.03) saturate(0.85) sepia(0.04); }
    .gallery-img-label { position: absolute; bottom: 0; left: 0; right: 0; padding: 1.25rem 1.25rem 1rem; background: linear-gradient(transparent, rgba(5,5,5,0.82) 70%); font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.45); pointer-events: none; }
    .gallery-slot-a::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--green); z-index: 2; }
    @media (max-width: 700px) { .gallery-slot-a, .gallery-slot-b, .gallery-slot-c { flex: 0 0 72vw; max-width: 72vw; aspect-ratio: 4/3; scroll-snap-align: start; grid-row: auto; min-height: unset; } .gallery-slot-a::before { display: none; } .gallery-slot-a img, .gallery-slot-b img, .gallery-slot-c img { height: 100%; } }
    .gallery-scroll-hint { display: none; margin-top: 0.85rem; font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); text-align: center; }
    @media (max-width: 700px) { .gallery-scroll-hint { display: block; } }

    /* ── TRUSTPILOT ── */
    .tp-section { padding: 6rem 0; background: var(--off-black); border-top: 1px solid var(--border); }
    .tp-header { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; margin-bottom: 3rem; }
    .tp-score-wrap { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 0.75rem; }
    .tp-score { font-family: 'Bebas Neue', sans-serif; font-size: 2.8rem; color: var(--white); line-height: 1; }
    .tp-score-sub { font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-top: 0.2rem; }
    .tp-star-row { display: flex; align-items: center; gap: 0.3rem; margin-bottom: 0.35rem; }
    .tp-star { width: 22px; height: 22px; background: #00b67a; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
    .tp-star.half { background: linear-gradient(90deg, #00b67a 60%, rgba(255,255,255,0.1) 60%); }
    .tp-link { font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--green); text-decoration: none; border-bottom: 1px solid rgba(255,184,0,0.3); padding-bottom: 1px; transition: color 0.2s; }
    .tp-link:hover { opacity: 0.8; }
    .tp-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; }
    @media (max-width: 800px) { .tp-cards { grid-template-columns: 1fr; } }
    .tp-card { background: var(--card); padding: 2rem; display: flex; flex-direction: column; gap: 1rem; transition: background 0.2s; position: relative; overflow: hidden; }
    .tp-card:hover { background: var(--card2); }
    .tp-card::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--green); opacity: 0; transition: opacity 0.2s; }
    .tp-card:hover::after { opacity: 1; }
    .tp-card-stars { display: flex; gap: 3px; }
    .tp-card-star { width: 16px; height: 16px; background: #00b67a; flex-shrink: 0; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
    .tp-card-text { font-size: 0.9rem; color: var(--muted2); line-height: 1.75; font-style: italic; flex: 1; }
    .tp-card-text::before { content: '"'; }
    .tp-card-text::after { content: '"'; }
    .tp-card-name { font-family: 'DM Sans', sans-serif; font-size: 0.82rem; font-weight: 600; color: var(--white); }
    .tp-card-date { font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); margin-top: 0.1rem; }

    /* ── TICKETS ── */
    .tickets-wrap { display: grid; grid-template-columns: 1.2fr 1fr; gap: 5rem; align-items: start; margin-top: 3.5rem; }
    @media (max-width: 800px) { .tickets-wrap { grid-template-columns: 1fr; gap: 2.5rem; } }
    .include-list { list-style: none; margin-top: 1.5rem; }
    .include-list li { display: flex; gap: 0.85rem; align-items: flex-start; padding: 0.9rem 0; border-bottom: 1px solid var(--border); color: var(--muted); font-size: 0.9rem; line-height: 1.5; }
    .include-list li:last-child { border-bottom: none; }
    .include-list li .ic { color: var(--green); flex-shrink: 0; margin-top: 2px; font-size: 0.8rem; }
    .ticket-box { background: var(--card); border: 1px solid var(--border-strong); border-radius: var(--r); padding: 2.5rem; position: relative; overflow: hidden; }
    .ticket-box::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--green); }
    .ticket-status { display: inline-flex; align-items: center; gap: 0.5rem; font-family: 'DM Mono', monospace; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.16em; padding: 0.3rem 0.8rem; border-radius: 2px; background: rgba(255,184,0,0.1); color: var(--green); border: 1px solid rgba(255,184,0,0.25); margin-bottom: 1.25rem; }
    .ticket-status-dot { width: 6px; height: 6px; background: var(--green); border-radius: 50%; animation: pulse 2s ease infinite; }
    .ticket-price-old { font-family: 'DM Mono', monospace; font-size: 1rem; color: var(--muted); text-decoration: line-through; }
    .ticket-price { font-family: 'Bebas Neue', sans-serif; font-size: 3.5rem; color: var(--white); line-height: 1; letter-spacing: 0.02em; }
    .ticket-price-sub { font-family: 'DM Mono', monospace; font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--muted); margin-top: 0.2rem; }
    .ticket-divider { height: 1px; background: var(--border); margin: 1.5rem 0; }
    .ticket-register-btn { display: flex; align-items: center; justify-content: center; gap: 0.6rem; width: 100%; padding: 1.1rem 2rem; border-radius: var(--r); text-decoration: none; background: var(--green); color: #000; font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.14em; transition: background 0.2s, transform 0.2s, box-shadow 0.2s; }
    .ticket-register-btn:hover { background: #ffc926; transform: translateY(-2px); box-shadow: 0 8px 32px var(--green-glow); }
    .ticket-note { margin-top: 0.85rem; font-family: 'DM Mono', monospace; font-size: 0.56rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--muted); text-align: center; }
    .ticket-note a { color: var(--green); text-decoration: none; border-bottom: 1px solid rgba(255,184,0,0.3); }

    /* ── FAQ ── */
    .faq-list { margin-top: 3.5rem; max-width: 760px; }
    .faq-item { border-bottom: 1px solid var(--border); }
    .faq-btn { width: 100%; background: none; border: none; color: var(--white); padding: 1.3rem 0; display: flex; justify-content: space-between; align-items: center; text-align: left; cursor: pointer; font-family: 'DM Sans', sans-serif; font-size: 0.95rem; font-weight: 500; gap: 1rem; transition: color 0.2s; }
    .faq-btn span { flex: 1; min-width: 0; }
    .faq-btn:hover { color: var(--green); }
    .faq-icon { width: 17px; height: 17px; flex-shrink: 0; color: var(--green); transition: transform 0.3s; }
    .faq-item.open .faq-icon { transform: rotate(45deg); }
    .faq-body { max-height: 0; overflow: hidden; transition: max-height 0.35s ease; }
