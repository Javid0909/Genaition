  <style>
    :root{
      --ink:#07110e;
      --forest:#0b1f19;
      --forest2:#0f2a22;
      --accent:#2a7a5a;
      --accent2:#9ed1b7;
      --gold:#FFC107;
      --paper:#f6f7f7;
      --card:#ffffff;
      --ring: rgba(42,122,90,.35);
      --shadow: 0 20px 40px rgba(0,0,0,.10);
      --shadow2: 0 10px 24px rgba(0,0,0,.10);
      --radius: 20px;
    }

    html { scroll-behavior:smooth; }
    body { background: var(--paper); }

    :focus { outline: none; }
    .focus-ring:focus { box-shadow: 0 0 0 4px var(--ring); }

    .bg-acoustic{
      background:
        radial-gradient(1200px 600px at 20% -10%, rgba(158,209,183,.28), transparent 60%),
        radial-gradient(900px 500px at 90% 10%, rgba(255,193,7,.18), transparent 60%),
        linear-gradient(180deg, #ffffff, #f3f5f5);
    }

    .glass{
      background: rgba(7,17,14,.55);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,.10);
    }

    .hero{
      position: relative;
      min-height: 92vh;
      display: grid;
      place-items: center;
      overflow: hidden;
      background:
        radial-gradient(900px 500px at 30% 10%, rgba(158,209,183,.25), transparent 60%),
        radial-gradient(700px 450px at 75% 0%, rgba(255,193,7,.18), transparent 55%),
        linear-gradient(180deg, rgba(7,17,14,.82), rgba(7,17,14,.96)),
        url('/humanb.png') center/cover no-repeat;
    }

    .hero::after{
      content:"";
      position:absolute;
      inset:0;
      background: radial-gradient(900px 500px at 50% 10%, rgba(42,122,90,.22), transparent 60%);
      pointer-events:none;
    }

    .blob{
      position:absolute;
      width: 520px;
      height: 520px;
      border-radius: 9999px;
      background: radial-gradient(circle at 30% 30%, rgba(158,209,183,.40), rgba(42,122,90,.08) 55%, transparent 70%);
      opacity: .85;
      transform: translate3d(0,0,0);
      animation: drift 10s ease-in-out infinite;
      pointer-events:none;
    }
    @keyframes drift{
      0%,100%{ transform: translate(-18%, -10%) scale(1); }
      50%{ transform: translate(-10%, -4%) scale(1.05); }
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.6rem;
      padding:.9rem 1.15rem;
      border-radius: 14px;
      font-weight: 800;
      transition: transform .15s ease, box-shadow .15s ease, background .15s ease, color .15s ease, border-color .15s ease;
      will-change: transform;
      user-select:none;
    }
    .btn:active{ transform: translateY(1px) scale(.99); }

    .btn-primary{
      background: linear-gradient(135deg, var(--accent), #2f8b66);
      color:#fff;
      box-shadow: 0 12px 26px rgba(42,122,90,.30);
      border: 1px solid rgba(255,255,255,.14);
    }
    .btn-primary:hover{
      transform: translateY(-1px);
      box-shadow: 0 16px 34px rgba(42,122,90,.34);
    }

    .btn-outline{
      background: rgba(255,255,255,.10);
      color:#fff;
      border: 1px solid rgba(255,255,255,.18);
    }
    .btn-outline:hover{
      background: rgba(255,255,255,.14);
      transform: translateY(-1px);
    }

    .badge{
      display:inline-flex;
      gap:.5rem;
      align-items:center;
      padding:.35rem .65rem;
      border-radius: 9999px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      font-size: .72rem;
      color: #0a1a15;
      background: rgba(255,193,7,.92);
      border: 1px solid rgba(255,255,255,.35);
    }

    .card{
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow2);
      border: 1px solid rgba(7,17,14,.06);
    }
    .card-dark{
      background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
      border: 1px solid rgba(255,255,255,.10);
      box-shadow: 0 12px 30px rgba(0,0,0,.22);
      border-radius: var(--radius);
    }

    .soft-divider{
      height:1px;
      background: linear-gradient(90deg, transparent, rgba(7,17,14,.12), transparent);
    }

    .title-underline{
      position: relative;
      display:inline-block;
      padding-bottom:.35rem;
    }
    .title-underline::after{
      content:"";
      position:absolute;
      left:0;
      bottom:0;
      width: 72%;
      height: 4px;
      border-radius: 9999px;
      background: linear-gradient(90deg, rgba(42,122,90,.95), rgba(158,209,183,.90));
    }

    .faq-chevron{ transition: transform .2s ease; }
    .faq-open .faq-chevron{ transform: rotate(180deg); }

    /* Price styling */
    .price-wrap{ display:flex; align-items:baseline; gap:.6rem; flex-wrap:wrap; }
    .price-old{
      text-decoration: line-through;
      opacity:.65;
      font-weight:800;
    }
    .price-new{
      font-weight: 900;
      letter-spacing: -0.02em;
    }
    .pill-earlybird{
      display:inline-flex;
      align-items:center;
      gap:.4rem;
      padding:.25rem .55rem;
      border-radius: 9999px;
      font-size: .72rem;
      font-weight: 900;
      background: rgba(255,193,7,.18);
      border: 1px solid rgba(255,193,7,.35);
      color: #5a4300;
    }

@media (max-width: 768px){
  .hero{
    min-height: 88vh;

    background:
      radial-gradient(1200px 700px at 15% -10%, rgba(158,209,183,.22), transparent 62%),
      radial-gradient(900px 520px at 90% 8%, rgba(255,193,7,.14), transparent 60%),
      linear-gradient(180deg, rgba(7,17,14,.78), rgba(7,17,14,.96)),
      url('/javidbest-mobile.png') center/contain no-repeat;
  }

  /* index-style readability sweep (mobile only) */
  .hero::before{
    content:"";
    position:absolute;
    inset:0;
    background: linear-gradient(
      90deg,
      rgba(7,17,14,.88) 0%,
      rgba(7,17,14,.62) 55%,
      rgba(7,17,14,.42) 100%
    );
    pointer-events:none;
  }

  /* keep the green glow tuned for mobile */
  .hero::after{
    content:"";
    position:absolute;
    inset:0;
    background: radial-gradient(900px 520px at 50% 10%, rgba(42,122,90,.18), transparent 62%);
    pointer-events:none;
  }

  .blob{ width: 420px; height: 420px; }
}
