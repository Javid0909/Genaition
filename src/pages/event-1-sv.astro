<!DOCTYPE html>
<html lang="sv">
<head>
<meta charset="UTF-8">
<title>AI Agent Workshop – Svenska</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

<script defer src="https://cloud.umami.is/script.js" data-website-id="045fc1e4-9f56-44f2-992e-98f5fb7717a5"></script>

<style>
  /* ─── DESIGN SYSTEM ─────────────────────────────────────────── */
  :root {
    --bg:        #050505;
    --surface:   #0d0d0d;
    --card:      #111111;
    --card2:     #161616;
    --border:    rgba(255,255,255,0.07);
    --border-hi: rgba(255,255,255,0.13);
    --green:     #76b82a;
    --green-dim: rgba(118,184,42,0.10);
    --green-glow:rgba(118,184,42,0.28);
    --gold:      #FFC107;
    --alert:     #ff6432;
    --white:     #ffffff;
    --muted:     rgba(255,255,255,0.42);
    --muted2:    rgba(255,255,255,0.65);
    --r:         2px;
    --header:    64px;
    color-scheme: dark;
  }

  *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

  html { scroll-behavior:smooth; }

  body {
    background: var(--bg);
    color: var(--white);
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    overflow-x: hidden;
    padding-left:  max(0px, env(safe-area-inset-left, 0px));
    padding-right: max(0px, env(safe-area-inset-right, 0px));
  }

  /* ─── NAV ───────────────────────────────────────────────────── */
  header {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: var(--header);
    background: rgba(5,5,5,0.96);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    z-index: 100;
    display: flex;
    align-items: center;
  }
  .hdr-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 max(1.25rem, env(safe-area-inset-left, 0px)) 0 max(1.25rem, env(safe-area-inset-left, 0px));
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
  }
  .logo-mark {
    width: 36px; height: 36px;
    border-radius: var(--r);
    border: 1px solid var(--border-hi);
    background: #0a0a0a;
    overflow: hidden;
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .logo-mark img { width:100%; height:100%; object-fit:cover; }
  .logo-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.3rem;
    letter-spacing: 0.12em;
    color: var(--white);
    line-height: 1;
  }
  .logo-sub {
    font-family: 'DM Mono', monospace;
    font-size: 0.52rem;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--green);
    display: block;
    margin-top: 3px;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-links a {
    font-family: 'DM Mono', monospace;
    font-size: 0.63rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--white); }
  .nav-cta {
    background: var(--green);
    color: #000;
    font-weight: 700;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.5rem 1.3rem;
    border-radius: var(--r);
    text-decoration: none;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .nav-cta:hover { background: #8fd433; transform: translateY(-1px); }
  .mobile-cta {
    display: none;
    background: var(--green);
    color: #000;
    font-weight: 700;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.45rem 0.9rem;
    border-radius: var(--r);
    text-decoration: none;
  }
  @media (max-width: 768px) {
    .nav-links { display: none; }
    .nav-cta { display: none; }
    .mobile-cta { display: block; }
  }

  /* ─── HERO ──────────────────────────────────────────────────── */
  .hero {
    padding-top: var(--header);
    min-height: 90vh;
    display: flex;
    align-items: stretch;
    background: var(--bg);
    position: relative;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/workshopdec.jpg');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    filter: brightness(0.28) saturate(0.6);
    z-index: 0;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(118,184,42,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(118,184,42,0.025) 1px, transparent 1px);
    background-size: 52px 52px;
    pointer-events: none;
    z-index: 1;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(5,5,5,0.25) 0%, rgba(5,5,5,0.7) 100%);
    pointer-events: none;
    z-index: 1;
  }
  .hero-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 3.5rem max(1.5rem, env(safe-area-inset-left, 0px));
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; gap: 2rem; }
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .tag-live {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.22rem 0.65rem;
    border-radius: var(--r);
    background: rgba(118,184,42,0.12);
    color: var(--green);
    border: 1px solid rgba(118,184,42,0.32);
  }
  .live-dot {
    width: 6px; height: 6px;
    background: var(--green);
    border-radius: 50%;
    animation: pulse 2s ease infinite;
    flex-shrink: 0;
  }
  .tag-plain {
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--border-hi);
    padding: 0.22rem 0.65rem;
    border-radius: var(--r);
  }
  @keyframes pulse {
    0%,100% { opacity:1; transform:scale(1); }
    50%      { opacity:.5; transform:scale(1.4); }
  }

  .hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3.2rem, 6vw, 6.2rem);
    line-height: 1.0;
    letter-spacing: 0.02em;
  }
  .hero-title .t-white { color: var(--white); display: block; }
  .hero-title .t-green { color: var(--green); display: block; }

  .hero-divider {
    width: 44px; height: 1px;
    background: linear-gradient(90deg, var(--green), transparent);
    margin: 1.5rem 0;
  }

  .hero-desc {
    font-size: 1rem;
    color: var(--muted2);
    line-height: 1.8;
    max-width: 500px;
    font-weight: 300;
  }

  .hero-meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--r);
    overflow: hidden;
    margin-top: 1.6rem;
    max-width: 560px;
  }
  @media (max-width: 640px) {
    .hero-meta { grid-template-columns: 1fr 1fr; }
    .meta-block { border-bottom: 1px solid var(--border) !important; }
    .meta-block:nth-child(2n) { border-right: none !important; }
    .meta-block:nth-last-child(-n+2) { border-bottom: none !important; }
  }
  .meta-block {
    padding: 0.85rem 1rem;
    border-right: 1px solid var(--border);
  }
  .meta-block:last-child { border-right: none; }
  .meta-lbl {
    font-family: 'DM Mono', monospace;
    font-size: 0.52rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.3rem;
  }
  .meta-val {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    color: var(--white);
    line-height: 1;
  }
  .meta-val.green { color: var(--green); }
  .meta-val.gold  { color: var(--gold); }
  .meta-sub {
    font-family: 'DM Mono', monospace;
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-top: 0.2rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.8rem;
    flex-wrap: wrap;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: var(--green);
    color: #000;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: 0.95rem 2.2rem;
    border-radius: var(--r);
    text-decoration: none;
    transition: all 0.22s;
    flex-shrink: 0;
  }
  .btn-primary:hover { background: #8fd433; transform: translateY(-2px); }
  .btn-ghost {
    font-family: 'DM Mono', monospace;
    font-size: 0.63rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted2);
    text-decoration: none;
    transition: color 0.2s;
  }
  .btn-ghost:hover { color: var(--white); }
  .btn-ghost::after { content: ' \2192'; }

  /* ─── TICKET CARD (hero sidebar) ────────────────────────────── */
  .ticket-card {
    background: var(--card);
    border: 1px solid var(--border-hi);
    border-radius: var(--r);
    padding: 1.8rem;
    position: sticky;
    top: calc(var(--header) + 1.5rem);
    align-self: start;
  }
  @media (max-width: 960px) {
    .ticket-card { display: none; }
  }
  .ticket-offer-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--green);
    border: 1px solid var(--green);
    padding: 0.28rem 0.85rem;
    border-radius: 999px;
  }
  .offer-dot {
    width: 6px; height: 6px;
    background: var(--green);
    border-radius: 50%;
    animation: pulse 2s ease infinite;
    flex-shrink: 0;
  }
  .price-old {
    font-family: 'DM Mono', monospace;
    font-size: 0.9rem;
    color: var(--muted);
    text-decoration: line-through;
    letter-spacing: 0.06em;
  }
  .price-big {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 4rem;
    color: var(--white);
    letter-spacing: 0.03em;
    line-height: 1;
  }
  .price-save {
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--alert);
    margin-top: 0.3rem;
  }
  .perk-dash {
    color: var(--green);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .ticket-divider {
    height: 1px;
    background: var(--border);
    margin: 1rem 0;
  }
  .ticket-perks {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1.2rem;
  }
  .ticket-perks li {
    display: flex;
    gap: 0.65rem;
    font-size: 0.82rem;
    color: var(--muted2);
    align-items: flex-start;
  }
  .perk-check {
    color: var(--green);
    font-weight: 700;
    margin-top: 1px;
    flex-shrink: 0;
  }
  .ticket-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.9rem;
    background: var(--green);
    color: #000;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    border-radius: var(--r);
    text-decoration: none;
    transition: all 0.22s;
  }
  .ticket-cta:hover { background: #8fd433; }
  .ticket-footnote {
    text-align: center;
    font-family: 'DM Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-top: 0.75rem;
  }
  .ticket-footnote a { color: var(--green); text-decoration: none; }

  /* ─── SECTION WRAPPER ───────────────────────────────────────── */
  .section {
    padding: 5rem max(1.5rem, env(safe-area-inset-left, 0px));
  }
  .section-inner {
    max-width: 1400px;
    margin: 0 auto;
  }
  .s-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--green);
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.75rem;
  }
  .s-eyebrow::before {
    content: '';
    display: inline-block;
    width: 22px; height: 1px;
    background: var(--green);
    flex-shrink: 0;
  }
  .s-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.2rem, 3.5vw, 3.4rem);
    letter-spacing: 0.03em;
    line-height: 1.05;
    margin-bottom: 1rem;
  }
  .s-desc {
    font-size: 0.95rem;
    color: var(--muted2);
    line-height: 1.8;
    max-width: 560px;
    font-weight: 300;
  }

  /* ─── WHY SECTION ───────────────────────────────────────────── */
  .why-section { background: var(--surface); }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--r);
    overflow: hidden;
    margin-top: 2.5rem;
  }
  @media (max-width: 900px) {
    .why-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 500px) {
    .why-grid { grid-template-columns: 1fr; }
  }
  .why-cell {
    background: var(--card);
    padding: 1.8rem 1.5rem;
  }
  .why-num {
    font-family: 'DM Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 0.9rem;
  }
  .why-cell h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    letter-spacing: 0.04em;
    color: var(--white);
    margin-bottom: 0.6rem;
  }
  .why-cell p {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.7;
    font-weight: 300;
  }

  /* ─── BUILD SECTION ─────────────────────────────────────────── */
  .build-section { background: var(--bg); }
  .build-grid {
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--r);
    overflow: hidden;
    margin-top: 2.5rem;
  }
  .build-row {
    display: grid;
    grid-template-columns: 56px 1fr;
    background: var(--card);
    transition: background 0.2s;
  }
  .build-row:hover { background: var(--card2); }
  .build-step-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.3rem;
    letter-spacing: 0.05em;
    color: rgba(118,184,42,0.3);
    padding: 1.5rem 0 1.5rem 1.4rem;
    border-right: 1px solid var(--border);
    display: flex;
    align-items: flex-start;
    padding-top: 1.6rem;
    line-height: 1;
  }
  .build-content {
    padding: 1.4rem 1.5rem;
  }
  .build-content h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.25rem;
    letter-spacing: 0.04em;
    color: var(--white);
    margin-bottom: 0.4rem;
  }
  .build-content p {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.7;
    font-weight: 300;
  }
  .build-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.65rem;
  }
  .build-tag {
    font-family: 'DM Mono', monospace;
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
    border: 1px solid rgba(118,184,42,0.25);
    background: rgba(118,184,42,0.07);
    padding: 0.15rem 0.45rem;
    border-radius: var(--r);
  }

  /* ─── AGENDA ────────────────────────────────────────────────── */
  .agenda-section { background: var(--surface); }
  .agenda-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
    margin-top: 2.5rem;
    align-items: start;
  }
  @media (max-width: 860px) {
    .agenda-layout { grid-template-columns: 1fr; }
  }
  .agenda-list {
    border: 1px solid var(--border);
    border-radius: var(--r);
    overflow: hidden;
  }
  .agenda-item {
    display: grid;
    grid-template-columns: 70px 1fr;
    background: var(--card);
    border-bottom: 1px solid var(--border);
  }
  .agenda-item:last-child { border-bottom: none; }
  .agenda-time {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--green);
    padding: 1.1rem 0 1.1rem 1.1rem;
    border-right: 1px solid var(--border);
    display: flex;
    align-items: center;
    font-variant-numeric: tabular-nums;
  }
  .agenda-body {
    padding: 1rem 1.2rem;
  }
  .agenda-body strong {
    display: block;
    font-size: 0.9rem;
    color: var(--white);
    font-weight: 600;
    margin-bottom: 0.15rem;
  }
  .agenda-body span {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .stack-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--r);
    padding: 1.5rem;
  }
  .stack-lbl {
    font-family: 'DM Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.1rem;
  }
  .stack-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .stack-item {
    border-left: 2px solid var(--green);
    padding-left: 0.85rem;
  }
  .stack-item strong {
    font-size: 0.88rem;
    color: var(--white);
    font-weight: 600;
    display: block;
  }
  .stack-item span {
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .stack-divider {
    height: 1px;
    background: var(--border);
    margin: 1.2rem 0;
  }

  /* ─── INSTRUCTOR ────────────────────────────────────────────── */
  .instructor-section { background: var(--bg); }
  .instructor-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-top: 2.5rem;
    align-items: center;
  }
  @media (max-width: 768px) {
    .instructor-layout { grid-template-columns: 1fr; gap: 2rem; }
  }
  .instructor-img-wrap {
    aspect-ratio: 4/5;
    border-radius: var(--r);
    overflow: hidden;
    border: 1px solid var(--border);
    max-height: 420px;
    background: var(--card);
    position: relative;
  }
  .instructor-img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 50%, rgba(5,5,5,0.8) 100%);
  }
  .instructor-img-wrap img {
    width: 100%; height: 100%; object-fit: cover; object-position: center top;
  }
  .instructor-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.4rem;
    letter-spacing: 0.05em;
    color: var(--white);
    line-height: 1.0;
    margin-bottom: 0.25rem;
  }
  .instructor-role {
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 1.2rem;
  }
  .instructor-bio {
    font-size: 0.9rem;
    color: var(--muted2);
    line-height: 1.8;
    font-weight: 300;
    margin-bottom: 1.2rem;
  }
  blockquote.instructor-quote {
    border-left: 2px solid var(--green);
    padding-left: 1rem;
    font-style: italic;
    font-size: 0.9rem;
    color: var(--muted2);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }
  .instructor-stats {
    display: grid;
