<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GenAition | AI-workshops & Automation</title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Umami Analytics -->
  <script defer src="https://cloud.umami.is/script.js" data-website-id="045fc1e4-9f56-44f2-992e-98f5fb7717a5"></script>

  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --black: #050505;
      --off-black: #0d0d0d;
      --card: #111111;
      --card2: #161616;
      --border: rgba(255,255,255,0.07);
      --border-strong: rgba(255,255,255,0.12);
      --accent: #00bf63;
      --accent-dim: rgba(0,191,99,0.10);
      --accent-glow: rgba(0,191,99,0.28);
      --gold: #ffb800;
      --white: #ffffff;
      --muted: rgba(255,255,255,0.42);
      --muted2: rgba(255,255,255,0.65);
      --header: 66px;
      --r: 3px;
    }

    html { scroll-behavior: smooth; }
    body { background: var(--black); color: var(--white); font-family: 'DM Sans', sans-serif; font-size: 16px; line-height: 1.6; overflow-x: hidden; }
    section, [id] { scroll-margin-top: calc(var(--header) + 12px); }

    /* ── HEADER ── */
    header {
      position: fixed; top: 0; left: 0; right: 0; height: var(--header);
      background: rgba(5,5,5,0.96); backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border); z-index: 100;
      display: flex; align-items: center;
    }
    .hdr-inner {
      max-width: 1280px; margin: 0 auto; padding: 0 2.5rem;
      width: 100%; display: flex; align-items: center; justify-content: space-between;
    }
    .logo { display: flex; align-items: center; gap: 0.85rem; text-decoration: none; }
    .logo-mark {
      width: 36px; height: 36px; border-radius: var(--r);
      background: var(--card); border: 1px solid var(--border-strong);
      display: flex; align-items: center; justify-content: center; overflow: hidden;
    }
    .logo-mark img { width: 100%; height: 100%; object-fit: cover; }
    .logo-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; letter-spacing: 0.12em; color: var(--white); line-height: 1; }
    .logo-sub { font-family: 'DM Mono', monospace; font-size: 0.52rem; text-transform: uppercase; letter-spacing: 0.24em; color: var(--accent); display: block; margin-top: 2px; }
    .nav-links { display: flex; align-items: center; gap: 2.2rem; }
    .nav-links a { font-family: 'DM Mono', monospace; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--muted); text-decoration: none; transition: color 0.2s; }
    .nav-links a:hover { color: var(--white); }

    /* Language dropdown */
    .lang-wrap { position: relative; }
    .lang-btn {
      display: flex; align-items: center; gap: 0.4rem; cursor: pointer;
      font-family: 'DM Mono', monospace; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--muted); background: none; border: 1px solid var(--border); border-radius: var(--r);
      padding: 0.35rem 0.7rem; transition: color 0.2s, border-color 0.2s;
    }
    .lang-btn:hover { color: var(--white); border-color: var(--border-strong); }
    .lang-btn img { width: 18px; height: 18px; border-radius: 2px; object-fit: cover; }
    .lang-btn svg { width: 12px; height: 12px; }
    .lang-menu {
      display: none; position: absolute; right: 0; top: calc(100% + 8px); min-width: 140px;
      background: var(--card2); border: 1px solid var(--border-strong); border-radius: var(--r); overflow: hidden; z-index: 200;
    }
    .lang-wrap.open .lang-menu { display: block; }
    .lang-menu a { display: flex; align-items: center; gap: 0.6rem; padding: 0.65rem 1rem; font-family: 'DM Mono', monospace; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted2); text-decoration: none; transition: background 0.2s, color 0.2s; }
    .lang-menu a:hover { background: rgba(255,255,255,0.05); color: var(--white); }
    .lang-menu a img { width: 16px; height: 16px; border-radius: 2px; object-fit: cover; }

    .nav-cta {
      background: var(--accent); color: #000;
      font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.72rem;
      text-transform: uppercase; letter-spacing: 0.14em;
      padding: 0.55rem 1.4rem; border-radius: var(--r); text-decoration: none;
      transition: all 0.2s;
    }
    .nav-cta:hover { background: #00d470; transform: translateY(-1px); }

    .mobile-menu-btn {
      display: none; align-items: center; justify-content: center;
      width: 38px; height: 38px; background: none; border: 1px solid var(--border);
      border-radius: var(--r); cursor: pointer; color: var(--white);
    }
    .mobile-menu-btn svg { width: 20px; height: 20px; }

    @media (max-width: 768px) {
      .hdr-inner { padding: 0 1.25rem; }
      .nav-links { display: none; }
      .nav-cta { display: none; }
      .mobile-menu-btn { display: flex; }
    }

    /* Mobile drawer */
    #mobileMenu { display: none; position: fixed; inset: 0; z-index: 200; }
    #mobileMenu.open { display: block; }
    .mobile-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.7); }
    .mobile-drawer {
      position: absolute; top: 0; right: 0; height: 100%; width: 280px;
      background: var(--card2); border-left: 1px solid var(--border-strong);
      padding: 1.5rem; display: flex; flex-direction: column; gap: 0;
    }
    .mobile-drawer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .mobile-drawer-close {
      width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;
      background: none; border: 1px solid var(--border); border-radius: var(--r); cursor: pointer; color: var(--muted);
    }
    .mobile-drawer a { display: block; padding: 0.75rem 0; font-family: 'DM Mono', monospace; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--border); transition: color 0.2s; }
    .mobile-drawer a:hover { color: var(--white); }
    .mobile-drawer-lang { margin-top: 1.25rem; }
    .mobile-drawer-lang p { font-family: 'DM Mono', monospace; font-size: 0.52rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--muted); margin-bottom: 0.75rem; }
    .mobile-lang-links { display: flex; gap: 0.5rem; }
    .mobile-lang-link { display: flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.75rem; border: 1px solid var(--border); border-radius: var(--r); text-decoration: none; font-family: 'DM Mono', monospace; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--muted2); transition: border-color 0.2s, color 0.2s; }
    .mobile-lang-link:hover { border-color: var(--border-strong); color: var(--white); }
    .mobile-lang-link img { width: 16px; height: 16px; border-radius: 2px; }
    .mobile-cta { margin-top: 1.5rem; display: block; width: 100%; padding: 0.9rem; background: var(--accent); color: #000; font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em; text-align: center; text-decoration: none; border-radius: var(--r); }

    /* ── HERO ── */
    .hero {
      min-height: 92vh; padding-top: var(--header);
      display: flex; align-items: stretch; background: var(--black); position: relative; overflow: hidden;
    }
    .hero-grid-bg {
      position: absolute; inset: 0; z-index: 0;
      background-image: linear-gradient(rgba(0,191,99,0.04) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(0,191,99,0.04) 1px, transparent 1px);
      background-size: 52px 52px;
    }
    .hero-glow {
      position: absolute; top: -200px; left: 30%; width: 700px; height: 700px;
      border-radius: 50%; background: radial-gradient(circle, rgba(0,191,99,0.08) 0%, transparent 70%);
      z-index: 0; pointer-events: none;
    }
    .hero-img-bg {
      position: absolute; inset: 0; z-index: 0;
      background: url('/javidbest.png') center/cover no-repeat;
      opacity: 0.12;
    }
    .hero-inner {
      max-width: 1280px; margin: 0 auto; width: 100%;
      display: grid; grid-template-columns: 55% 45%; align-items: center;
      position: relative; z-index: 2; padding: 0 2.5rem;
    }
    @media (max-width: 900px) { .hero-inner { grid-template-columns: 1fr; padding: 0 1.25rem; } .hero { min-height: auto; } }

    .hero-left { display: flex; flex-direction: column; justify-content: center; padding: 4rem 3rem 3.5rem 0; }
    @media (max-width: 900px) { .hero-left { padding: 3rem 0 2rem; } }

    .hero-eyebrow {
      display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap;
      font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent);
      margin-bottom: 1.2rem;
    }
    .live-tag {
      display: inline-flex; align-items: center; gap: 0.35rem;
      font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase;
      padding: 0.22rem 0.6rem; border-radius: 2px;
      background: rgba(0,191,99,0.12); color: var(--accent); border: 1px solid rgba(0,191,99,0.28);
    }
    .live-dot { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; animation: pulse 2s ease infinite; display: inline-block; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

    .hero-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3.2rem, 5.8vw, 6.2rem);
      line-height: 0.97; letter-spacing: 0.02em;
    }
    .hero-title .t-white { color: var(--white); display: block; }
    .hero-title .t-accent { color: var(--accent); display: block; }
    .hero-divider { width: 40px; height: 1px; background: linear-gradient(90deg, var(--accent), transparent); margin: 1.6rem 0; }
    .hero-desc { font-size: 1rem; color: var(--muted2); line-height: 1.78; max-width: 460px; font-weight: 300; }

    .hero-meta {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 0; margin-top: 1.8rem;
      border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; max-width: 460px;
    }
    @media (max-width: 480px) { .hero-meta { grid-template-columns: 1fr 1fr; max-width: 100%; } }
    .meta-block { padding: 0.9rem 1rem; border-right: 1px solid var(--border); }
    .meta-block:last-child { border-right: none; }
    .meta-label { font-family: 'DM Mono', monospace; font-size: 0.52rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.25rem; }
    .meta-value { font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem; letter-spacing: 0.06em; color: var(--white); line-height: 1; }
    .meta-value.accent { color: var(--accent); }

    .hero-btns { display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.75rem; }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.85rem 1.75rem; background: var(--accent); color: #000;
      font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.82rem;
      text-transform: uppercase; letter-spacing: 0.12em; border-radius: var(--r);
      text-decoration: none; transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    }
    .btn-primary:hover { background: #00d470; transform: translateY(-1px); box-shadow: 0 8px 28px var(--accent-glow); }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.85rem 1.75rem; background: none; color: var(--muted2);
      font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.82rem;
      text-transform: uppercase; letter-spacing: 0.12em; border-radius: var(--r);
      border: 1px solid var(--border-strong); text-decoration: none; transition: border-color 0.2s, color 0.2s;
    }
    .btn-secondary:hover { border-color: rgba(255,255,255,0.25); color: var(--white); }

    .hero-right { position: relative; display: flex; align-items: center; justify-content: center; padding: 4rem 0 4rem 1rem; }
    @media (max-width: 900px) { .hero-right { padding: 0 0 3rem; } }

    .hero-card {
      width: 100%; max-width: 420px;
      background: var(--card); border: 1px solid var(--border-strong); border-radius: var(--r);
      overflow: hidden; position: relative;
    }
    .hero-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--accent); z-index: 2; }
    .hero-card-body { padding: 2rem; }
    .hero-card-label { font-family: 'DM Mono', monospace; font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--gold); margin-bottom: 0.6rem; }
    .hero-card-title { font-family: 'Bebas Neue', sans-serif; font-size: 1.9rem; letter-spacing: 0.03em; line-height: 1.05; margin-bottom: 1rem; }
    .hero-card-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.75; }
    .hero-card-divider { height: 1px; background: var(--border); margin: 1.5rem 0; }
    .hero-card-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--border); }
    .hero-card-stat { background: var(--card2); padding: 1.1rem; }
    .hero-card-stat-num { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; color: var(--accent); line-height: 1; }
    .hero-card-stat-label { font-family: 'DM Mono', monospace; font-size: 0.52rem; text-transform: uppercase; letter-spacing: 0.16em; color: var(--muted); margin-top: 0.2rem; }

    /* ── PRINCIPLE BANNER ── */
    .principle { background: var(--accent); padding: 1.6rem 0; overflow: hidden; }
    .principle-inner { max-width: 1280px; margin: 0 auto; padding: 0 2.5rem; display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
    .principle-tag { font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(0,0,0,0.5); white-space: nowrap; border: 1px solid rgba(0,0,0,0.2); padding: 0.22rem 0.6rem; border-radius: var(--r); }
    .principle-text { font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.5rem, 3vw, 2.5rem); color: #000; letter-spacing: 0.04em; }

    /* ── SECTIONS ── */
    .section { padding: 6rem 0; }
    .section-alt { background: var(--off-black); }
    .container { max-width: 1280px; margin: 0 auto; padding: 0 2.5rem; }
    @media (max-width: 640px) { .container { padding: 0 1.25rem; } }
    .sec-label { font-family: 'DM Mono', monospace; font-size: 0.65rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.9rem; display: flex; align-items: center; gap: 0.6rem; }
    .sec-label::before { content: ''; display: inline-block; width: 18px; height: 1px; background: var(--accent); }
    .sec-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2.6rem, 4.5vw, 4.2rem); line-height: 0.95; letter-spacing: 0.01em; }
    .sec-desc { margin-top: 1.1rem; color: var(--muted2); font-size: 0.97rem; line-height: 1.82; max-width: 540px; font-weight: 300; }

    /* ── BENEFITS GRID ── */
    .benefits-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; margin-top: 2.5rem; }
    @media (max-width: 900px) { .benefits-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 500px) { .benefits-grid { grid-template-columns: 1fr; } }
    .benefit-cell { background: var(--card); padding: 2rem 1.75rem; transition: background 0.2s; position: relative; overflow: hidden; }
    .benefit-cell:hover { background: var(--card2); }
    .benefit-cell::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: var(--accent); opacity: 0; transition: opacity 0.2s; }
    .benefit-cell:hover::after { opacity: 1; }
    .benefit-icon { width: 36px; height: 36px; border-radius: var(--r); background: var(--accent-dim); border: 1px solid rgba(0,191,99,0.2); display: flex; align-items: center; justify-content: center; margin-bottom: 1.1rem; color: var(--accent); flex-shrink: 0; }
    .benefit-title { font-weight: 700; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.07em; color: var(--white); margin-bottom: 0.6rem; }
    .benefit-desc { font-size: 0.85rem; color: var(--muted); line-height: 1.65; }

    /* ── NEXT EVENT CARD ── */
    .next-event-card {
      background: var(--card); border: 1px solid var(--border-strong); border-radius: var(--r);
      overflow: hidden; position: relative; margin-bottom: 4rem;
    }
    .next-event-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--accent); z-index: 2; }
    .next-event-inner { display: grid; grid-template-columns: 1fr 1fr; }
    @media (max-width: 700px) { .next-event-inner { grid-template-columns: 1fr; } }
    .next-event-body { padding: 2.5rem 3rem; display: flex; flex-direction: column; justify-content: center; }
    @media (max-width: 700px) { .next-event-body { padding: 2rem 1.75rem; } }
    .next-event-label { font-family: 'DM Mono', monospace; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.22em; color: var(--accent); margin-bottom: 0.75rem; }
    .next-event-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2rem, 4vw, 3rem); line-height: 1; letter-spacing: 0.02em; margin-bottom: 1rem; }
    .next-event-desc { font-size: 0.9rem; color: var(--muted2); line-height: 1.75; margin-bottom: 1.75rem; }
    .next-event-btns { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .next-event-img { position: relative; overflow: hidden; min-height: 280px; }
    .next-event-img picture { position: absolute; inset: 0; width: 100%; height: 100%; }
    .next-event-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.65) saturate(0.8) sepia(0.08); transition: transform 0.6s ease; }
    .next-event-card:hover .next-event-img img { transform: scale(1.04); }
    .next-event-img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(17,17,17,0.5) 0%, transparent 60%); }

    /* ── WORKSHOPS (build-rows) ── */
    .build-rows { margin-top: 3.5rem; display: flex; flex-direction: column; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; }
    .build-row { display: grid; grid-template-columns: 1fr 1fr; min-height: 300px; background: var(--card); }
    .build-row.flip .build-text-side { order: 2; }
    .build-row.flip .build-photo-side { order: 1; }
    .build-text-side { display: flex; flex-direction: column; justify-content: center; padding: 2.5rem 3rem; border-right: 1px solid var(--border); }
    .build-row.flip .build-text-side { border-right: none; border-left: 1px solid var(--border); }
    .build-photo-side { position: relative; overflow: hidden; }
    .build-photo-side img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; filter: brightness(0.65) saturate(0.75) sepia(0.08) contrast(1.05); transition: transform 0.6s ease, filter 0.4s ease; display: block; }
    .build-row:hover .build-photo-side img { transform: scale(1.04); filter: brightness(0.78) saturate(0.85) sepia(0.04) contrast(1.03); }
    .build-photo-accent { position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--accent); z-index: 2; }
    .build-photo-label { position: absolute; bottom: 1rem; left: 1.25rem; z-index: 3; font-family: 'DM Mono', monospace; font-size: 0.52rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.35); }
    .build-num { font-family: 'Bebas Neue', sans-serif; font-size: 3rem; color: var(--accent); opacity: 0.25; line-height: 1; margin-bottom: 0.5rem; transition: opacity 0.2s; }
    .build-row:hover .build-num { opacity: 0.5; }
    .build-tag { display: inline-flex; padding: 0.2rem 0.65rem; border-radius: 2px; font-family: 'DM Mono', monospace; font-size: 0.56rem; letter-spacing: 0.14em; text-transform: uppercase; background: var(--accent-dim); color: var(--accent); border: 1px solid rgba(0,191,99,0.2); margin-bottom: 0.75rem; }
    .build-title { font-weight: 700; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--white); margin-bottom: 0.5rem; }
    .build-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.65; margin-bottom: 1.25rem; }
    .build-checks { list-style: none; }
    .build-checks li { display: flex; gap: 0.65rem; font-size: 0.84rem; color: var(--muted2); padding: 0.5rem 0; border-bottom: 1px solid var(--border); }
    .build-checks li:last-child { border-bottom: none; }
    .build-checks li::before { content: '→'; color: var(--accent); flex-shrink: 0; font-size: 0.7rem; margin-top: 3px; }
    .build-cta { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.25rem; padding: 0.75rem 1.25rem; background: var(--accent); color: #000; font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em; border-radius: var(--r); text-decoration: none; transition: background 0.2s; }
    .build-cta:hover { background: #00d470; }
    @media (max-width: 700px) {
      .build-row { grid-template-columns: 1fr; }
      .build-photo-side { min-height: 220px; order: 0 !important; }
      .build-text-side { order: 1 !important; border-right: none !important; border-left: none !important; border-top: 1px solid var(--border); padding: 2rem 1.5rem; }
    }

    /* ── CONTACT ── */
    .contact-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; margin-top: 3.5rem; }
    @media (max-width: 800px) { .contact-wrap { grid-template-columns: 1fr; gap: 2.5rem; } }
    .contact-info p { font-size: 0.97rem; color: var(--muted2); line-height: 1.82; font-weight: 300; margin-bottom: 1.5rem; }
    .contact-detail { display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.9rem; }
    .contact-detail-icon { width: 32px; height: 32px; border-radius: var(--r); background: var(--accent-dim); border: 1px solid rgba(0,191,99,0.2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
    .contact-detail-icon svg { width: 14px; height: 14px; stroke: var(--accent); }
    .contact-detail-text { font-size: 0.88rem; color: var(--muted2); line-height: 1.5; }
    .contact-detail-label { font-family: 'DM Mono', monospace; font-size: 0.5rem; text-transform: uppercase; letter-spacing: 0.16em; color: var(--muted); display: block; margin-bottom: 0.1rem; }
    .contact-form-box { background: var(--card); border: 1px solid var(--border-strong); border-radius: var(--r); padding: 2.5rem; position: relative; overflow: hidden; }
    .contact-form-box::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--accent); }
    .form-field { margin-bottom: 1rem; }
    .form-label { font-family: 'DM Mono', monospace; font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--muted); display: block; margin-bottom: 0.45rem; }
    .form-input { width: 100%; background: var(--off-black); border: 1px solid var(--border); border-radius: var(--r); padding: 0.8rem 1rem; color: var(--white); font-family: 'DM Sans', sans-serif; font-size: 0.9rem; transition: border-color 0.2s; }
    .form-input:focus { outline: none; border-color: rgba(0,191,99,0.4); }
    .form-input::placeholder { color: var(--muted); }
    textarea.form-input { resize: vertical; min-height: 100px; }
    .form-submit { width: 100%; padding: 1rem; background: var(--accent); color: #000; font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.14em; border: none; border-radius: var(--r); cursor: pointer; margin-top: 0.5rem; transition: background 0.2s, transform 0.2s; }
    .form-submit:hover { background: #00d470; transform: translateY(-1px); }

    /* ── FOOTER ── */
    footer { padding: 4rem 0 2.5rem; border-top: 1px solid var(--border); background: var(--black); }
    .footer-inner { max-width: 1280px; margin: 0 auto; padding: 0 2.5rem; display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 4rem; }
    @media (max-width: 800px) { .footer-inner { grid-template-columns: 1fr 1fr; gap: 2.5rem; } }
    @media (max-width: 500px) { .footer-inner { grid-template-columns: 1fr; gap: 2rem; padding: 0 1.25rem; } }
    .footer-brand-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; letter-spacing: 0.1em; color: var(--white); margin-bottom: 0.5rem; }
    .footer-brand-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.7; max-width: 260px; margin-bottom: 1.5rem; }
    .footer-socials { display: flex; gap: 0.65rem; }
    .footer-social { width: 34px; height: 34px; border-radius: var(--r); background: var(--card); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; overflow: hidden; transition: border-color 0.2s; }
    .footer-social:hover { border-color: var(--border-strong); }
    .footer-social img { width: 18px; height: 18px; object-fit: cover; }
    .footer-col-title { font-family: 'DM Mono', monospace; font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--muted); margin-bottom: 1.25rem; }
    .footer-links { list-style: none; display: flex; flex-direction: column; gap: 0.65rem; }
    .footer-links a { font-size: 0.88rem; color: var(--muted2); text-decoration: none; transition: color 0.2s; }
    .footer-links a:hover { color: var(--white); }
    .footer-bottom { max-width: 1280px; margin: 3rem auto 0; padding: 1.5rem 2.5rem 0; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
    .footer-copy { font-family: 'DM Mono', monospace; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.2em; color: rgba(255,255,255,0.18); }

    /* ── ANIMATIONS ── */
