  <!-- ✅ Umami Analytics (always active) -->
  <script defer src="https://cloud.umami.is/script.js" data-website-id="045fc1e4-9f56-44f2-992e-98f5fb7717a5"></script>

  <style>
    :root{
      --ink:#07110e;
      --forest:#0b1f19;
      --forest2:#0f2a22;
      --accent:#2a7a5a;
      --accent2:#9ed1b7;
      --gold:#FFC107;
      --paper:#f6f7f7;
      --card:#ffffff;
      --ring: rgba(42,122,90,.35);
      --shadow: 0 20px 40px rgba(0,0,0,.10);
      --shadow2: 0 10px 24px rgba(0,0,0,.10);
      --radius: 20px;
    }

    html { scroll-behavior:smooth; }
    body { background: #050c0a; }

    :focus { outline: none; }
    .focus-ring:focus { box-shadow: 0 0 0 4px var(--ring); }

    .bg-acoustic{
      background:
        radial-gradient(1200px 600px at 20% -10%, rgba(158,209,183,.20), transparent 60%),
        radial-gradient(900px 500px at 90% 10%, rgba(255,193,7,.12), transparent 60%),
        linear-gradient(180deg, #ffffff, #f3f5f5);
    }

    .glass{
      background: rgba(7,17,14,.55);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,.10);
    }

    .hero{
      position: relative;
      min-height: 92vh;
      display: grid;
      place-items: center;
      overflow: hidden;
      background:
        radial-gradient(900px 500px at 30% 10%, rgba(158,209,183,.18), transparent 60%),
        radial-gradient(700px 450px at 75% 0%, rgba(255,193,7,.14), transparent 55%),
        linear-gradient(180deg, rgba(7,17,14,.80), rgba(7,17,14,.96)),
        url('/humanai.png') center/cover no-repeat;
    }

    .hero::before{
      content:"";
      position:absolute;
      inset:0;
      background: linear-gradient(90deg, rgba(7,17,14,.84) 0%, rgba(7,17,14,.55) 55%, rgba(7,17,14,.35) 100%);
      pointer-events:none;
    }
    .hero::after{
      content:"";
      position:absolute;
      inset:0;
      background: radial-gradient(900px 500px at 50% 10%, rgba(42,122,90,.18), transparent 60%);
      pointer-events:none;
    }

    .blob{
      position:absolute;
      width: 520px;
      height: 520px;
      border-radius: 9999px;
      background: radial-gradient(circle at 30% 30%, rgba(158,209,183,.34), rgba(42,122,90,.08) 55%, transparent 70%);
      opacity: .85;
      animation: drift 10s ease-in-out infinite;
      pointer-events:none;
    }
    @keyframes drift{
      0%,100%{ transform: translate(-18%, -10%) scale(1); }
      50%{ transform: translate(-10%, -4%) scale(1.05); }
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.6rem;
      padding:.9rem 1.15rem;
      border-radius: 14px;
      font-weight: 800;
      transition: transform .15s ease, box-shadow .15s ease, background .15s ease, color .15s ease, border-color .15s ease;
      user-select:none;
    }
    .btn:active{ transform: translateY(1px) scale(.99); }

    .btn-primary{
      background: linear-gradient(135deg, var(--accent), #2f8b66);
      color:#fff;
      box-shadow: 0 12px 26px rgba(42,122,90,.30);
      border: 1px solid rgba(255,255,255,.14);
    }
    .btn-primary:hover{
      transform: translateY(-1px);
      box-shadow: 0 16px 34px rgba(42,122,90,.34);
    }

    .btn-outline{
      background: rgba(255,255,255,.10);
      color:#fff;
      border: 1px solid rgba(255,255,255,.18);
    }
    .btn-outline:hover{
      background: rgba(255,255,255,.14);
      transform: translateY(-1px);
    }

    .badge{
      display:inline-flex;
      gap:.5rem;
      align-items:center;
      padding:.35rem .65rem;
      border-radius: 9999px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      font-size: .72rem;
      color: #0a1a15;
      background: rgba(255,193,7,.92);
      border: 1px solid rgba(255,255,255,.35);
    }

    .card{
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow2);
      border: 1px solid rgba(7,17,14,.06);
    }
    .card-dark{
      background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
      border: 1px solid rgba(255,255,255,.10);
      box-shadow: 0 12px 30px rgba(0,0,0,.22);
      border-radius: var(--radius);
    }

    .soft-divider{
      height:1px;
      background: linear-gradient(90deg, transparent, rgba(7,17,14,.12), transparent);
    }

    .title-underline{
      position: relative;
      display:inline-block;
      padding-bottom:.35rem;
    }
    .title-underline::after{
      content:"";
      position:absolute;
      left:0;
      bottom:0;
      width: 72%;
      height: 4px;
      border-radius: 9999px;
      background: linear-gradient(90deg, rgba(42,122,90,.95), rgba(158,209,183,.90));
    }

    /* Dropdown (click-based) */
    .dropdown-menu { display:none; }
    .dropdown-open .dropdown-menu { display:block; }

    /* Scroll animation */
    @keyframes breatheZoom {
      0% { transform: scale(0.98); opacity: .01; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-breathe {
      animation: breatheZoom 0.7s ease-out both;
      will-change: transform;
    }

    @media (max-width: 768px){
      .hero{
        min-height: 88vh;
        background:
          radial-gradient(900px 500px at 30% 10%, rgba(158,209,183,.18), transparent 60%),
          radial-gradient(700px 450px at 75% 0%, rgba(255,193,7,.14), transparent 55%),
          linear-gradient(180deg, rgba(7,17,14,.80), rgba(7,17,14,.96)),
          url('/javidbest-mobile.png') center/cover no-repeat;
      }
      .blob{ width: 420px; height: 420px; }
    }
  </style>
</head>

