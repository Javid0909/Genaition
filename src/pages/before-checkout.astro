  <style>
    :root{
      --ink:#07110e;
      --forest:#0b1f19;
      --forest2:#0f2a22;
      --accent:#2a7a5a;
      --accent2:#9ed1b7;
      --gold:#FFC107;
      --paper:#f6f7f7;
      --card:#ffffff;
      --ring: rgba(42,122,90,.35);
      --shadow: 0 20px 40px rgba(0,0,0,.10);
      --shadow2: 0 10px 24px rgba(0,0,0,.10);
      --radius: 20px;
    }

    html { scroll-behavior:smooth; }
    body { background: var(--paper); }
    :focus { outline: none; }
    .focus-ring:focus { box-shadow: 0 0 0 4px var(--ring); }

    .bg-acoustic{
      background:
        radial-gradient(1200px 600px at 20% -10%, rgba(158,209,183,.28), transparent 60%),
        radial-gradient(900px 500px at 90% 10%, rgba(255,193,7,.16), transparent 60%),
        linear-gradient(180deg, #ffffff, #f3f5f5);
    }

    .glass{
      background: rgba(7,17,14,.55);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255,255,255,.10);
    }

    .hero{
      position: relative;
      overflow:hidden;
      background:
        radial-gradient(900px 500px at 30% 10%, rgba(158,209,183,.22), transparent 60%),
        radial-gradient(700px 450px at 75% 0%, rgba(255,193,7,.16), transparent 55%),
        linear-gradient(180deg, rgba(7,17,14,.92), rgba(7,17,14,.98));
    }

    .blob{
      position:absolute;
      width: 520px;
      height: 520px;
      border-radius: 9999px;
      background: radial-gradient(circle at 30% 30%, rgba(158,209,183,.40), rgba(42,122,90,.08) 55%, transparent 70%);
      opacity: .85;
      animation: drift 10s ease-in-out infinite;
      pointer-events:none;
      left: -120px;
      top: -140px;
    }
    @keyframes drift{
      0%,100%{ transform: translate(0,0) scale(1); }
      50%{ transform: translate(30px, 22px) scale(1.05); }
    }

    .badge{
      display:inline-flex;
      gap:.5rem;
      align-items:center;
      padding:.35rem .65rem;
      border-radius: 9999px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      font-size: .72rem;
      color: #0a1a15;
      background: rgba(255,193,7,.92);
      border: 1px solid rgba(255,255,255,.35);
    }

    .card{
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow2);
      border: 1px solid rgba(7,17,14,.06);
    }
    .card-dark{
      background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
      border: 1px solid rgba(255,255,255,.10);
      box-shadow: 0 12px 30px rgba(0,0,0,.22);
      border-radius: var(--radius);
    }

    .soft-divider{
      height:1px;
      background: linear-gradient(90deg, transparent, rgba(7,17,14,.12), transparent);
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.6rem;
      padding:.9rem 1.15rem;
      border-radius: 14px;
      font-weight: 900;
      transition: transform .15s ease, box-shadow .15s ease, background .15s ease, color .15s ease, border-color .15s ease;
      will-change: transform;
      user-select:none;
    }
    .btn:active{ transform: translateY(1px) scale(.99); }

    .btn-primary{
      background: linear-gradient(135deg, var(--accent), #2f8b66);
      color:#fff;
      box-shadow: 0 12px 26px rgba(42,122,90,.30);
      border: 1px solid rgba(255,255,255,.14);
    }
    .btn-primary:hover{
      transform: translateY(-1px);
      box-shadow: 0 16px 34px rgba(42,122,90,.34);
    }

    .btn-outline{
      background: rgba(255,255,255,.10);
      color:#fff;
      border: 1px solid rgba(255,255,255,.18);
    }
    .btn-outline:hover{
      background: rgba(255,255,255,.14);
      transform: translateY(-1px);
    }

    .input{
      width:100%;
      border: 1px solid rgba(7,17,14,.14);
      border-radius: 14px;
      padding: .75rem .9rem;
      background: #fff;
      transition: box-shadow .15s ease, border-color .15s ease;
    }
    .input:focus{
      border-color: rgba(42,122,90,.55);
      box-shadow: 0 0 0 4px rgba(42,122,90,.18);
    }

    .pill{
      display:inline-flex;
      align-items:center;
      gap:.4rem;
      padding:.25rem .55rem;
      border-radius: 9999px;
      font-size: .72rem;
      font-weight: 900;
      background: rgba(255,193,7,.14);
      border: 1px solid rgba(255,193,7,.30);
