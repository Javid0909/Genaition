  <!-- ================= LOGIC (kept from your original, upgraded UI bindings) ================= -->
  <script>
    const dec = document.getElementById('decrease');
    const inc = document.getElementById('increase');
    const count = document.getElementById('ticketCount');

    const discounted = document.getElementById('discountedPrice');
    const original = document.getElementById('originalPrice');
    const badge = document.getElementById('discountBadge');

    const promo = document.getElementById('promoCode');
    const promoMsg = document.getElementById('promoMessage');

    // Extra UI mirrors (hero + side)
    const heroTotal = document.getElementById('heroTotal');
    const heroOriginal = document.getElementById('heroOriginal');
    const heroBadge = document.getElementById('heroBadge');
    const heroPromoHint = document.getElementById('heroPromoHint');

    const sideTotal = document.getElementById('sideTotal');
    const sideOriginal = document.getElementById('sideOriginal');
    const sideTickets = document.getElementById('sideTickets');
    const sidePromo = document.getElementById('sidePromo');

    const promoLabel = document.getElementById('promoLabel');

    let promoActive = false;

    // Keep your original pricing (DO NOT change Stripe links logic)
    const normalPrice = 595, originalPrice = 895, hyperPrice = 595;

    function fmtSEK(n){ return `SEK ${n}`; }

    function updateTotal() {
      const val = parseInt(count.value, 10);
      const pricePer = promoActive ? hyperPrice : normalPrice;

      const totalDisc = val * pricePer;
      const totalOrig = val * originalPrice;
      const discount = Math.round(((totalOrig - totalDisc) / totalOrig) * 100);

      // Main total line
      discounted.textContent = fmtSEK(totalDisc);
      original.textContent = fmtSEK(totalOrig);
      badge.textContent = promoActive ? "-46% (Hyper Island)" : `-${discount}%`;

      // Hero mirrors
      heroTotal.textContent = fmtSEK(totalDisc);
      heroOriginal.textContent = fmtSEK(totalOrig);
      heroBadge.textContent = promoActive ? "-46% (Hyper Island)" : `-${discount}%`;
      heroPromoHint.classList.toggle("hidden", !promoActive);

      // Side mirrors
      sideTotal.textContent = fmtSEK(totalDisc);
      sideOriginal.textContent = fmtSEK(totalOrig);
      sideTickets.textContent = String(val);
      sidePromo.classList.toggle("hidden", !promoActive);

      // Labels
      promoLabel.textContent = promoActive ? "Promo pricing applied." : "Standard pricing (promo optional).";
    }

    dec.addEventListener('click', () => {
      if (parseInt(count.value, 10) > 1) {
        count.value = parseInt(count.value, 10) - 1;
        updateTotal();
      }
    });

    inc.addEventListener('click', () => {
      if (parseInt(count.value, 10) < 6) {
        count.value = parseInt(count.value, 10) + 1;
        updateTotal();
      }
    });

    promo.addEventListener('input', () => {
      if (promo.value.trim().toLowerCase() === "hyperisland") {
        promoActive = true;
        promoMsg.classList.remove("hidden");
        promoMsg.textContent = "✅ Hyper Island discount applied! Price updated.";
      } else {
        promoActive = false;
        promoMsg.classList.add("hidden");
      }
      updateTotal();
    });

    updateTotal();

    function goToStripe() {
      const form = document.getElementById("booking-form");
      if (!form.checkValidity()) { form.reportValidity(); return; }

      const tickets = parseInt(count.value, 10);
      const code = promo.value.trim().toLowerCase();

      // Webhook (keep your endpoint)
      try {
        const params = new URLSearchParams(new FormData(form));
        navigator.sendBeacon(
