    .chat-trigger { display: inline-flex; align-items: center; gap: 0.7rem; margin-top: 2rem; background: var(--green); border: none; color: #000; font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.95rem 1.8rem; border-radius: var(--r); cursor: pointer; transition: all 0.25s; position: relative; box-shadow: 0 0 0 0 var(--green-glow); animation: chatPulse 2.5s ease infinite; }
    @keyframes chatPulse { 0% { box-shadow: 0 0 0 0 rgba(118,184,42,0.5); } 70% { box-shadow: 0 0 0 12px rgba(118,184,42,0); } 100% { box-shadow: 0 0 0 0 rgba(118,184,42,0); } }
    .chat-trigger:hover { background: #8fd433; transform: translateY(-2px); box-shadow: 0 12px 40px var(--green-glow); animation: none; }

    .chat-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(6px); z-index: 9999; align-items: flex-end; justify-content: flex-end; padding: 1.5rem; }
