  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --black: #050505; --off-black: #0d0d0d; --card: #111111; --card2: #161616;
      --border: rgba(255,255,255,0.07); --border-strong: rgba(255,255,255,0.12);
      --green: #76b82a; --green-dim: rgba(118,184,42,0.12); --green-glow: rgba(118,184,42,0.3);
      --white: #ffffff; --muted: rgba(255,255,255,0.45); --muted2: rgba(255,255,255,0.65);
      --header: 68px; --r: 2px;
    }
    html { scroll-behavior: smooth; }
    body { background: var(--black); color: var(--white); font-family: 'DM Sans', sans-serif; font-size: 16px; line-height: 1.6; overflow-x: hidden; }
    section, [id] { scroll-margin-top: calc(var(--header) + 12px); }

    header { position: fixed; top: 0; left: 0; right: 0; height: var(--header); background: rgba(5,5,5,0.95); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border); z-index: 100; display: flex; align-items: center; }
    .hdr-inner { max-width: 1400px; margin: 0 auto; padding: 0 2.5rem; width: 100%; display: flex; align-items: center; justify-content: space-between; }
    .logo { display: flex; align-items: center; gap: 1rem; text-decoration: none; }
    .logo-mark { width: 38px; height: 38px; border-radius: var(--r); border: 1px solid rgba(17,20,13,0.5); display: flex; align-items: center; justify-content: center; overflow: hidden; background: #0a0a0a; }
    .logo-mark img { width: 100%; height: 100%; object-fit: cover; }
    .logo-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.35rem; letter-spacing: 0.12em; color: var(--white); line-height: 1; }
    .logo-sub { font-family: 'DM Mono', monospace; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.25em; color: var(--green); display: block; margin-top: 2px; }
    .nav-links { display: flex; align-items: center; gap: 2.5rem; }
    .nav-links a { font-family: 'DM Mono', monospace; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--muted); text-decoration: none; transition: color 0.2s; }
    .nav-links a:hover { color: var(--white); }
    .nav-apply { background: var(--green); color: #000; font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; padding: 0.55rem 1.4rem; border-radius: var(--r); text-decoration: none; transition: all 0.2s; }
    .nav-apply:hover { background: #8fd433; transform: translateY(-1px); }
    @media (max-width: 640px) { .hdr-inner { padding: 0 1.25rem; } .nav-links { display: none; } .nav-apply { display: none; } }

    .hero { min-height: 88vh; padding-top: var(--header); display: flex; align-items: stretch; background: var(--black); }
    .hero-inner { max-width: 1400px; margin: 0 auto; width: 100%; display: grid; grid-template-columns: 55% 45%; align-items: center; }
    @media (max-width: 900px) { .hero { min-height: auto; } .hero-inner { grid-template-columns: 1fr; } }
    .hero-left { display: flex; flex-direction: column; justify-content: center; padding: 3.5rem 3rem 3rem 2.5rem; position: relative; z-index: 2; }
    .hero-left::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(118,184,42,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(118,184,42,0.03) 1px, transparent 1px); background-size: 48px 48px; pointer-events: none; }
    .hero-left > * { position: relative; z-index: 1; }
    @media (max-width: 640px) { .hero-left { padding: 2rem 1.5rem 2.5rem; } }
    .hero-eyebrow { display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
    .open-tag { display: inline-flex; align-items: center; gap: 0.35rem; font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase; padding: 0.22rem 0.6rem; border-radius: 2px; background: rgba(118,184,42,0.12); color: var(--green); border: 1px solid rgba(118,184,42,0.35); }
    .open-dot { width: 6px; height: 6px; background: var(--green); border-radius: 50%; animation: pulse 2s ease infinite; display: inline-block; }
    .hero-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3.2rem, 5.5vw, 6rem); line-height: 1.0; letter-spacing: 0.02em; }
    .hero-title .t-white { color: var(--white); display: block; }
    .hero-title .t-green { color: var(--green); display: block; }
    .hero-divider { width: 40px; height: 1px; background: linear-gradient(90deg, var(--green), transparent); margin: 1.5rem 0; }
    .hero-desc { font-size: 1rem; color: var(--muted2); line-height: 1.75; max-width: 480px; font-weight: 300; }
    @media (max-width: 640px) { .hero-desc { max-width: 100%; font-size: 0.95rem; } .hero-title { font-size: clamp(3rem, 14vw, 4.5rem); } }

    .hero-meta { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 1.5rem; border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; max-width: 580px; }
    @media (max-width: 640px) { .hero-meta { grid-template-columns: 1fr 1fr; max-width: 100%; } }
    .meta-block { padding: 0.85rem 1rem; border-right: 1px solid var(--border); }
    .meta-block:last-child { border-right: none; }
    @media (max-width: 640px) { .meta-block { border-bottom: 1px solid var(--border); } .meta-block:nth-child(2n) { border-right: none; } .meta-block:nth-last-child(-n+2) { border-bottom: none; } .meta-block:last-child { border-bottom: none; border-right: none; } }
    .meta-label { font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.25rem; }
    .meta-value { font-family: 'Bebas Neue', sans-serif; font-size: 1.15rem; letter-spacing: 0.06em; color: var(--white); line-height: 1; white-space: nowrap; }
    .meta-sub { font-family: 'DM Mono', monospace; font-size: 0.52rem; letter-spacing: 0.1em; color: rgba(255,255,255,0.45); margin-top: 0.2rem; }
    .meta-value.green { color: var(--green); }
    .hero-actions { margin-top: 1.5rem; display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
    @media (max-width: 640px) { .hero-actions { flex-direction: column; align-items: flex-start; gap: 1rem; } .hero-cta { width: 100%; justify-content: center; } }
    .hero-cta { display: inline-flex; align-items: center; gap: 0.7rem; background: var(--green); color: #000; font-weight: 700; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.14em; padding: 0.95rem 2.2rem; border-radius: var(--r); text-decoration: none; transition: all 0.25s; }
    .hero-cta:hover { background: #8fd433; transform: translateY(-2px); box-shadow: 0 12px 40px var(--green-glow); }
    .hero-link { font-family: 'DM Mono', monospace; font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--border); padding-bottom: 1px; transition: color 0.2s, border-color 0.2s; }
    .hero-link:hover { color: var(--white); border-color: var(--white); }

    .hero-right { position: relative; display: flex; align-items: center; justify-content: center; padding: 4rem 2.5rem 4rem 1.5rem; }
    @media (max-width: 900px) { .hero-right { padding: 2rem 1.5rem; } }
    .photo-card-wrap { position: relative; width: 90%; max-width: 480px; }
    @media (max-width: 1100px) { .photo-card-wrap { max-width: 380px; } }
    @media (max-width: 900px) { .photo-card-wrap { width: 85%; max-width: 360px; margin: 0 auto; } }
    .photo-card-inner { position: relative; overflow: hidden; }
    .photo-card-inner img { display: block; width: 100%; aspect-ratio: 3/4; object-fit: cover; object-position: center 10%; filter: brightness(0.78) saturate(0.9); }
    .photo-grid-overlay { position: absolute; inset: 0; z-index: 1; background-image: linear-gradient(rgba(118,184,42,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(118,184,42,0.05) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none; }
    .instructor-plate { position: absolute; bottom: 0; left: 0; right: 0; z-index: 5; padding: 1.5rem 1.4rem; background: linear-gradient(transparent, rgba(5,5,5,0.95) 40%); }
    .instructor-name { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 0.05em; line-height: 1; }
    @media (max-width: 900px) { .instructor-name { font-size: 1.4rem; } }
    .instructor-role { font-family: 'DM Mono', monospace; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--green); margin-top: 0.35rem; }
    .instructor-li { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.75rem; padding: 0.3rem 0.75rem; background: rgba(10,102,194,0.15); border: 1px solid rgba(10,102,194,0.4); border-radius: var(--r); font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.15em; text-transform: uppercase; color: #6eaad8; text-decoration: none; transition: background 0.2s, border-color 0.2s; }
    .instructor-li:hover { background: rgba(10,102,194,0.3); border-color: rgba(10,102,194,0.7); color: #fff; }
    .instructor-li svg { width: 11px; height: 11px; fill: currentColor; flex-shrink: 0; }
    .stat-badge { position: absolute; z-index: 6; background: rgba(5,5,5,0.88); backdrop-filter: blur(16px); border: 1px solid var(--border-strong); padding: 0.75rem 1rem; border-radius: var(--r); }
    .stat-badge.tl { top: 1rem; left: -1rem; }
    .stat-badge.br { bottom: 7rem; right: -1rem; }
    .sb-num { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; color: var(--green); line-height: 1; }
    .sb-label { font-family: 'DM Mono', monospace; font-size: 0.52rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--muted); margin-top: 0.1rem; }
    @media (max-width: 900px) { .stat-badge { padding: 0.45rem 0.7rem; } .stat-badge.tl { top: 0.75rem; left: 0.75rem; } .stat-badge.br { bottom: 6rem; right: 0.75rem; top: auto; } .sb-num { font-size: 1.2rem; } .sb-label { font-size: 0.46rem; } }

    .video-hero { position: relative; overflow: hidden; height: 420px; display: flex; align-items: center; justify-content: center; }
    @media (max-width: 640px) { .video-hero { height: 300px; } }
    .video-hero video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
    .video-hero-overlay { position: absolute; inset: 0; z-index: 1; background: rgba(5,5,5,0.52); }
    .video-hero-grid { position: absolute; inset: 0; z-index: 2; background-image: linear-gradient(rgba(118,184,42,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(118,184,42,0.07) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none; }
    .video-hero-scanlines { position: absolute; inset: 0; z-index: 3; background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.07) 2px, rgba(0,0,0,0.07) 4px); pointer-events: none; }
    .video-hero-vignette { position: absolute; inset: 0; z-index: 4; background: radial-gradient(ellipse at center, transparent 35%, rgba(5,5,5,0.75) 100%); pointer-events: none; }
    .video-hero-content { position: relative; z-index: 5; text-align: center; padding: 0 2rem; }
    .vh-tag { display: inline-flex; align-items: center; gap: 0.5rem; font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--green); border: 1px solid rgba(118,184,42,0.3); padding: 0.3rem 0.85rem; border-radius: var(--r); margin-bottom: 1.4rem; }
    .vh-tag::before { content: ''; display: inline-block; width: 6px; height: 6px; background: var(--green); border-radius: 50%; animation: pulse 2s ease infinite; }
    .vh-headline { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2.2rem, 5vw, 4.2rem); letter-spacing: 0.03em; line-height: 1.05; color: var(--white); }
    .vh-headline .accent { color: var(--green); }
    .vh-sub { margin-top: 1rem; font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }

    .principle { background: var(--green); padding: 2rem 0; overflow: hidden; }
    .principle-inner { max-width: 1400px; margin: 0 auto; padding: 0 2.5rem; display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
    .principle-tag { font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(0,0,0,0.45); white-space: nowrap; border: 1px solid rgba(0,0,0,0.2); padding: 0.25rem 0.6rem; border-radius: var(--r); }
    .principle-text { font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.6rem, 3.5vw, 2.8rem); color: #000; letter-spacing: 0.04em; }

    .section { padding: 7rem 0; }
    @media (max-width: 640px) { .section { padding: 3.5rem 0; } }
    .section-alt { background: var(--off-black); }
    .container { max-width: 1400px; margin: 0 auto; padding: 0 2.5rem; }
    @media (max-width: 640px) { .container { padding: 0 1.25rem; } }
    .sec-label { font-family: 'DM Mono', monospace; font-size: 0.68rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--green); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.6rem; }
    .sec-label::before { content: ''; display: inline-block; width: 20px; height: 1px; background: var(--green); }
    .sec-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2.8rem, 5vw, 4.5rem); line-height: 0.95; letter-spacing: 0.01em; }
    .sec-desc { margin-top: 1.2rem; color: var(--muted2); font-size: 1rem; line-height: 1.8; max-width: 560px; font-weight: 300; }
    .build-intro { margin-top: 1.5rem; display: inline-flex; align-items: center; gap: 0.75rem; padding: 0.6rem 1.2rem; background: var(--green-dim); border: 1px solid rgba(118,184,42,0.22); border-radius: var(--r); font-family: 'DM Mono', monospace; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--green); }

    .build-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); margin-top: 2rem; border-radius: var(--r); overflow: hidden; }
    @media (max-width: 700px) { .build-grid { grid-template-columns: 1fr; } }
    .build-cell { background: var(--card); padding: 2.5rem; transition: background 0.2s; }
    @media (max-width: 640px) { .build-cell { padding: 1.5rem; } }
    .build-cell:hover { background: var(--card2); }
    .build-cell.orchestrator { grid-column: 1/-1; border-bottom: 1px solid var(--border-strong); background: #0d0d0d; }
    .orchestrator-inner { display: flex; gap: 3rem; align-items: flex-start; flex-wrap: wrap; }
    @media (max-width: 640px) { .orchestrator-inner { gap: 0; flex-direction: column; } }
    .cell-badge { display: inline-block; font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--green); border: 1px solid rgba(118,184,42,0.3); padding: 0.2rem 0.55rem; border-radius: 2px; margin-bottom: 0.8rem; }
    .cell-letter { font-family: 'Bebas Neue', sans-serif; font-size: 4rem; color: var(--green); line-height: 1; opacity: 0.3; margin-bottom: 0.4rem; }
    .cell-title { font-weight: 600; font-size: 0.95rem; margin-bottom: 1.2rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--white); }
    .cell-list { list-style: none; }
    .cell-list li { display: flex; gap: 0.75rem; color: var(--muted); font-size: 0.88rem; line-height: 1.6; padding: 0.45rem 0; border-bottom: 1px solid rgba(255,255,255,0.04); word-break: break-word; min-width: 0; }
    .cell-list li:last-child { border-bottom: none; }
    .cell-list li::before { content: '→'; color: var(--green); flex-shrink: 0; font-size: 0.75rem; margin-top: 3px; }

    .stack-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; margin-top: 2rem; }
    @media (max-width: 900px) { .stack-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) { .stack-grid { grid-template-columns: 1fr; } }
    .stack-card { background: var(--card); padding: 2rem 1.75rem; display: flex; flex-direction: column; transition: background 0.2s; position: relative; overflow: hidden; }
    @media (max-width: 640px) { .stack-card { padding: 1.25rem; } }
    .stack-card:hover { background: var(--card2); }
    .stack-card::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--green); opacity: 0; transition: opacity 0.2s; }
    .stack-card:hover::after { opacity: 1; }
    .stack-icon { width: 40px; height: 40px; border-radius: 6px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; flex-shrink: 0; }
    .stack-icon.n8n { background: rgba(255,140,0,0.1); }
    .stack-icon.claude { background: rgba(118,184,42,0.1); }
    .stack-icon.airtable { background: rgba(255,195,0,0.08); }
    .stack-role { font-family: 'DM Mono', monospace; font-size: 0.52rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--green); margin-bottom: 0.75rem; border: 1px solid rgba(118,184,42,0.25); padding: 0.18rem 0.5rem; border-radius: 2px; display: inline-block; width: fit-content; }
    .stack-name { font-weight: 600; font-size: 0.95rem; color: var(--white); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.85rem; }
    .stack-why { margin-top: 0.85rem; padding-top: 0.85rem; border-top: 1px solid var(--border); font-family: 'DM Mono', monospace; font-size: 0.58rem; color: rgba(118,184,42,0.65); line-height: 1.6; letter-spacing: 0.02em; }
    .stack-why strong { color: var(--green); font-weight: 500; }
    .stack-deploy { display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 2rem; padding: 0.5rem 1.1rem; background: var(--green-dim); border: 1px solid rgba(118,184,42,0.22); border-radius: var(--r); font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--green); }
    .stack-deploy-dot { width: 6px; height: 6px; background: var(--green); border-radius: 50%; animation: pulse 2s ease infinite; flex-shrink: 0; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

    .gallery-section { padding: 6rem 0; background: var(--black); border-top: 1px solid var(--border); }
    .gallery-inner { max-width: 1400px; margin: 0 auto; padding: 0 2.5rem; }
    @media (max-width: 640px) { .gallery-inner { padding: 0 1.25rem; } }
    .gallery-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem; }
    .gallery-count { font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
    .gallery-grid { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; gap: 0.75rem; }
    @media (max-width: 700px) { .gallery-grid { display: flex; overflow-x: auto; gap: 0.65rem; padding-bottom: 1rem; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; } .gallery-grid::-webkit-scrollbar { display: none; } }
    .gallery-slot-a { grid-row: 1 / 3; position: relative; overflow: hidden; }
    .gallery-slot-a img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; filter: brightness(0.72) contrast(1.05) saturate(0.75) sepia(0.12); transition: transform 0.6s ease, filter 0.4s ease; }
    .gallery-slot-a:hover img { transform: scale(1.03); filter: brightness(0.80) contrast(1.03) saturate(0.85) sepia(0.08); }
    .gallery-img-label { position: absolute; bottom: 0; left: 0; right: 0; padding: 1.25rem 1.25rem 1rem; background: linear-gradient(transparent, rgba(5,5,5,0.8) 70%); font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.5); pointer-events: none; }
    .gallery-slot-a::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--green); z-index: 2; }
    .gallery-slot-b { position: relative; overflow: hidden; aspect-ratio: 16/9; }
