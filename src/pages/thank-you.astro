        <img src="/android-chrome-512x512.png" alt="Genaition" onerror="this.style.display='none';" />
      </div>
      <div>
        <span class="logo-name">Genaition</span>
        <span class="logo-sub">Workshops, AI Agents</span>
      </div>
    </a>
  </div>
</nav>

<main>
  <div class="confirm-card">
    <div class="confirm-top">
      <div class="confirm-badge">
        <span class="badge-dot"></span> Booking Confirmed
      </div>
      <h1 class="confirm-title">
        You're In
        <span class="t-yellow">🎉</span>
      </h1>
      <p class="confirm-event">Workshop 06 · 13 June · 13:30–16:30</p>
    </div>
    <div class="confirm-bottom">
      <p class="confirm-message">
        Your spot is confirmed. <strong>You'll receive the Zoom link by email</strong> 24–48 hours before the workshop.
      </p>
      <div class="confirm-meta">
        <div class="confirm-meta-row">Online · Zoom · 13 June 2026</div>
        <div class="confirm-meta-row">13:30–16:30 CET</div>
        <div class="confirm-meta-row">Max 25 seats, small cohort</div>
      </div>
      <div class="confirm-divider"></div>
      <p class="confirm-message" style="margin-bottom:0;">
        Questions? Email <a href="mailto:info@genaition.org" class="confirm-email-link">info@genaition.org</a>
      </p>
      <a href="/event-1" class="confirm-back">Back to workshop page</a>
    </div>
  </div>
</main>

<footer class="site-footer">
  <div class="footer-inner">
    <a href="/index.html" class="footer-logo">
      <div class="footer-logo-mark"><img src="/android-chrome-512x512.png" alt="Genaition" onerror="this.style.display='none'" /></div>
      <span class="footer-logo-name">Genaition</span>
    </a>
    <p class="footer-copy">© 2026 GenAition. All rights reserved.</p>
  </div>
</footer>

</body>
</html>
