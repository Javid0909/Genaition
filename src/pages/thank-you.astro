  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #faf9f5;
      --bg-alt: #f2f0ea;
      --ink: #1a1208;
      --ink-2: rgba(26,18,8,0.62);
      --ink-3: rgba(26,18,8,0.38);
      --green: #1a6b3a;
      --green-bg: rgba(26,107,58,0.08);
      --green-border: rgba(26,107,58,0.22);
      --border: rgba(26,18,8,0.10);
      --border-s: rgba(26,18,8,0.18);
      --dark: #0d0d0d;
      --white: #ffffff;
      --strip: 32px;
      --nav: 60px;
      --hdr: 92px;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: 'DM Sans', sans-serif;
      font-size: 16px;
      line-height: 1.6;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── PUBLICATION STRIP ── */
    .pub-strip {
      height: var(--strip);
      background: var(--ink);
      display: flex; align-items: center;
      overflow: hidden;
    }
    .pub-marquee {
      display: flex; align-items: center;
      white-space: nowrap;
      animation: marquee 28s linear infinite;
    }
    .pub-marquee-item {
      font-family: 'DM Mono', monospace;
      font-size: 0.52rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: rgba(255,255,255,0.42); padding: 0 2.5rem;
    }
    .pub-marquee-item .dot {
      display: inline-block; width: 4px; height: 4px; background: var(--green);
      border-radius: 50%; margin: 0 1.2rem; vertical-align: middle;
    }
    @keyframes marquee {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* ── NAV ── */
    .site-nav {
      height: var(--nav);
      background: rgba(250,249,245,0.96);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border-s);
      display: flex; align-items: center;
    }
    .nav-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 2.5rem;
      width: 100%; display: flex; align-items: center; justify-content: space-between;
    }
    .logo { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; }
    .logo-mark { width: 34px; height: 34px; border-radius: 2px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .logo-mark img { width: 100%; height: 100%; object-fit: cover; }
    .logo-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.25rem; letter-spacing: 0.1em; color: var(--ink); line-height: 1; }
    .logo-sub { font-family: 'DM Mono', monospace; font-size: 0.46rem; text-transform: uppercase; letter-spacing: 0.22em; color: var(--ink-3); display: block; margin-top: 2px; }
    @media (max-width: 700px) { .nav-inner { padding: 0 1.25rem; } }

    /* ── MAIN ── */
    main {
      flex: 1;
      display: flex; align-items: center; justify-content: center;
      padding: 4rem 1.5rem;
    }

    .confirm-card {
      max-width: 520px; width: 100%;
      border: 1px solid var(--border-s); border-radius: 2px; overflow: hidden;
      animation: fadeUp 0.7s ease both;
    }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    .confirm-card::before {
      content: ''; display: block; height: 3px;
      background: linear-gradient(90deg, var(--green), #2d8a52);
    }

    .confirm-top {
      background: var(--dark);
      padding: 2.5rem 2.5rem 2rem;
      text-align: center;
    }

    .confirm-badge {
      display: inline-flex; align-items: center; gap: 0.55rem;
      font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase;
      color: #f0c000; border: 1px solid rgba(240,192,0,0.35); background: rgba(240,192,0,0.08);
      padding: 0.3rem 0.8rem; border-radius: 2px; margin-bottom: 1.5rem;
    }
    .badge-dot { width: 6px; height: 6px; background: #f0c000; border-radius: 50%; display: inline-block; flex-shrink: 0; animation: pulse 2s ease infinite; }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1);} 50%{opacity:0.3;transform:scale(0.8);} }

    .confirm-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(2.8rem, 6vw, 4.2rem);
      font-weight: 400; line-height: 0.95; letter-spacing: 0.02em;
      color: var(--white); margin-bottom: 0.5rem;
    }
    .confirm-title .t-yellow { color: #f0c000; display: block; }

    .confirm-event {
      font-family: 'DM Mono', monospace; font-size: 0.64rem;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(255,255,255,0.45); margin-top: 0.75rem;
    }

    .confirm-bottom {
      background: var(--bg-alt);
      padding: 2rem 2.5rem;
    }

    .confirm-message {
      font-size: 0.97rem; color: var(--ink-2); line-height: 1.82; font-weight: 300;
      margin-bottom: 1.5rem;
    }
    .confirm-message strong { color: var(--ink); font-weight: 600; }

    .confirm-divider { height: 1px; background: var(--border); margin: 1.5rem 0; }

    .confirm-meta {
      display: flex; flex-direction: column; gap: 0.6rem;
    }
    .confirm-meta-row {
      display: flex; align-items: center; gap: 0.75rem;
      font-family: 'DM Mono', monospace; font-size: 0.62rem;
      letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2);
    }
    .confirm-meta-row::before {
      content: '—'; color: var(--green); flex-shrink: 0; font-size: 0.75rem;
    }

    .confirm-email-link {
      color: var(--green); text-decoration: none;
      border-bottom: 1px solid var(--green-border);
      transition: border-color 0.2s;
    }
    .confirm-email-link:hover { border-color: var(--green); }

    .confirm-back {
      display: inline-flex; align-items: center; gap: 0.5rem;
      margin-top: 1.75rem;
      font-family: 'DM Mono', monospace; font-size: 0.58rem;
      text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--ink-3); text-decoration: none;
      transition: color 0.2s;
    }
    .confirm-back:hover { color: var(--green); }
    .confirm-back::before { content: '←'; }

    /* ── FOOTER ── */
    .site-footer { background: var(--ink); padding: 2.5rem 0; margin-top: auto; }
    .footer-inner { max-width: 1200px; margin: 0 auto; padding: 0 2.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
    .footer-logo { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
    .footer-logo-mark { width: 32px; height: 32px; border-radius: 2px; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); }
    .footer-logo-mark img { width: 100%; height: 100%; object-fit: cover; }
    .footer-logo-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem; letter-spacing: 0.1em; color: var(--white); }
    .footer-copy { font-family: 'DM Mono', monospace; font-size: 0.5rem; text-transform: uppercase; letter-spacing: 0.2em; color: rgba(255,255,255,0.22); }
    @media (max-width: 640px) { .footer-inner { padding: 0 1.25rem; justify-content: center; text-align: center; flex-direction: column; } }
  </style>
</head>
<body>

<div class="pub-strip">
