    <style>
      :root{
        --ink:#07110e;
        --forest:#0b1f19;
        --forest2:#0f2a22;
        --accent:#2a7a5a;
        --accent2:#9ed1b7;
        --gold:#FFC107;
        --paper:#f6f7f7;
        --card:#ffffff;
        --ring: rgba(42,122,90,.35);
        --shadow: 0 20px 40px rgba(0,0,0,.10);
        --shadow2: 0 10px 24px rgba(0,0,0,.10);
        --radius: 20px;
      }

      html { scroll-behavior:smooth; }
      body { background:#050c0a; }

      :focus { outline: none; }
      .focus-ring:focus { box-shadow: 0 0 0 4px var(--ring); }

      .bg-acoustic{
        background:
          radial-gradient(1200px 600px at 20% -10%, rgba(158,209,183,.20), transparent 60%),
          radial-gradient(900px 500px at 90% 10%, rgba(255,193,7,.12), transparent 60%),
          linear-gradient(180deg, #ffffff, #f3f5f5);
      }

      .glass{
        background: rgba(7,17,14,.55);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,.10);
      }

      .btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:.6rem;
        padding:.9rem 1.15rem;
        border-radius: 14px;
        font-weight: 800;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease, color .15s ease, border-color .15s ease;
        user-select:none;
      }
      .btn:active{ transform: translateY(1px) scale(.99); }

      .btn-primary{
        background: linear-gradient(135deg, var(--accent), #2f8b66);
        color:#fff;
        box-shadow: 0 12px 26px rgba(42,122,90,.30);
        border: 1px solid rgba(255,255,255,.14);
      }
      .btn-primary:hover{
        transform: translateY(-1px);
        box-shadow: 0 16px 34px rgba(42,122,90,.34);
      }

      .btn-outline{
        background: rgba(255,255,255,.10);
        color:#fff;
        border: 1px solid rgba(255,255,255,.18);
      }
      .btn-outline:hover{
        background: rgba(255,255,255,.14);
        transform: translateY(-1px);
      }

      .badge{
        display:inline-flex;
        gap:.5rem;
        align-items:center;
        padding:.35rem .65rem;
        border-radius: 9999px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
        font-size: .72rem;
        color: #0a1a15;
        background: rgba(255,193,7,.92);
        border: 1px solid rgba(255,255,255,.35);
      }

      .card{
        background: var(--card);
        border-radius: var(--radius);
        box-shadow: var(--shadow2);
        border: 1px solid rgba(7,17,14,.06);
      }
      .card-dark{
        background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
        border: 1px solid rgba(255,255,255,.10);
        box-shadow: 0 12px 30px rgba(0,0,0,.22);
        border-radius: var(--radius);
      }

      .soft-divider{
        height:1px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,.14), transparent);
      }

      /* Dropdown (click-friendly via focus-within + hover) */
      .dropdown-menu { display:none; }
      .dropdown:hover .dropdown-menu,
      .dropdown:focus-within .dropdown-menu,
      .dropdown-menu:hover { display:block; }

      /* Scroll animation */
      @keyframes breatheZoom {
        0% { transform: scale(0.98); opacity:.01; }
        100% { transform: scale(1); opacity:1; }
      }
      .animate-breathe {
        animation: breatheZoom 0.7s ease-out both;
        will-change: transform;
      }
    </style>
