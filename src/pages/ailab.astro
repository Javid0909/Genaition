  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --black: #050505; --off-black: #0d0d0d; --card: #111111; --card2: #161616;
      --border: rgba(255,255,255,0.07); --border-strong: rgba(255,255,255,0.12);
      --green: #76b82a; --green-dim: rgba(118,184,42,0.12); --green-glow: rgba(118,184,42,0.3);
      --white: #ffffff; --muted: rgba(255,255,255,0.45); --muted2: rgba(255,255,255,0.65);
      --header: 68px; --r: 2px;
    }
    html { scroll-behavior: smooth; }
    body { background: var(--black); color: var(--white); font-family: 'DM Sans', sans-serif; font-size: 16px; line-height: 1.6; overflow-x: hidden; }
    section, [id] { scroll-margin-top: calc(var(--header) + 12px); }

    /* HEADER */
    header { position: fixed; top: 0; left: 0; right: 0; height: var(--header); background: rgba(5,5,5,0.95); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border); z-index: 100; display: flex; align-items: center; }
    .hdr-inner { max-width: 1400px; margin: 0 auto; padding: 0 2.5rem; width: 100%; display: flex; align-items: center; justify-content: space-between; }
    .logo { display: flex; align-items: center; gap: 1rem; text-decoration: none; }
    .logo-mark { width: 38px; height: 38px; border-radius: var(--r); border: 1px solid rgba(17,20,13,0.5); display: flex; align-items: center; justify-content: center; overflow: hidden; background: #0a0a0a; }
    .logo-mark img { width: 100%; height: 100%; object-fit: cover; }
    .logo-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.35rem; letter-spacing: 0.12em; color: var(--white); line-height: 1; }
    .logo-sub { font-family: 'DM Mono', monospace; font-size: 0.55rem; text-transform: uppercase; letter-spacing: 0.25em; color: var(--green); display: block; margin-top: 2px; }
    .nav-links { display: flex; align-items: center; gap: 2.5rem; }
    .nav-links a { font-family: 'DM Mono', monospace; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--muted); text-decoration: none; transition: color 0.2s; }
    .nav-links a:hover { color: var(--white); }
    .nav-apply { background: var(--green); color: #000; font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; padding: 0.55rem 1.4rem; border-radius: var(--r); text-decoration: none; transition: all 0.2s; }
    .nav-apply:hover { background: #8fd433; transform: translateY(-1px); }
    @media (max-width: 640px) { .hdr-inner { padding: 0 1.25rem; } .nav-links { display: none; } .nav-apply { display: none; } }

    /* HERO */
    .hero { min-height: 88vh; padding-top: var(--header); display: flex; align-items: stretch; background: var(--black); }
    .hero-inner { max-width: 1400px; margin: 0 auto; width: 100%; display: grid; grid-template-columns: 55% 45%; align-items: center; }
    @media (max-width: 900px) { .hero { min-height: auto; } .hero-inner { grid-template-columns: 1fr; } }
    .hero-left { display: flex; flex-direction: column; justify-content: center; padding: 3.5rem 3rem 3rem 2.5rem; position: relative; z-index: 2; }
    .hero-left::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(118,184,42,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(118,184,42,0.03) 1px, transparent 1px); background-size: 48px 48px; pointer-events: none; }
    .hero-left > * { position: relative; z-index: 1; }
    @media (max-width: 640px) { .hero-left { padding: 2rem 1.5rem 2.5rem; } }
    .hero-eyebrow { display: flex; align-items: center; gap: 0.6rem; font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--green); margin-bottom: 1rem; flex-wrap: wrap; }
    .hero-eyebrow::before { content: ''; display: inline-block; width: 28px; height: 1px; background: var(--green); }

    /* PERSONA TAGnew */
    .hero-persona { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
    .persona-tag { font-family: 'DM Mono', monospace; font-size: 0.58rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--border-strong); padding: 0.25rem 0.65rem; border-radius: 2px; }
    .persona-tag.active { color: var(--green); border-color: rgba(118,184,42,0.35); background: var(--green-dim); }

    .hero-eyebrow { display: flex; align-items: center; gap: 0.65rem; flex-wrap: wrap; margin-bottom: 1.2rem; }
    .open-tag { display: inline-flex; align-items: center; gap: 0.35rem; font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.14em; text-transform: uppercase; padding: 0.22rem 0.6rem; border-radius: 2px; background: rgba(118,184,42,0.12); color: var(--green); border: 1px solid rgba(118,184,42,0.35); }
    .open-dot { width: 6px; height: 6px; background: var(--green); border-radius: 50%; animation: pulse 2s ease infinite; display: inline-block; }
    .hero-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3.2rem, 5.5vw, 6rem); line-height: 1.0; letter-spacing: 0.02em; }
    .hero-title .t-white { color: var(--white); display: block; }
    .hero-title .t-green { color: var(--green); display: block; }
    .hero-divider { width: 40px; height: 1px; background: linear-gradient(90deg, var(--green), transparent); margin: 1.5rem 0; }
    .hero-desc { font-size: 1rem; color: var(--muted2); line-height: 1.75; max-width: 480px; font-weight: 300; }
    @media (max-width: 640px) { .hero-desc { max-width: 100%; font-size: 0.95rem; } .hero-title { font-size: clamp(3rem, 14vw, 4.5rem); } }

    /* SEAT COUNTERnew */
    .seat-counter { display: inline-flex; align-items: center; gap: 0.75rem; margin-top: 1.2rem; padding: 0.6rem 1.1rem; background: rgba(255,100,50,0.08); border: 1px solid rgba(255,100,50,0.25); border-radius: var(--r); width: fit-content; }
    @media (max-width: 900px) { .seat-counter { margin-left: auto; margin-right: auto; display: flex; } }
    .seat-counter-dot { width: 7px; height: 7px; background: #ff6432; border-radius: 50%; animation: pulse 1.8s ease infinite; flex-shrink: 0; }
    .seat-counter-text { font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,140,80,0.9); }
    .seat-counter-text strong { color: #ff8050; }

    .hero-meta { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 1.5rem; border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; max-width: 580px; }
    @media (max-width: 640px) { .hero-meta { grid-template-columns: 1fr 1fr; max-width: 100%; } }
    .meta-block { padding: 0.85rem 1rem; border-right: 1px solid var(--border); }
    .meta-block:last-child { border-right: none; }
    @media (max-width: 640px) { .meta-block { border-bottom: 1px solid var(--border); } .meta-block:nth-child(2n) { border-right: none; } .meta-block:nth-last-child(-n+2) { border-bottom: none; } .meta-block:last-child { border-bottom: none; border-right: none; } }
    .meta-label { font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.25rem; }
    .meta-value { font-family: 'Bebas Neue', sans-serif; font-size: 1.15rem; letter-spacing: 0.06em; color: var(--white); line-height: 1; white-space: nowrap; }
    .meta-sub { font-family: 'DM Mono', monospace; font-size: 0.52rem; letter-spacing: 0.1em; color: rgba(255,255,255,0.45); margin-top: 0.2rem; }
    .meta-value.green { color: var(--green); }
    .hero-actions { margin-top: 1.5rem; display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
    @media (max-width: 640px) { .hero-actions { flex-direction: column; align-items: flex-start; gap: 1rem; } .hero-cta { width: 100%; justify-content: center; } }
    .hero-cta { display: inline-flex; align-items: center; gap: 0.7rem; background: var(--green); color: #000; font-weight: 700; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.14em; padding: 0.95rem 2.2rem; border-radius: var(--r); text-decoration: none; transition: all 0.25s; }
    .hero-cta:hover { background: #8fd433; transform: translateY(-2px); box-shadow: 0 12px 40px var(--green-glow); }
    .hero-cta svg { width: 13px; height: 13px; }
    .hero-link { font-family: 'DM Mono', monospace; font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--border); padding-bottom: 1px; transition: color 0.2s, border-color 0.2s; }
    .hero-link:hover { color: var(--white); border-color: var(--white); }

    /* HERO RIGHT */
    .hero-right { position: relative; display: flex; align-items: center; justify-content: center; padding: 4rem 2.5rem 4rem 1.5rem; }
    @media (max-width: 900px) { .hero-right { padding: 2rem 1.5rem; } }
    .photo-card-wrap { position: relative; width: 90%; max-width: 480px; }
    @media (max-width: 1100px) { .photo-card-wrap { max-width: 380px; } }
    @media (max-width: 900px) { .photo-card-wrap { width: 85%; max-width: 360px; margin: 0 auto; } }
    .photo-card-inner { position: relative; overflow: hidden; }
    .photo-card-inner img { display: block; width: 100%; aspect-ratio: 3/4; object-fit: cover; object-position: center 10%; filter: brightness(0.78) saturate(0.9); }
    .photo-grid-overlay { position: absolute; inset: 0; z-index: 1; background-image: linear-gradient(rgba(118,184,42,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(118,184,42,0.05) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none; }
    .instructor-plate { position: absolute; bottom: 0; left: 0; right: 0; z-index: 5; padding: 1.5rem 1.4rem; background: linear-gradient(transparent, rgba(5,5,5,0.95) 40%); }
    .instructor-name { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; letter-spacing: 0.05em; line-height: 1; }
    @media (max-width: 900px) { .instructor-name { font-size: 1.4rem; } }
    .instructor-role { font-family: 'DM Mono', monospace; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--green); margin-top: 0.35rem; }
    .instructor-li { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.75rem; padding: 0.3rem 0.75rem; background: rgba(10,102,194,0.15); border: 1px solid rgba(10,102,194,0.4); border-radius: var(--r); font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.15em; text-transform: uppercase; color: #6eaad8; text-decoration: none; transition: background 0.2s, border-color 0.2s; }
    .instructor-li:hover { background: rgba(10,102,194,0.3); border-color: rgba(10,102,194,0.7); color: #fff; }
    .instructor-li svg { width: 11px; height: 11px; fill: currentColor; flex-shrink: 0; }
    .stat-badge { position: absolute; z-index: 6; background: rgba(5,5,5,0.88); backdrop-filter: blur(16px); border: 1px solid var(--border-strong); padding: 0.75rem 1rem; border-radius: var(--r); }
    .stat-badge.tl { top: 1rem; left: -1rem; }
    .stat-badge.br { bottom: 7rem; right: -1rem; }
    .sb-num { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; color: var(--green); line-height: 1; }
    .sb-label { font-family: 'DM Mono', monospace; font-size: 0.52rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--muted); margin-top: 0.1rem; }
    @media (max-width: 900px) { .stat-badge { padding: 0.45rem 0.7rem; } .stat-badge.tl { top: 0.75rem; left: 0.75rem; } .stat-badge.br { bottom: 6rem; right: 0.75rem; top: auto; } .sb-num { font-size: 1.2rem; } .sb-label { font-size: 0.46rem; } }

    /* VIDEO HEROimmediately after hero */
    .video-hero { position: relative; overflow: hidden; height: 420px; display: flex; align-items: center; justify-content: center; }
    @media (max-width: 640px) { .video-hero { height: 300px; } }
    .video-hero video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
    .video-hero-overlay { position: absolute; inset: 0; z-index: 1; background: rgba(5,5,5,0.52); }
    .video-hero-grid { position: absolute; inset: 0; z-index: 2; background-image: linear-gradient(rgba(118,184,42,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(118,184,42,0.07) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none; }
    .video-hero-scanlines { position: absolute; inset: 0; z-index: 3; background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.07) 2px, rgba(0,0,0,0.07) 4px); pointer-events: none; }
    .video-hero-vignette { position: absolute; inset: 0; z-index: 4; background: radial-gradient(ellipse at center, transparent 35%, rgba(5,5,5,0.75) 100%); pointer-events: none; }
    .video-hero-content { position: relative; z-index: 5; text-align: center; padding: 0 2rem; }
    .vh-tag { display: inline-flex; align-items: center; gap: 0.5rem; font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--green); border: 1px solid rgba(118,184,42,0.3); padding: 0.3rem 0.85rem; border-radius: var(--r); margin-bottom: 1.4rem; }
    .vh-tag::before { content: ''; display: inline-block; width: 6px; height: 6px; background: var(--green); border-radius: 50%; animation: pulse 2s ease infinite; }
    .vh-headline { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2.2rem, 5vw, 4.2rem); letter-spacing: 0.03em; line-height: 1.05; color: var(--white); }
    .vh-headline .accent { color: var(--green); }
    .vh-sub { margin-top: 1rem; font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }

    /* PRINCIPLE */
    .principle { background: var(--green); padding: 2rem 0; overflow: hidden; }
    .principle-inner { max-width: 1400px; margin: 0 auto; padding: 0 2.5rem; display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; }
    .principle-tag { font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(0,0,0,0.45); white-space: nowrap; border: 1px solid rgba(0,0,0,0.2); padding: 0.25rem 0.6rem; border-radius: var(--r); }
    .principle-text { font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.6rem, 3.5vw, 2.8rem); color: #000; letter-spacing: 0.04em; }

    /* SECTIONS */
    .section { padding: 7rem 0; }
    @media (max-width: 640px) { .section { padding: 3.5rem 0; } }
    .section-alt { background: var(--off-black); }
    .container { max-width: 1400px; margin: 0 auto; padding: 0 2.5rem; }
    @media (max-width: 640px) { .container { padding: 0 1.25rem; } }
    .sec-label { font-family: 'DM Mono', monospace; font-size: 0.68rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--green); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.6rem; }
    .sec-label::before { content: ''; display: inline-block; width: 20px; height: 1px; background: var(--green); }
    .sec-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(2.8rem, 5vw, 4.5rem); line-height: 0.95; letter-spacing: 0.01em; }
    .sec-desc { margin-top: 1.2rem; color: var(--muted2); font-size: 1rem; line-height: 1.8; max-width: 560px; font-weight: 300; }
    .build-intro { margin-top: 1.5rem; display: inline-flex; align-items: center; gap: 0.75rem; padding: 0.6rem 1.2rem; background: var(--green-dim); border: 1px solid rgba(118,184,42,0.22); border-radius: var(--r); font-family: 'DM Mono', monospace; font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--green); }

    /* BUILD GRID */
    .build-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); margin-top: 2rem; border-radius: var(--r); overflow: hidden; }
    @media (max-width: 700px) { .build-grid { grid-template-columns: 1fr; } }
    .build-cell { background: var(--card); padding: 2.5rem; transition: background 0.2s; }
    @media (max-width: 640px) { .build-cell { padding: 1.5rem; } }
    .build-cell:hover { background: var(--card2); }
    .build-cell.orchestrator { grid-column: 1/-1; border-bottom: 1px solid var(--border-strong); background: #0d0d0d; }
    .orchestrator-inner { display: flex; gap: 3rem; align-items: flex-start; flex-wrap: wrap; }
    @media (max-width: 640px) { .orchestrator-inner { gap: 0; flex-direction: column; } }
    .cell-badge { display: inline-block; font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--green); border: 1px solid rgba(118,184,42,0.3); padding: 0.2rem 0.55rem; border-radius: 2px; margin-bottom: 0.8rem; }
    .cell-letter { font-family: 'Bebas Neue', sans-serif; font-size: 4rem; color: var(--green); line-height: 1; opacity: 0.3; margin-bottom: 0.4rem; }
    .cell-title { font-weight: 600; font-size: 0.95rem; margin-bottom: 1.2rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--white); }
    .cell-list { list-style: none; }
    .cell-list li { display: flex; gap: 0.75rem; color: var(--muted); font-size: 0.88rem; line-height: 1.6; padding: 0.45rem 0; border-bottom: 1px solid rgba(255,255,255,0.04); word-break: break-word; min-width: 0; }
    .cell-list li:last-child { border-bottom: none; }
    .cell-list li::before { content: '→'; color: var(--green); flex-shrink: 0; font-size: 0.75rem; margin-top: 3px; }

    /* TECH STACK */
    .stack-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; margin-top: 2rem; }
    .stack-card.optional { opacity: 0.72; border-top: 1px dashed rgba(255,255,255,0.1); }
    .stack-card.optional:hover { opacity: 1; }
    .stack-optional-badge { display: inline-block; font-family: 'DM Mono', monospace; font-size: 0.5rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); border: 1px dashed var(--border-strong); padding: 0.15rem 0.5rem; border-radius: 2px; margin-bottom: 0.75rem; }
    @media (max-width: 900px) { .stack-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) { .stack-grid { grid-template-columns: 1fr; } }
    .stack-card { background: var(--card); padding: 2rem 1.75rem; display: flex; flex-direction: column; transition: background 0.2s; position: relative; overflow: hidden; }
    @media (max-width: 640px) { .stack-card { padding: 1.25rem; } }
    .stack-card:hover { background: var(--card2); }
    .stack-card::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--green); opacity: 0; transition: opacity 0.2s; }
    .stack-card:hover::after { opacity: 1; }
    .stack-icon { width: 40px; height: 40px; border-radius: 6px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; flex-shrink: 0; }
    .stack-icon.n8n  { background: rgba(255,140,0,0.1); }
    .stack-icon.claude { background: rgba(118,184,42,0.1); }
    .stack-icon.supabase { background: rgba(62,207,142,0.08); }
    .stack-icon.openclaw { background: rgba(255,80,50,0.08); }
    .stack-role { font-family: 'DM Mono', monospace; font-size: 0.52rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--green); margin-bottom: 0.75rem; border: 1px solid rgba(118,184,42,0.25); padding: 0.18rem 0.5rem; border-radius: 2px; display: inline-block; width: fit-content; }
    .stack-name { font-weight: 600; font-size: 0.95rem; color: var(--white); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.85rem; }
    .stack-detail { font-family: 'DM Mono', monospace; font-size: 0.63rem; color: var(--muted); line-height: 1.65; }
    /* Stack why-linenew */
    .stack-why { margin-top: 0.85rem; padding-top: 0.85rem; border-top: 1px solid var(--border); font-family: 'DM Mono', monospace; font-size: 0.58rem; color: rgba(118,184,42,0.65); line-height: 1.6; letter-spacing: 0.02em; }
    .stack-why strong { color: var(--green); font-weight: 500; }
    .stack-deploy { display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 2rem; padding: 0.5rem 1.1rem; background: var(--green-dim); border: 1px solid rgba(118,184,42,0.22); border-radius: var(--r); font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--green); }
    .stack-deploy-dot { width: 6px; height: 6px; background: var(--green); border-radius: 50%; animation: pulse 2s ease infinite; flex-shrink: 0; }
    .stack-header { grid-column: 1 / -1; background: #0d0d0d; border-bottom: 1px solid var(--border-strong); padding: 1.75rem 2rem; }
    @media (max-width: 640px) { .stack-header { padding: 1.25rem; } }
    .stack-header-inner { display: flex; gap: 2.5rem; align-items: center; flex-wrap: wrap; }
    @media (max-width: 640px) { .stack-header-inner { gap: 1rem; } }
    .stack-header-right { flex: 1; min-width: 0; }
    .stack-header .stack-why { margin-top: 0.5rem; padding-top: 0; border-top: none; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }

    /* GALLERY */
    .gallery-section { padding: 6rem 0; background: var(--black); border-top: 1px solid var(--border); }
    .gallery-inner { max-width: 1400px; margin: 0 auto; padding: 0 2.5rem; }
    @media (max-width: 640px) { .gallery-inner { padding: 0 1.25rem; } }
    .gallery-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem; }
    .gallery-count { font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
    .gallery-grid { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; gap: 0.75rem; }
    @media (max-width: 700px) { .gallery-grid { display: flex; overflow-x: auto; gap: 0.65rem; padding-bottom: 1rem; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; } .gallery-grid::-webkit-scrollbar { display: none; } }
    .gallery-slot-a { grid-row: 1 / 3; position: relative; overflow: hidden; }
    .gallery-slot-a img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; filter: brightness(0.72) contrast(1.05) saturate(0.75) sepia(0.12); transition: transform 0.6s ease, filter 0.4s ease; }
    .gallery-slot-a:hover img { transform: scale(1.03); filter: brightness(0.80) contrast(1.03) saturate(0.85) sepia(0.08); }
    .gallery-img-label { position: absolute; bottom: 0; left: 0; right: 0; padding: 1.25rem 1.25rem 1rem; background: linear-gradient(transparent, rgba(5,5,5,0.8) 70%); font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.5); pointer-events: none; }
    .gallery-slot-a::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--green); z-index: 2; }
    .gallery-slot-b { position: relative; overflow: hidden; aspect-ratio: 16/9; }
    .gallery-slot-b img { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(0.72) contrast(1.05) saturate(0.75) sepia(0.12); transition: transform 0.6s ease, filter 0.4s ease; }
    .gallery-slot-b:hover img { transform: scale(1.03); filter: brightness(0.80) contrast(1.03) saturate(0.85) sepia(0.08); }
    .gallery-slot-c { position: relative; overflow: hidden; aspect-ratio: 16/9; }
    .gallery-slot-c img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; filter: brightness(0.72) contrast(1.05) saturate(0.75) sepia(0.12); transition: transform 0.6s ease, filter 0.4s ease; }
    .gallery-slot-c:hover img { transform: scale(1.03); filter: brightness(0.80) contrast(1.03) saturate(0.85) sepia(0.08); }
    @media (max-width: 700px) { .gallery-slot-a, .gallery-slot-b, .gallery-slot-c { flex: 0 0 72vw; max-width: 72vw; aspect-ratio: 4/3; scroll-snap-align: start; grid-row: auto; } .gallery-slot-a::before { display: none; } .gallery-slot-a img, .gallery-slot-b img, .gallery-slot-c img { height: 100%; } }
    .gallery-scroll-hint { display: none; margin-top: 0.85rem; font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); text-align: center; }
    @media (max-width: 700px) { .gallery-scroll-hint { display: block; } }

    /* SCENARIO */
    .scenario-section-bg { background: #050505; padding: 0; position: relative; overflow: hidden; }
    .scenario-section-bg-top-bar { height: 3px; background: linear-gradient(90deg, transparent 0%, var(--green) 20%, var(--green) 80%, transparent 100%); width: 100%; }
    .scenario-section-bg-bottom-bar { height: 3px; background: linear-gradient(90deg, transparent 0%, rgba(118,184,42,0.4) 20%, rgba(118,184,42,0.4) 80%, transparent 100%); width: 100%; }
    .scenario-section-bg::before { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 900px; height: 600px; background: radial-gradient(ellipse at center, rgba(118,184,42,0.09) 0%, rgba(118,184,42,0.04) 40%, transparent 70%); z-index: 0; pointer-events: none; }
    .scenario-section-bg::after { content: ''; position: absolute; inset: 0; z-index: 1; background-image: linear-gradient(rgba(118,184,42,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(118,184,42,0.05) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none; }
    .scenario-section-bg .container { position: relative; z-index: 3; padding-top: 5rem; padding-bottom: 5rem; }
    .scenario-wrap { margin-top: 2.5rem; background: #2a2a2a; border: 1px solid rgba(118,184,42,0.22); border-radius: 4px; padding: 3rem; position: relative; overflow: hidden; box-shadow: 0 0 60px rgba(118,184,42,0.06), 0 24px 80px rgba(0,0,0,0.9); }
    @media (max-width: 640px) { .scenario-wrap { padding: 1.5rem; } }
    .scenario-title { font-family: 'Bebas Neue', sans-serif; font-size: 1.8rem; color: var(--white); margin-bottom: 1.5rem; }
    .email-bubble { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--r); padding: 1.5rem; font-size: 0.9rem; color: var(--muted2); line-height: 1.75; font-family: 'DM Mono', monospace; margin-bottom: 2rem; }
    .email-bubble .from { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.18em; color: var(--green); margin-bottom: 0.75rem; opacity: 0.8; }
    .signal-row { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 2rem; }
    .signal { padding: 0.3rem 0.85rem; border-radius: 2px; font-family: 'DM Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; }
    .signal.interest { background: rgba(118,184,42,0.15); color: var(--green); border: 1px solid rgba(118,184,42,0.3); }
    .signal.objection { background: rgba(255,165,0,0.1); color: #ffa500; border: 1px solid rgba(255,165,0,0.25); }
    .signal.timing { background: rgba(100,149,237,0.1); color: #6495ed; border: 1px solid rgba(100,149,237,0.25); }
    .signal-sub { font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.6rem; }
    .decision-flow { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    @media (max-width: 640px) { .decision-flow { grid-template-columns: 1fr; } }
    .df-card { background: #111; border: 1px solid rgba(255,255,255,0.08); border-radius: var(--r); padding: 1.25rem; transition: border-color 0.2s; }
    .df-card:hover { border-color: rgba(118,184,42,0.3); }
    .df-label { font-family: 'DM Mono', monospace; font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--green); opacity: 0.7; margin-bottom: 0.6rem; }
    .df-val { font-size: 0.875rem; color: var(--muted2); line-height: 1.55; }
    .df-action { display: inline-block; margin-top: 0.8rem; font-family: 'DM Mono', monospace; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.15em; padding: 0.22rem 0.6rem; border-radius: 2px; }
    .df-action.send { background: rgba(118,184,42,0.15); color: var(--green); border: 1px solid rgba(118,184,42,0.25); }
    .df-action.review { background: rgba(255,193,7,0.1); color: #ffc107; border: 1px solid rgba(255,193,7,0.2); }
    .df-action.track { background: rgba(255,255,255,0.05); color: var(--muted); border: 1px solid rgba(255,255,255,0.08); }

    /* FOR */
    .for-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; margin-top: 4rem; align-items: start; }
    @media (max-width: 700px) { .for-grid { grid-template-columns: 1fr; gap: 2rem; } }
    .for-list { list-style: none; margin-top: 2rem; }
    .for-list li { display: flex; gap: 1rem; align-items: flex-start; padding: 1rem 0; border-bottom: 1px solid var(--border); color: var(--muted); font-size: 0.92rem; line-height: 1.55; }
    .for-list li:last-child { border-bottom: none; }
    .for-list li .icon { color: var(--green); flex-shrink: 0; font-size: 0.85rem; margin-top: 2px; }
    #for { position: relative; overflow: hidden; }
    #for .for-bg-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; filter: brightness(0.88) contrast(1.02) saturate(0.78) sepia(0.10); z-index: 0; }
    #for .for-bg-desktop { display: block; }
    #for .for-bg-mobile  { display: none; }
    @media (max-width: 700px) { #for .for-bg-desktop { display: none; } #for .for-bg-mobile { display: block; object-position: center center; } }
    #for::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(5,5,5,0.82) 0%, rgba(5,5,5,0.68) 50%, rgba(5,5,5,0.52) 100%); z-index: 1; }
    #for::after { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(118,184,42,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(118,184,42,0.03) 1px, transparent 1px); background-size: 40px 40px; z-index: 2; pointer-events: none; }
    #for .container { position: relative; z-index: 3; }
    .for-visual { background: rgba(17,17,17,0.7); border: 1px solid var(--border-strong); border-radius: var(--r); padding: 2.5rem; position: relative; overflow: hidden; backdrop-filter: blur(8px); }
    .for-visual::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(118,184,42,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(118,184,42,0.035) 1px, transparent 1px); background-size: 32px 32px; }
    .for-visual-inner { position: relative; z-index: 1; }
    .for-quote { font-family: 'Bebas Neue', sans-serif; font-size: 2.4rem; line-height: 1.05; color: var(--white); margin-bottom: 2rem; }
    .for-quote span { color: var(--green); }
    .for-prereq { margin-top: 2rem; padding: 1.2rem 1.5rem; background: rgba(118,184,42,0.06); border: 1px solid rgba(118,184,42,0.18); border-radius: var(--r); font-size: 0.875rem; color: var(--muted2); line-height: 1.7; }
    .for-prereq strong { color: var(--green); display: block; margin-bottom: 0.3rem; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.18em; font-family: 'DM Mono', monospace; }

    /* TIMELINE */
    .timeline { margin-top: 4.5rem; position: relative; }
    .timeline::before { content: ''; position: absolute; left: 1.75rem; top: 0; bottom: 0; width: 1px; background: linear-gradient(to bottom, var(--green), transparent); }
    .week-row { display: flex; gap: 2.5rem; padding: 0 0 3.5rem 0; position: relative; }
    .week-row:last-child { padding-bottom: 0; }
    .week-dot { flex-shrink: 0; width: 3.5rem; height: 3.5rem; border-radius: 50%; background: var(--card); border: 1px solid var(--border-strong); display: flex; align-items: center; justify-content: center; font-family: 'Bebas Neue', sans-serif; font-size: 1rem; color: var(--green); position: relative; z-index: 1; transition: all 0.25s; }
    .week-row:hover .week-dot { background: var(--green); color: #000; border-color: var(--green); box-shadow: 0 0 25px var(--green-glow); }
    .week-content { flex: 1; padding-top: 0.5rem; }
    .week-num { font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--green); margin-bottom: 0.35rem; }
    .week-title { font-family: 'Bebas Neue', sans-serif; font-size: 1.9rem; letter-spacing: 0.02em; color: var(--white); margin-bottom: 0.6rem; line-height: 1; }
    .week-desc { color: var(--muted); font-size: 0.92rem; line-height: 1.7; }
    .week-deliverable { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1rem; padding: 0.35rem 0.85rem; background: var(--green-dim); border: 1px solid rgba(118,184,42,0.22); border-radius: var(--r); font-family: 'DM Mono', monospace; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--green); }

    /* TRUSTPILOTquotes only, no aggregate score */
    .trustpilot-section { padding: 5rem 0; background: var(--off-black); border-top: 1px solid var(--border); }
    .tp-header { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; margin-bottom: 3rem; }
    .tp-link { font-family: 'DM Mono', monospace; font-size: 0.62rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--green); text-decoration: none; border-bottom: 1px solid var(--border); padding-bottom: 1px; transition: color 0.2s, border-color 0.2s; }
    .tp-link:hover { color: #00b67a; border-color: #00b67a; }
    .tp-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--r); overflow: hidden; }
    @media (max-width: 800px) { .tp-cards { grid-template-columns: 1fr; } }
    .tp-card { background: var(--card); padding: 2rem; display: flex; flex-direction: column; gap: 1rem; transition: background 0.2s; }
    .tp-card:hover { background: var(--card2); }
    .tp-card-stars { display: flex; gap: 3px; }
    .tp-card-star { width: 16px; height: 16px; background: #00b67a; flex-shrink: 0; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
    .tp-card-text { font-size: 0.9rem; color: var(--muted2); line-height: 1.75; font-style: italic; flex: 1; }
    .tp-card-text::before { content: '"'; }
    .tp-card-text::after { content: '"'; }
    .tp-card-meta { display: flex; flex-direction: column; gap: 0.15rem; }
    .tp-card-name { font-family: 'DM Sans', sans-serif; font-size: 0.82rem; font-weight: 600; color: var(--white); }
    .tp-card-role { font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--green); }
    .tp-card-date { font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); }
    .tp-avg-block { display: flex; align-items: center; gap: 1rem; margin-top: 0.5rem; }
    .tp-avg-score { font-family: 'DM Sans', sans-serif; font-size: clamp(2rem,4vw,3rem); font-weight: 800; color: var(--white); line-height: 1; }
    .tp-avg-stars { display: flex; gap: 3px; margin-bottom: 0.25rem; }
    .tp-avg-star { width: 20px; height: 20px; background: #00b67a; flex-shrink: 0; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
    .tp-avg-star-half { width: 10px; height: 20px; overflow: hidden; flex-shrink: 0; }
    .tp-avg-star-half span { display: block; width: 20px; height: 20px; background: #00b67a; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
    .tp-avg-label { font-family: 'DM Mono', monospace; font-size: 0.55rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--muted); }

    /* APPLY */
    .apply-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; margin-bottom: 6rem; }
    @media (max-width: 900px) { .apply-wrap { grid-template-columns: 1fr; gap: 2.5rem; } }
    .apply-pricing-center { display: flex; justify-content: center; }
    .apply-box { max-width: 440px; width: 100%; }
    .apply-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(3rem, 6vw, 5.5rem); line-height: 0.92; margin-bottom: 1.5rem; }
    .apply-desc { color: var(--muted2); font-size: 1rem; line-height: 1.8; font-weight: 300; }
    .apply-pills { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.5rem; }
    .pill { padding: 0.35rem 0.9rem; border: 1px solid var(--border-strong); border-radius: 2px; font-family: 'DM Mono', monospace; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
    .apply-box { background: var(--card); border: 1px solid var(--border-strong); border-radius: var(--r); padding: 2.5rem; text-align: center; position: relative; overflow: hidden; }
    .apply-box::before { content: ''; position: absolute; top: 0; left: 0; width: 80px; height: 80px; background: radial-gradient(circle at top left, rgba(118,184,42,0.2), transparent 70%); }
    .ticket-status { display: inline-flex; align-items: center; gap: 0.5rem; font-family: 'DM Mono', monospace; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.16em; padding: 0.3rem 0.8rem; border-radius: 2px; background: rgba(118,184,42,0.1); color: var(--green); border: 1px solid rgba(118,184,42,0.28); margin-bottom: 1rem; }
    .ticket-status-dot { width: 6px; height: 6px; background: var(--green); border-radius: 50%; animation: pulse 2s ease infinite; flex-shrink: 0; }
    .apply-orig-price { font-family: 'DM Mono', monospace; font-size: 0.9rem; color: rgba(255,255,255,0.28); text-decoration: line-through; margin-bottom: 0.2rem; }
    .apply-box-title { font-family: 'Bebas Neue', sans-serif; font-size: 3rem; font-weight: 400; letter-spacing: 0.02em; color: var(--white); line-height: 1; margin-bottom: 0.5rem; }
    .apply-save-badge { display: inline-block; font-family: 'DM Mono', monospace; font-size: 0.56rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--green); background: var(--green-dim); border: 1px solid rgba(118,184,42,0.38); padding: 0.18rem 0.5rem; border-radius: 2px; white-space: nowrap; }
    .apply-deadline { font-family: 'DM Mono', monospace; font-size: 0.52rem; text-transform: uppercase; letter-spacing: 0.13em; color: rgba(255,60,60,0.85); margin-top: 0.4rem; margin-bottom: 0; }
    .apply-price-divider { height: 1px; background: rgba(255,255,255,0.08); margin: 1.2rem 0; }
    .apply-includes-list { list-style: none; margin-bottom: 1.25rem; display: flex; flex-direction: column; gap: 0; text-align: left; }
    .apply-includes-list li { display: flex; gap: 0.75rem; font-size: 0.84rem; color: rgba(255,255,255,0.58); padding: 0.42rem 0; border-bottom: 1px solid rgba(255,255,255,0.06); transition: color 0.2s; }
    .apply-includes-list li:hover { color: rgba(255,255,255,0.85); }
    .apply-includes-list li:last-child { border-bottom: none; }
    .apply-includes-list li::before { content: '—'; color: var(--green); flex-shrink: 0; font-size: 0.75rem; margin-top: 2px; }
    .apply-btn { display: block; width: 100%; background: var(--green); color: #000; font-weight: 700; font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.14em; padding: 1.1rem 2rem; border-radius: var(--r); text-decoration: none; transition: all 0.22s; }
    .apply-btn:hover { background: #8fd433; box-shadow: 0 8px 32px var(--green-glow); }
    .apply-note { margin-top: 0.8rem; font-family: 'DM Mono', monospace; font-size: 0.54rem; text-transform: uppercase; letter-spacing: 0.14em; color: rgba(255,255,255,0.25); text-align: center; }
    .apply-note a { color: rgba(255,255,255,0.32); text-decoration: underline; }

    /* INSTRUCTOR */
    .instructor-inner { max-width: 820px; margin: 0 auto; }
    .instructor-grid { display: grid; grid-template-columns: 220px minmax(0, 520px); gap: 3rem; align-items: start; margin-top: 2.5rem; }
    @media (max-width: 640px) { .instructor-grid { grid-template-columns: 1fr; gap: 1.75rem; } }
    .instructor-card { border-radius: 10px; overflow: hidden; background: #fff; box-shadow: 0 4px 28px rgba(0,0,0,0.09); border: 1px solid #e8e4dc; transition: transform 0.3s, box-shadow 0.3s; }
    .instructor-card:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(118,184,42,0.18); }
    .instructor-card img { display: block; width: 100%; aspect-ratio: 3/4; object-fit: cover; object-position: center top; transition: transform 0.5s ease; }
    .instructor-card:hover img { transform: scale(1.03); }
    .instructor-plate-light { padding: 1rem 1rem 1rem; background: var(--green); border-top: 1px solid rgba(0,0,0,0.12); }
    .instructor-name-dark { font-family: 'Bebas Neue', sans-serif; font-size: 1.5rem; font-weight: 400; letter-spacing: 0.08em; color: #000; line-height: 1.1; }
    .instructor-role-dark { font-family: 'DM Mono', monospace; font-size: 0.54rem; text-transform: uppercase; letter-spacing: 0.18em; color: rgba(0,0,0,0.6); margin-top: 0.2rem; }
    .instructor-badges-light { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 0.6rem; }
    .ibadge-light { padding: 0.2rem 0.65rem; border-radius: 20px; font-family: 'DM Mono', monospace; font-size: 0.52rem; letter-spacing: 0.12em; text-transform: uppercase; background: rgba(0,0,0,0.15); color: #000; border: 1px solid rgba(0,0,0,0.2); }
    .instructor-bio-dark { font-size: 0.95rem; color: #596070; line-height: 1.82; font-weight: 300; }
    .instructor-bio-dark + .instructor-bio-dark { margin-top: 0.85rem; }
    .instructor-pullquote-dark { margin-top: 1.5rem; border-left: 3px solid var(--green); padding-left: 1.1rem; font-family: 'DM Sans', sans-serif; font-weight: 300; font-size: 1rem; color: #2d3748; line-height: 1.7; }

