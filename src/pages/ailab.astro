<script>
  // Language dropdown
  const langWrap = document.getElementById('langWrap');
  const langBtn  = document.getElementById('langBtn');
  function closeLang() { langWrap && langWrap.classList.remove('open'); langBtn && langBtn.setAttribute('aria-expanded','false'); }
  function toggleLang() { const open = !langWrap.classList.contains('open'); langWrap.classList.toggle('open', open); langBtn.setAttribute('aria-expanded', open ? 'true' : 'false'); }
  if (langBtn) {
    langBtn.addEventListener('click', e => { e.stopPropagation(); toggleLang(); });
    document.addEventListener('click', closeLang);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLang(); });
  }

  // FAQ accordion
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement;
      const body = item.querySelector('.faq-body');
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => {
        i.classList.remove('open');
        i.querySelector('.faq-body').style.maxHeight = '0';
      });
      if (!isOpen) {
        item.classList.add('open');
        body.style.maxHeight = body.scrollHeight + 'px';
      }
    });
  });

  const backdrop   = document.getElementById('chatBackdrop');
  const triggerBtn = document.getElementById('chatTriggerBtn');
  const closeBtn   = document.getElementById('chatCloseBtn');

  function openChat() { backdrop.classList.add('open'); document.getElementById('chatInput').focus(); }
  function closeChat() { backdrop.classList.remove('open'); }

  triggerBtn.addEventListener('click', openChat);
  closeBtn.addEventListener('click', closeChat);
  backdrop.addEventListener('click', function(e) { if (e.target === backdrop) closeChat(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && backdrop.classList.contains('open')) closeChat(); });

  const OR_KEY = 'YOUR_OPENROUTER_KEY_HERE';
  const SYSTEM_PROMPT = `You are a friendly and knowledgeable assistant for Genaition's Applied AI Laba 4-week in-person cohort program in Stockholm (Park City Hotel) starting September 20, 2026.

Key facts:
- Price: 2,985 SEK (Cohort 1 pricinglowest it will ever be)
- Format: In-person, one session per week + optional office hours. 4–6 hours/week total.
- Location: Park City Hotel, Stockholm
- Cohort size: 12 participants max
- What participants build: A multi-agent AI email orchestration system using n8n (self-hosted via Docker), Claude Sonnet 4.6 by Anthropic, Airtable, and Gmail
- The system has 4 agents: Orchestrator, Inbound Reply Agent, Follow-Up Agent, Performance Agent
- No coding experience requiredjust bring your laptop
- Tools: n8n self-hosted via Docker (workflow orchestrator), Claude Sonnet 4.6 by Anthropic (AI reasoning and system-prompt layer), Airtable (state and Decision Log), Gmail via OAuth, Claude Code (for inspecting and debugging workflows)
- Post-program tool costs: n8n self-hosted ~5-15 EUR/month VPS, Claude API ~5-20 USD/month for typical usage, Airtable free tier covers most use cases. Total typically under 500 SEK/month.
- 24/7 Slack access, VIP in-person support, guiding materials included
- Teams of 2–3 can join together
- Instructor: Javid Valiyev, AI Lab Lead & Founder of Genaition
- 5 workshops run previously, 150+ attendees

Keep answers concise, warm, and direct. Max 3 sentences per reply. If you don't know something specific, suggest they reach out directly via email: info@genaition.org`;

  let messages = [];

  function getTime() { return new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }); }

  function appendMessage(role, text) {
    const wrap = document.getElementById('chatMessages');
    const div = document.createElement('div');
    div.className = `chat-msg ${role}`;
    div.innerHTML = `<div class="chat-bubble">${text.replace(/\n/g, '<br>')}</div><span class="chat-msg-time">${role === 'user' ? 'You' : 'Genaition AI'} · ${getTime()}</span>`;
    wrap.appendChild(div);
    wrap.scrollTop = wrap.scrollHeight;
  }

  function setTyping(visible) {
    const t = document.getElementById('chatTyping');
    const wrap = document.getElementById('chatMessages');
    t.className = visible ? 'chat-typing visible' : 'chat-typing';
    if (visible) wrap.scrollTop = wrap.scrollHeight;
  }

  async function sendMessage() {
    const input = document.getElementById('chatInput');
    const sendBtn = document.getElementById('chatSend');
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    sendBtn.disabled = true;
    appendMessage('user', text);
    messages.push({ role: 'user', content: text });
    setTyping(true);
    try {
      const res = await fetch('https://nariman09.app.n8n.cloud/webhook/7ad4ea2f-15d4-482f-9e13-467471007006', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, history: messages.slice(0, -1) })
      });
      const data = await res.json();
      const reply = data.output || data.reply || data.message || data.text || (Array.isArray(data) && (data[0]?.output || data[0]?.reply || data[0]?.message)) || 'Sorry, something went wrong. Please try again.';
      messages.push({ role: 'assistant', content: reply });
      setTyping(false);
      appendMessage('bot', reply);
    } catch (err) {
      setTyping(false);
      appendMessage('bot', 'Connection error. Please try again in a moment.');
    }
    sendBtn.disabled = false;
    input.focus();
  }

  document.getElementById('chatSend').addEventListener('click', sendMessage);
  document.getElementById('chatInput').addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
  });
</script>
</body>
