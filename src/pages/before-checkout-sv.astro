<script>
  // Language dropdown
  const langWrap = document.getElementById('langWrap');
  const langBtn  = document.getElementById('langBtn');
  function closeLang() { langWrap && langWrap.classList.remove('open'); langBtn && langBtn.setAttribute('aria-expanded','false'); }
  function toggleLang() { const open = !langWrap.classList.contains('open'); langWrap.classList.toggle('open', open); langBtn.setAttribute('aria-expanded', open ? 'true' : 'false'); }
  if (langBtn) {
    langBtn.addEventListener('click', e => { e.stopPropagation(); toggleLang(); });
    document.addEventListener('click', closeLang);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLang(); });
  }
</script>

<script>
  // ── CONFIG ──
  const PRICE_REGULAR = 595;
  const PRICE_EARLY   = 595;
  const PRICE_PROMO   = 495;
  const PROMO_CODES   = { "HYPERISLAND": PRICE_PROMO, "STING": PRICE_PROMO };

  let ticketQty    = 1;
  let activePromo  = null;
  let pricePerSeat = PRICE_EARLY;

  // ── STRIPE LINKS ──
  const normalLinks = {
    1: "https://buy.stripe.com/28E5kD70f1rD0cQ77r8AE0H",
    2: "https://buy.stripe.com/aFacN5esHeep3p2gI18AE0I",
    3: "https://buy.stripe.com/cNi28rbgvb2dgbO63n8AE0J",
    4: "https://buy.stripe.com/00w5kD2JZ9Y95xa2Rb8AE0K",
    5: "https://buy.stripe.com/eVq8wP84j5HTf7K3Vf8AE0L",
    6: "https://buy.stripe.com/9B6dR9ckz6LX8Jm4Zj8AE0M"
  };
  const promoLinks = {
    1: "https://buy.stripe.com/9B67sLfwLeepaRudvP8AE0u",
    2: "https://buy.stripe.com/7sY6oH84jeep2kY63n8AE0v",
    3: "https://buy.stripe.com/14A5kD70ffitgbOajD8AE0w",
    4: "https://buy.stripe.com/4gM28r1FVb2dcZC9fz8AE0e",
    5: "https://buy.stripe.com/bJecN584j0nzaRugI18AE0x",
    6: "https://buy.stripe.com/fZu28r84jc6h2kY9fz8AE0y"
  };

  // ── ELEMENTS ──
  const decBtn         = document.getElementById('decrease');
  const incBtn         = document.getElementById('increase');
  const ticketDisplay  = document.getElementById('ticketDisplay');
  const ticketCount    = document.getElementById('ticketCount');
  const totalDisplay   = document.getElementById('totalDisplay');
  const promoToggle    = document.getElementById('promoToggle');
  const promoPanel     = document.getElementById('promoPanel');
  const promoCode      = document.getElementById('promoCode');
  const applyPromo     = document.getElementById('applyPromo');
  const promoMsg       = document.getElementById('promoMsg');
  const submitBtn      = document.getElementById('submitBtn');
  const maxErr         = document.getElementById('ticket-max-err');
  function updateUI() {
    const total = ticketQty * pricePerSeat;
    ticketDisplay.textContent = ticketQty;
    ticketCount.value = ticketQty;
    totalDisplay.textContent = `${total.toLocaleString('sv-SE')} SEK`;
  }

  decBtn.addEventListener('click', () => {
    if (ticketQty > 1) { ticketQty--; maxErr.style.display = 'none'; updateUI(); }
  });
  incBtn.addEventListener('click', () => {
    if (ticketQty < 6) { ticketQty++; maxErr.style.display = 'none'; updateUI(); }
    else { maxErr.style.display = 'block'; }
  });

  promoToggle.addEventListener('click', () => {
    promoPanel.classList.toggle('open');
    promoToggle.classList.toggle('open');
  });

  function applyCode() {
    const code = promoCode.value.trim().toUpperCase();
    if (PROMO_CODES[code]) {
      activePromo = code;
      pricePerSeat = PROMO_CODES[code];
      promoMsg.className = 'promo-msg success';
      promoMsg.textContent = `✓ ${code} – rabatt tillämpad`;
    } else if (code.length === 0) {
      activePromo = null;
      pricePerSeat = PRICE_EARLY;
      promoMsg.textContent = '';
    } else {
      activePromo = null;
      pricePerSeat = PRICE_EARLY;
      promoMsg.className = 'promo-msg error';
      promoMsg.textContent = '⚠ Koden känns inte igen.';
    }
    updateUI();
  }

  applyPromo.addEventListener('click', applyCode);
  promoCode.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); applyCode(); } });

  function validateField(input) {
    const errEl = document.getElementById(input.id + '-err');
    if (!errEl) return true;
    const valid = input.checkValidity() && input.value.trim() !== '';
    input.classList.toggle('valid', valid);
    input.classList.toggle('invalid', !valid);
    errEl.classList.toggle('show', !valid);
    return valid;
  }

  ['firstName','lastName','email'].forEach(id => {
    const el = document.getElementById(id);
    el.addEventListener('blur', () => validateField(el));
    el.addEventListener('input', () => { if (el.classList.contains('invalid')) validateField(el); });
  });

  submitBtn.addEventListener('click', () => {
    const fields = ['firstName','lastName','email'];
    let allValid = true;
    fields.forEach(id => { if (!validateField(document.getElementById(id))) allValid = false; });
    if (!allValid) return;

    submitBtn.classList.add('loading');
    submitBtn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10" opacity=".3"/><path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round" style="animation:spin .8s linear infinite;transform-origin:center"/></svg> Behandlar…`;

    const form = document.getElementById('booking-form');
    const formData = new FormData(form);
    try {
      navigator.sendBeacon(
        "https://nariman09.app.n8n.cloud/webhook/ca321f00-1343-4b79-9e64-482fb94132d6",
        new Blob([new URLSearchParams(formData).toString()], { type: 'application/x-www-form-urlencoded' })
      );
    } catch (err) {}

    const link = activePromo ? promoLinks[ticketQty] : normalLinks[ticketQty];
    setTimeout(() => { window.location.href = link || normalLinks[1]; }, 400);
  });

  updateUI();
</script>

