<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <title>Anmälan, AI Agent Workshop · Uppsala · 13 juni</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Säkra din plats på AI Agent Workshop. Uppsala · 13 juni 2026." />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <!-- Umami Analytics -->
<script defer src="https://cloud.umami.is/script.js" data-website-id="045fc1e4-9f56-44f2-992e-98f5fb7717a5"></script>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --black:         #faf9f5;
      --off-black:     #f2f0ea;
      --card:          #ffffff;
      --card2:         #f5f4f0;
      --border:        rgba(0,0,0,0.07);
      --border-strong: rgba(0,0,0,0.12);
      --green:         #1a6b3a;
      --green-dim:     rgba(26,107,58,0.08);
      --green-glow:    rgba(26,107,58,0.20);
      --gold:          #f0c000;
      --gold-dim:      rgba(240,192,0,0.10);
      --gold-glow:     rgba(240,192,0,0.28);
      --white:         #ffffff;
      --muted:         rgba(0,0,0,0.38);
      --muted2:        rgba(0,0,0,0.60);
      --red:           #c0392b;
      --header:        66px;
      --r:             3px;
    }

    html { scroll-behavior: smooth; }
    body {
      background: var(--black); color: #1a1208;
      font-family: 'DM Sans', sans-serif; font-size: 16px;
      line-height: 1.6; overflow-x: hidden; min-height: 100vh;
    }

    /* ── HEADER ── */
    header {
      position: fixed; top: 0; left: 0; right: 0; height: var(--header);
      background: rgba(250,249,245,0.96); backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border); z-index: 100;
      display: flex; align-items: center;
    }
    .hdr-inner {
      max-width: 1280px; margin: 0 auto; padding: 0 2.5rem;
      width: 100%; display: flex; align-items: center; justify-content: space-between;
    }
    .logo { display: flex; align-items: center; gap: 0.85rem; text-decoration: none; }
    .logo-mark {
      width: 36px; height: 36px; border-radius: var(--r);
      background: var(--card); border: 1px solid var(--border-strong);
      display: flex; align-items: center; justify-content: center; overflow: hidden;
    }
    .logo-mark img { width: 100%; height: 100%; object-fit: cover; }
    .logo-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; letter-spacing: 0.12em; color: #1a1208; line-height: 1; }
    .logo-sub { font-family: 'DM Mono', monospace; font-size: 0.52rem; text-transform: uppercase; letter-spacing: 0.24em; color: var(--green); display: block; margin-top: 2px; }

    .hdr-right { display: flex; align-items: center; gap: 1rem; }

    .nav-back {
      font-family: 'DM Mono', monospace; font-size: 0.62rem;
      text-transform: uppercase; letter-spacing: 0.18em;
      color: var(--muted); text-decoration: none;
      display: flex; align-items: center; gap: 0.5rem;
      transition: color 0.2s;
    }
    .nav-back:hover { color: #1a1208; }
    .nav-back svg { width: 14px; height: 14px; }

    .lang-toggle {
      display: flex; align-items: center; gap: 0.45rem;
      font-family: 'DM Mono', monospace; font-size: 0.6rem;
      text-transform: uppercase; letter-spacing: 0.14em;
      color: var(--muted); text-decoration: none;
      border: 1px solid var(--border-strong); border-radius: var(--r);
      padding: 0.35rem 0.7rem; transition: color 0.2s, border-color 0.2s;
    }
    .lang-toggle:hover { color: #1a1208; border-color: rgba(0,0,0,0.25); }
    .lang-toggle img { width: 18px; height: 18px; border-radius: 2px; object-fit: cover; }

    @media (max-width: 640px) { .hdr-inner { padding: 0 1.25rem; } .nav-back span { display: none; } }

    /* ── BACKGROUND ── */
    .page-bg {
      position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(rgba(0,0,0,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,0,0,0.03) 1px, transparent 1px);
      background-size: 52px 52px;
    }
    .page-glow {
      position: fixed; top: -300px; right: -200px; width: 800px; height: 800px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(26,107,58,0.04) 0%, transparent 65%);
      pointer-events: none; z-index: 0;
    }
    .page-glow-2 {
      position: fixed; bottom: -200px; left: -100px; width: 600px; height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(240,192,0,0.04) 0%, transparent 65%);
      pointer-events: none; z-index: 0;
    }

    /* ── LAYOUT ── */
    .page-wrap {
      padding-top: calc(var(--header) + 4rem);
      padding-bottom: 6rem;
      position: relative; z-index: 1;
    }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 2.5rem; }
    @media (max-width: 640px) { .container { padding: 0 1.25rem; } }

    /* ── PAGE HEADER ── */
    .page-header { margin-bottom: 3.5rem; animation: fadeUp 0.6s ease 0.1s both; }
    .page-eyebrow {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: 'DM Mono', monospace; font-size: 0.6rem;
      letter-spacing: 0.2em; text-transform: uppercase;
      color: var(--green); margin-bottom: 1.1rem;
    }
    .page-eyebrow::before { content: ''; display: inline-block; width: 16px; height: 1px; background: var(--green); }
    .page-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(2.8rem, 5vw, 5rem);
      line-height: 0.95; letter-spacing: 0.02em;
    }
    .page-title .t-white { color: #1a1208; display: block; }
    .page-title .t-gold { color: var(--gold); display: block; }
    .page-divider { width: 40px; height: 1px; background: linear-gradient(90deg, var(--gold), transparent); margin: 1.4rem 0; }

    /* ── STEP INDICATOR ── */
    .step-bar {
      display: flex; align-items: center; gap: 0;
      margin-bottom: 3rem; animation: fadeUp 0.6s ease 0.2s both;
    }
    .step {
      display: flex; align-items: center; gap: 0.65rem;
      font-family: 'DM Mono', monospace; font-size: 0.58rem;
      text-transform: uppercase; letter-spacing: 0.16em;
    }
    .step-num {
      width: 28px; height: 28px; border-radius: var(--r);
      display: flex; align-items: center; justify-content: center;
      font-family: 'Bebas Neue', sans-serif; font-size: 0.9rem; letter-spacing: 0;
      flex-shrink: 0;
    }
    .step.active .step-num { background: var(--gold); color: #000; }
    .step.active .step-label { color: #1a1208; }
    .step.inactive .step-num { background: var(--card); border: 1px solid var(--border-strong); color: var(--muted); }
    .step.inactive .step-label { color: var(--muted); }
    .step-connector { width: 40px; height: 1px; background: var(--border-strong); margin: 0 0.75rem; flex-shrink: 0; }

    /* ── MAIN GRID ── */
    .main-grid {
      display: block;
      max-width: 680px;
      margin: 0 auto;
    }

    /* ── FORM CARD ── */
    .form-card {
      background: var(--card); border: 1px solid var(--border-strong);
      border-radius: var(--r); position: relative; overflow: hidden;
      animation: fadeUp 0.6s ease 0.25s both;
    }
    .form-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--gold); }
    .form-card-header {
      padding: 2rem 2.5rem 1.5rem;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
    }
    .form-card-title {
      font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem;
      letter-spacing: 0.04em; line-height: 1;
    }
    .seats-badge {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-family: 'DM Mono', monospace; font-size: 0.55rem;
      letter-spacing: 0.16em; text-transform: uppercase;
      padding: 0.25rem 0.7rem; border-radius: 2px;
      background: var(--green-dim); color: var(--green);
      border: 1px solid rgba(26,107,58,0.22);
    }
    .seats-dot { width: 5px; height: 5px; background: var(--green); border-radius: 50%; animation: pulse 2s ease infinite; }

    .form-body { padding: 2rem 2.5rem; }
    @media (max-width: 500px) { .form-card-header { padding: 1.5rem; } .form-body { padding: 1.5rem; } }

    /* ── FORM FIELDS ── */
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem; }
    @media (max-width: 500px) { .field-row { grid-template-columns: 1fr; } }
    .field { margin-bottom: 1.25rem; }
    .field-row .field { margin-bottom: 0; }

    label {
      display: block; font-family: 'DM Mono', monospace;
      font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.18em;
      color: var(--muted); margin-bottom: 0.55rem;
    }
    label .opt { color: var(--muted); font-size: 0.5rem; letter-spacing: 0.1em; margin-left: 0.4rem; opacity: 0.6; }

    input[type="text"],
    input[type="email"],
    input[type="tel"],
    select,
    textarea {
      width: 100%;
      background: rgba(0,0,0,0.03);
      border: 1px solid var(--border-strong);
      border-radius: var(--r); padding: 0.85rem 1rem;
      color: #1a1208; font-family: 'DM Sans', sans-serif;
      font-size: 0.92rem; transition: border-color 0.2s, background 0.2s;
      appearance: none; -webkit-appearance: none;
    }
    input::placeholder { color: rgba(0,0,0,0.25); }
    input:focus, select:focus, textarea:focus {
      outline: none; border-color: var(--gold); background: rgba(240,192,0,0.03);
    }
    select {
      background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l4 4 4-4' stroke='rgba(0,0,0,0.4)' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: right 1rem center;
      padding-right: 2.5rem;
      cursor: pointer;
    }
    select option { background: #fff; color: #1a1208; }

    input.valid, select.valid { border-color: rgba(26,107,58,0.4); }
    input.invalid, select.invalid { border-color: rgba(192,57,43,0.5); }
    .field-error {
      font-family: 'DM Mono', monospace; font-size: 0.52rem;
      text-transform: uppercase; letter-spacing: 0.12em;
      color: var(--red); margin-top: 0.4rem; display: none;
    }
    .field-error.show { display: block; }

    /* ── TICKET COUNTER ── */
    .ticket-counter { display: flex; align-items: center; gap: 1px; background: var(--border-strong); border-radius: var(--r); overflow: hidden; width: fit-content; }
    .tc-btn {
      background: var(--card2); border: none; color: #1a1208;
      width: 44px; height: 44px; cursor: pointer;
      font-size: 1.1rem; font-family: 'DM Sans', sans-serif;
      transition: background 0.18s; display: flex; align-items: center; justify-content: center;
      user-select: none;
    }
    .tc-btn:hover { background: #e8e6df; }
    .tc-btn:active { background: #dedad0; }
    .tc-num {
      background: var(--card2); border: none;
      width: 56px; height: 44px;
      text-align: center; font-family: 'Bebas Neue', sans-serif;
      font-size: 1.1rem; color: var(--gold); pointer-events: none;
      display: flex; align-items: center; justify-content: center;
    }

    /* ── SECTION DIVIDER ── */
    .form-section-label {
      font-family: 'DM Mono', monospace; font-size: 0.56rem;
      text-transform: uppercase; letter-spacing: 0.22em;
      color: var(--muted); margin: 1.75rem 0 1.25rem;
      display: flex; align-items: center; gap: 0.75rem;
    }
    .form-section-label::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    /* ── PROMO CODE ── */
    .promo-toggle-btn {
      background: none; border: none; cursor: pointer;
      font-family: 'DM Mono', monospace; font-size: 0.6rem;
      text-transform: uppercase; letter-spacing: 0.15em;
      color: var(--muted); display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0; transition: color 0.2s;
    }
    .promo-toggle-btn:hover { color: var(--gold); }
    .promo-toggle-btn svg { width: 10px; height: 10px; transition: transform 0.25s; }
    .promo-toggle-btn.open svg { transform: rotate(180deg); }
    .promo-panel { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
    .promo-panel.open { max-height: 120px; margin-top: 1rem; }
    .promo-inner { display: flex; gap: 0.75rem; }
    .promo-inner input { flex: 1; }
    .promo-apply-btn {
      background: var(--card2); border: 1px solid var(--border-strong); border-radius: var(--r);
      color: #1a1208; font-family: 'DM Mono', monospace; font-size: 0.6rem;
      text-transform: uppercase; letter-spacing: 0.12em; padding: 0 1.1rem;
      cursor: pointer; white-space: nowrap; transition: border-color 0.2s, color 0.2s;
    }
    .promo-apply-btn:hover { border-color: var(--gold); color: var(--gold); }
    .promo-msg {
      font-family: 'DM Mono', monospace; font-size: 0.52rem; letter-spacing: 0.12em;
      text-transform: uppercase; margin-top: 0.5rem;
    }
    .promo-msg.success { color: var(--green); }
    .promo-msg.error { color: var(--red); }

    /* ── PRICE SUMMARY STRIP ── */
    .price-summary-strip {
      display: flex; align-items: center; justify-content: space-between;
      margin: 1.75rem 0 0;
      padding: 1.25rem 1.5rem;
      background: rgba(240,192,0,0.06);
      border: 1px solid rgba(240,192,0,0.22);
      border-radius: var(--r);
    }
    .pss-left { display: flex; flex-direction: column; gap: 0.2rem; }
    .pss-label { font-family: 'DM Mono', monospace; font-size: 0.56rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--muted); }
    .pss-breakdown { font-family: 'DM Mono', monospace; font-size: 0.72rem; letter-spacing: 0.1em; color: var(--muted2); }
    .pss-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.1rem; }
    .pss-old { font-family: 'DM Mono', monospace; font-size: 0.65rem; color: var(--muted); text-decoration: line-through; letter-spacing: 0.08em; }
    .pss-total { font-family: 'Bebas Neue', sans-serif; font-size: 2rem; color: #1a1208; line-height: 1; letter-spacing: 0.04em; }
    @media (max-width: 500px) {
      .price-summary-strip { padding: 1rem 1.25rem; align-items: center; }
      .pss-total { font-size: 1.6rem; }
    }

    /* ── SUBMIT BUTTON ── */
    .submit-btn {
      display: flex; align-items: center; justify-content: center; gap: 0.65rem;
      width: 100%; padding: 1.1rem 2rem; margin-top: 2rem;
      background: var(--gold); color: #000; border: none; border-radius: var(--r);
      font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 0.85rem;
      text-transform: uppercase; letter-spacing: 0.14em; cursor: pointer;
      transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    }
    .submit-btn:hover { background: #f5cc00; transform: translateY(-1px); box-shadow: 0 8px 32px var(--gold-glow); }
    .submit-btn:active { transform: translateY(0); }
    .submit-btn svg { width: 14px; height: 14px; flex-shrink: 0; }
    .submit-btn.loading { opacity: 0.7; pointer-events: none; }

    .submit-note {
      margin-top: 0.85rem; text-align: center;
      font-family: 'DM Mono', monospace; font-size: 0.52rem;
      text-transform: uppercase; letter-spacing: 0.16em; color: var(--muted);
      display: flex; align-items: center; justify-content: center; gap: 0.5rem;
    }
    .submit-note svg { width: 11px; height: 11px; opacity: 0.5; }

    /* ── FOOTER ── */
    .site-footer { background: var(--off-black); border-top: 1px solid var(--border); padding: 4rem 0 2rem; position: relative; z-index: 1; }
    .footer-inner { max-width: 1280px; margin: 0 auto; padding: 0 2.5rem; }
    .footer-top { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; padding-bottom: 3rem; border-bottom: 1px solid var(--border); align-items: start; }
    .footer-col-label { font-family: 'DM Mono', monospace; font-size: 0.58rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--green); margin-bottom: 1.4rem; display: flex; align-items: center; gap: 0.5rem; }
    .footer-col-label::before { content: ''; display: inline-block; width: 14px; height: 1px; background: var(--green); flex-shrink: 0; }
    .footer-col-label.right { justify-content: flex-end; }
    .footer-col-label.right::before { display: none; }
    .footer-col-label.right::after { content: ''; display: inline-block; width: 14px; height: 1px; background: var(--green); flex-shrink: 0; }
    .footer-links { list-style: none; }
    .footer-links li a { font-size: 0.88rem; color: rgba(0,0,0,0.55); text-decoration: none; padding: 0.45rem 0; display: block; transition: color 0.2s; }
    .footer-links li a:hover { color: #1a1208; }
    .footer-right-col { text-align: right; }
    .footer-address-lines { display: flex; flex-direction: column; gap: 0.25rem; text-align: right; }
    .footer-address-lines p, .footer-address-lines a { font-family: 'DM Mono', monospace; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(0,0,0,0.55); line-height: 1.7; text-decoration: none; display: block; transition: color 0.2s; }
    .footer-address-lines a:hover { color: var(--green); }
    .footer-address-gap { margin-top: 0.6rem; }
    .footer-bottom-row { padding-top: 2.5rem; display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
    .footer-logo { display: flex; align-items: center; gap: 0.75rem; text-decoration: none; }
    .footer-logo-mark { width: 42px; height: 42px; border-radius: var(--r); background: var(--card); border: 1px solid var(--border-strong); overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .footer-logo-mark img { width: 100%; height: 100%; object-fit: cover; }
    .footer-logo-name { font-family: 'Bebas Neue', sans-serif; font-size: 1.3rem; letter-spacing: 0.14em; color: #1a1208; line-height: 1; }
    .footer-logo-sub { font-family: 'DM Mono', monospace; font-size: 0.46rem; text-transform: uppercase; letter-spacing: 0.22em; color: var(--green); display: block; margin-top: 3px; }
    .footer-socials { display: flex; align-items: center; gap: 0.6rem; }
    .footer-social-icon { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; flex-shrink: 0; transition: transform 0.2s, opacity 0.2s; }
    .footer-social-icon:hover { transform: translateY(-2px); opacity: 0.85; }
    .footer-social-icon.linkedin { background: #0a66c2; }
    .footer-social-icon.facebook { background: #1877f2; }
    .footer-social-icon.instagram { background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fd5949 45%, #d6249f 60%, #285AEB 90%); }
    .footer-social-icon svg { width: 15px; height: 15px; fill: white; }
    .footer-copyright { font-family: 'DM Mono', monospace; font-size: 0.5rem; text-transform: uppercase; letter-spacing: 0.22em; color: rgba(0,0,0,0.3); text-align: center; }
    @media (max-width: 640px) { .footer-top { grid-template-columns: 1fr; } .footer-right-col { text-align: left; } .footer-col-label.right { justify-content: flex-start; } .footer-col-label.right::before { display: inline-block; } .footer-col-label.right::after { display: none; } .footer-address-lines { text-align: left; } }

    /* ── ANIMATIONS ── */
    @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Language dropdown */
    .lang-wrap { position: relative; }
    .lang-btn { display: flex; align-items: center; gap: 0.4rem; cursor: pointer; font-family: 'DM Mono', monospace; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted); background: none; border: 1px solid var(--border); border-radius: var(--r); padding: 0.35rem 0.7rem; transition: color 0.2s, border-color 0.2s; }
    .lang-btn:hover { color: #1a1208; border-color: var(--border-strong); }
    .lang-btn img { width: 18px; height: 18px; border-radius: 2px; object-fit: cover; }
    .lang-btn svg { width: 12px; height: 12px; }
    .lang-menu { display: none; position: absolute; right: 0; top: calc(100% + 8px); min-width: 140px; background: var(--card2); border: 1px solid var(--border-strong); border-radius: var(--r); overflow: hidden; z-index: 200; }
    .lang-wrap.open .lang-menu { display: block; }
    .lang-menu a { display: flex; align-items: center; gap: 0.6rem; padding: 0.65rem 1rem; font-family: 'DM Mono', monospace; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted2); text-decoration: none; transition: background 0.2s, color 0.2s; }
    .lang-menu a:hover { background: rgba(0,0,0,0.04); color: #1a1208; }
    .lang-menu a img { width: 16px; height: 16px; border-radius: 2px; object-fit: cover; }
  </style>

  <!-- Meta Pixel -->
  <script>
    !function(f,b,e,v,n,t,s)
