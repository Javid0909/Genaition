  <script>
    // Language dropdown
    const langBtn = document.getElementById('langBtn');
    const langMenu = document.getElementById('langMenu');
    function toggleLangMenu(force) {
      if (!langMenu) return;
      const isHidden = langMenu.classList.contains('hidden');
      const nextHidden = typeof force === 'boolean' ? !force : !isHidden;
      langMenu.classList.toggle('hidden', nextHidden);
      if (langBtn) langBtn.setAttribute('aria-expanded', (!nextHidden).toString());
    }
    if (langBtn && langMenu) {
      langBtn.addEventListener('click', function(e) { e.stopPropagation(); toggleLangMenu(); });
      document.addEventListener('click', function() { toggleLangMenu(false); });
    }

    // Mobile menu
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileMenuClose = document.getElementById('mobileMenuClose');
    function openMobileMenu() { mobileMenu && mobileMenu.classList.remove('hidden'); }
    function closeMobileMenu() { mobileMenu && mobileMenu.classList.add('hidden'); }
    mobileMenuBtn && mobileMenuBtn.addEventListener('click', openMobileMenu);
    mobileMenuClose && mobileMenuClose.addEventListener('click', closeMobileMenu);
    mobileMenu && mobileMenu.addEventListener('click', function(e) { if (e.target === mobileMenu) closeMobileMenu(); });
    mobileMenu && mobileMenu.querySelectorAll('a').forEach(function(a) { a.addEventListener('click', closeMobileMenu); });

    // FAQ accordion
    document.querySelectorAll('.faq-toggle').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const content = btn.parentElement.querySelector('.faq-content');
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', (!expanded).toString());
        btn.parentElement.classList.toggle('faq-open', !expanded);
        content.classList.toggle('hidden');
      });
    });

    // Sticky bar
    const stickyBar = document.getElementById('stickyBar');
    const ticketsSection = document.getElementById('tickets');
    window.addEventListener('scroll', function() {
      if (!ticketsSection) return;
      const rect = ticketsSection.getBoundingClientRect();
      const ticketVisible = rect.top < window.innerHeight && rect.bottom > 0;
      stickyBar.classList.toggle('visible', window.scrollY > 500 && !ticketVisible);
    }, { passive: true });

    // Countdown
    (function() {
      const target = new Date('2026-12-12T13:30:00+01:00');
      const el = document.getElementById('heroCountdown');
      if (!el) return;
      function tick() {
        const diff = target - new Date();
        if (diff <= 0) { el.style.display = 'none'; return; }
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        document.getElementById('cdDays').textContent  = String(d).padStart(2,'0');
        document.getElementById('cdHours').textContent = String(h).padStart(2,'0');
        document.getElementById('cdMins').textContent  = String(m).padStart(2,'0');
        document.getElementById('cdSecs').textContent  = String(s).padStart(2,'0');
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>

</body>
